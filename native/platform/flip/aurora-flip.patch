+    ++g_sprites.refusedBy[2];
+    ok = false;
+  }
+  if (c.depthCompare && c.depthUpdate) {
+    ++g_sprites.refusedBy[3];
+  }
+  if (c.dstAlpha != UINT32_MAX) {
+    ++g_sprites.refusedBy[4];
+    ok = false;
