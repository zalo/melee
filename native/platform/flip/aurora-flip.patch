+namespace aurora::gx {
+namespace {
+constexpr Module Log{"aurora::gx::flip_uber"};
+constexpr u32 UberMaxTevStages = 16;
+constexpr u32 UberStateWords = 96;
+
+template <typename T>
+constexpr u32 enum_u32(T value) noexcept {
+  return static_cast<u32>(value);
+}
+
+Vec4<float> uber_texture_size_bias(const gfx::TextureBind& tex) {
+  const float width = static_cast<float>(tex.texObj.width());
+  const float height = static_cast<float>(tex.texObj.height());
+  float viewportBias = 0.f;
+  if (tex.ref && tex.ref->hasArbitraryMips) {
+    const float viewportScale =
+        std::min(g_gxState.renderViewport.width / std::max(g_gxState.logicalViewport.width, 1.f),
+                 g_gxState.renderViewport.height / std::max(g_gxState.logicalViewport.height, 1.f));
+    const float replacementScale = static_cast<float>(tex.ref->size.width) / std::max(width, 1.f);
+    viewportBias = std::log2(viewportScale / std::max(replacementScale, 0.001f));
+  }
+  return {width, height, tex.texObj.lod_bias() + viewportBias, 0.f};
+}
+
+u32 pack_tev_op(const TevOp& op) noexcept {
+  return enum_u32(op.op) | (enum_u32(op.bias) << 4) | (enum_u32(op.scale) << 6) |
+         (enum_u32(op.outReg) << 8) | (u32(op.clamp) << 10);
+}
+
+u32 pack_channel(const ColorChannelConfig& channel) noexcept {
+  return enum_u32(channel.matSrc) | (enum_u32(channel.ambSrc) << 1) |
+         (enum_u32(channel.diffFn) << 2) | (enum_u32(channel.attnFn) << 4) |
+         (u32(channel.lightingEnabled) << 6);
+}
+} // namespace
+
+bool flip_uber_compatible(const ShaderConfig& config) noexcept {
+  if (config.lineMode || config.fogRangeEnabled || config.numIndStages || config.tevStageCount == 0 ||
+      config.tevStageCount > UberMaxTevStages)
+    return false;
+  for (const auto& tcg : config.tcgs) {
+    if (tcg.type >= GX_TG_BUMP0 && tcg.type <= GX_TG_BUMP7)
+      return false;
+    if (tcg.src > GX_TG_TEX7 && tcg.src != GX_TG_COLOR0 && tcg.src != GX_TG_COLOR1 && tcg.src != GX_MAX_TEXGENSRC)
+      return false;
+    if (tcg.postMtx != GX_PTIDENTITY &&
+        (tcg.postMtx < GX_PTTEXMTX0 || (tcg.postMtx - GX_PTTEXMTX0) / 3 >= 3))
+      return false;
+  }
+  return true;
+}
+
+void flip_uber_canonicalize(ShaderConfig& config) noexcept {
+  // A native specialized program must retain the GX material state in its key.
+  if (flip_native_specialized_enabled()) return;
+  const u8 flags = config.flipFlags;
+  const u32 tevStageCount = config.tevStageCount;
+  config = {};
+  config.flipFlags = flags;
+  // TEV count is a cheap, high-value native GLES specialization. Keeping it
+  // in the otherwise canonical key also prevents a merged draw from mixing
+  // records that require different constant loop bounds.
+  config.tevStageCount = tevStageCount;
+}
+
+void fill_flip_uber_uniform(ByteBuffer& buf, const ShaderConfig& config) noexcept {
+  buf.reserve_extra(MaxUniformSize);
+  buf.append<f32>(g_gxState.renderViewport.width);
+  buf.append<f32>(g_gxState.renderViewport.height);
+  buf.append<f32>(g_gxState.logicalViewport.width);
+  buf.append<f32>(g_gxState.logicalViewport.height);
+
+  auto proj = g_gxState.proj;
+  if constexpr (UseReversedZ)
+    proj.m2 = proj.m2 * Vec4{-1.f, -1.f, -1.f, -1.f};
+  else
+    proj.m2 = proj.m2 + proj.m3;
+  buf.append(proj);
+  for (const auto& matrix : g_gxState.pnMtx) buf.append(matrix.pos);
+  for (const auto& matrix : g_gxState.texMtxs) buf.append(matrix);
+  for (const auto& matrix : g_gxState.pnMtx) buf.append(matrix.nrm);
+  buf.append(g_gxState.colorRegs);
+  buf.append(g_gxState.lights);
+  for (const auto& channel : g_gxState.colorChannelState)
+    buf.append<u32>(channel.lightMask.to_ulong());
+  for (const auto& channel : g_gxState.colorChannelState) buf.append(channel.ambColor);
+  for (const auto& channel : g_gxState.colorChannelState) buf.append(channel.matColor);
+  buf.append(g_gxState.kcolors);
+  for (u32 i = 0; i < 3; ++i) buf.append(g_gxState.ptTexMtxs[i]);
+
+  const auto& fogState = g_gxState.fog;
+  const float logicalWidth = std::max(g_gxState.logicalViewport.width, 1.f);
+  const float renderWidth = std::max(g_gxState.renderViewport.width, 1.f);
+  Fog fog{
+      .color = fogState.color,
+      .a = fogState.a,
+      .b = fogState.b,
+      .c = fogState.c,
+      .rangeCenter = ((static_cast<float>(fogState.rangeCenter) - g_gxState.logicalViewport.left) / logicalWidth) * 2.f -
+                     1.f + (g_gxState.renderViewport.left / renderWidth) * 2.f,
+  };
+  for (u32 i = 0; i < fogState.rangeK.size(); ++i) {
+    const u32 source = (i & ~1u) | (1u - (i & 1u));
+    fog.rangeK[i / 4][i % 4] = static_cast<float>(fogState.rangeK[source]) / 64.f;
+  }
+  fog.rangeK[2][2] = fog.rangeK[2][1];
+  fog.rangeK[2][3] = fog.rangeK[2][1];
+  buf.append(fog);
+
+  for (const auto& scale : g_gxState.texCoordScales)
+    buf.append(Vec4{static_cast<f32>(scale.scaleS) + 1.f, static_cast<f32>(scale.scaleT) + 1.f, 0.f, 0.f});
+  for (u32 i = 0; i < MaxTextures; ++i) {
+    const auto& texture = get_texture(static_cast<GXTexMapID>(i));
+    buf.append(texture ? uber_texture_size_bias(texture) : Vec4{1.f, 1.f, 0.f, 0.f});
+  }
+
+  buf.append(flip_uber_state(config));
+  if (buf.size() < MaxUniformSize) buf.append_zeroes(MaxUniformSize - buf.size());
+  AURORA_ASSERT(buf.size() == MaxUniformSize, "Flip ubershader uniform size mismatch: {}", buf.size());
+}
+
+std::array<u32,96> flip_uber_state(const ShaderConfig& config) noexcept {
+  std::array<u32, UberStateWords> state{};
+  state[0] = config.tevStageCount | (u32(config.fogType) << 8) | (u32(config.fogRangeEnabled) << 16);
+  for (u32 i = 0; i <= GX_VA_TEX7; ++i)
+    state[1] |= u32(config.attrs[i].attrType != GX_NONE) << i;
+  state[2] = enum_u32(config.alphaCompare.comp0) | ((config.alphaCompare.ref0 & 255u) << 3) |
+             (enum_u32(config.alphaCompare.op) << 11) | (enum_u32(config.alphaCompare.comp1) << 13) |
+             ((config.alphaCompare.ref1 & 255u) << 16) | (u32(bool(config.alphaCompare)) << 24);
+  for (u32 i = 0; i < MaxTevSwap; ++i) {
+    const auto& swap = config.tevSwapTable[i];
+    const u32 packed = enum_u32(swap.red) | (enum_u32(swap.green) << 2) | (enum_u32(swap.blue) << 4) |
+                       (enum_u32(swap.alpha) << 6);
+    state[3] |= packed << (i * 8);
+  }
+  for (u32 i = 0; i < MaxColorChannels; ++i) state[4 + i] = pack_channel(config.colorChannels[i]);
+  for (u32 i = 0; i < MaxTexCoord; ++i) {
+    const auto& tcg = config.tcgs[i];
+    state[8 + i] = enum_u32(tcg.type) | (enum_u32(tcg.src) << 8) | (enum_u32(tcg.mtx) << 16) |
+                     (enum_u32(tcg.postMtx) << 24);
+    state[16 + i] = u32(tcg.normalize) | (u32(tcg.embossSrc) << 1);
+  }
+  for (u32 i = 0; i < config.tevStageCount; ++i) {
+    const auto& stage = config.tevStages[i];
+    const u32 base = 24 + i * 3;
+    state[base] = enum_u32(stage.colorPass.a) | (enum_u32(stage.colorPass.b) << 4) |
+                  (enum_u32(stage.colorPass.c) << 8) | (enum_u32(stage.colorPass.d) << 12) |
+                  (enum_u32(stage.alphaPass.a) << 16) | (enum_u32(stage.alphaPass.b) << 19) |
+                  (enum_u32(stage.alphaPass.c) << 22) | (enum_u32(stage.alphaPass.d) << 25);
+    state[base + 1] = pack_tev_op(stage.colorOp) | (pack_tev_op(stage.alphaOp) << 16);
+    state[base + 2] = enum_u32(stage.kcSel) | (enum_u32(stage.kaSel) << 5) |
+                      ((enum_u32(stage.texCoordId) & 15u) << 10) | ((enum_u32(stage.texMapId) & 15u) << 14) |
+                      ((enum_u32(stage.channelId) & 255u) << 18) | (enum_u32(stage.tevSwapRas) << 26) |
+                      (enum_u32(stage.tevSwapTex) << 28);
+  }
+  return state;
+}
+
+std::string build_flip_uber_shader_source(bool texturePairs) noexcept {
+  std::string bindings;
+  for (u32 i = 0; i < MaxTextures; ++i) {
+    bindings += fmt::format("@group(2) @binding({0}) var tex{1}: texture_2d<f32>;\n"
+                            "@group(2) @binding({2}) var samp{1}: sampler;\n", i * 2, i, i * 2 + 1);
+    if (texturePairs)
+      bindings += fmt::format("@group(2) @binding({0}) var tex{1}b: texture_2d<f32>;\n"
+                              "@group(2) @binding({2}) var samp{1}b: sampler;\n", 16 + i * 2, i, 17 + i * 2);
+  }
+  std::string sampleCases;
+  for (u32 i = 0; i < MaxTextures; ++i) {
+    sampleCases += fmt::format("case {0}u: {{ if (bank == 0u) {{ return textureSampleGrad(tex{0}, samp{0}, uv, dx, dy); }}", i);
+    if (texturePairs)
+      sampleCases += fmt::format(" return textureSampleGrad(tex{0}b, samp{0}b, uv, dx, dy);", i);
+    else
+      sampleCases += fmt::format(" return textureSampleGrad(tex{0}, samp{0}, uv, dx, dy);", i);
+    sampleCases += " }\n";
+  }
+
+  return fmt::format(R"WGSL(
+diagnostic(off, derivative_uniformity);
+struct Light {{ pos: vec4f, dir: vec4f, color: vec4f, cos_att: vec4f, dist_att: vec4f }};
+struct Fog {{ color: vec4f, a: f32, b: f32, c: f32, range_center: f32, range_k: array<vec4f, 3> }};
+struct Uniform {{
+  render_viewport_size: vec2f, logical_viewport_size: vec2f,
+  proj: mat4x4f, postex_mtx: array<mat3x4f, 20>, nrm_mtx: array<mat3x4f, 10>,
+  tevreg: array<vec4f, 4>, lights: array<Light, 8>, light_state: vec4u,
+  cc_amb: array<vec4f, 4>, cc_mat: array<vec4f, 4>, kcolor: array<vec4f, 4>,
+  postmtx: array<mat3x4f, 3>, fog: Fog,
+  texcoord_scale: array<vec4f, 8>, tex_size_bias: array<vec4f, 8>, state: array<vec4u, 24>,
+}};
+struct FlipUniformRecord {{ @size(4096) value: Uniform }};
+@group(1) @binding(0) var<uniform> table: array<FlipUniformRecord, 16>;
+{0}
+
+var<private> record_index: u32;
+var<private> texture_bank: u32;
+fn word(index: u32) -> u32 {{ return table[record_index].value.state[index / 4u][index & 3u]; }}
+fn component(v: vec4f, i: u32) -> f32 {{ return v[i & 3u]; }}
+fn swap_color(v: vec4f, which: u32) -> vec4f {{
+  let s = (word(3u) >> (which * 8u)) & 255u;
+  return vec4f(component(v,s), component(v,s>>2u), component(v,s>>4u), component(v,s>>6u));
+}}
+fn overflow1(v: f32) -> f32 {{ let b=v*255.0; return (b-floor(b/256.0)*256.0)/255.0; }}
+fn overflow3(v: vec3f) -> vec3f {{ let b=v*255.0; return (b-floor(b/256.0)*256.0)/255.0; }}
+fn reg_color_normalized(arg:u32, cm:u32, am:u32)->bool {{
+  if(arg<8u) {{ let r=arg/2u; return select((am&(1u<<r))!=0u,(cm&(1u<<r))!=0u,(arg&1u)==0u); }}
+  return true;
+}}
+fn reg_alpha_normalized(arg:u32, am:u32)->bool {{ return arg>=4u || (am&(1u<<arg))!=0u; }}
+fn konst_color(sel:u32)->vec3f {{
+  if(sel<8u) {{ return vec3f(f32(8u-sel)/8.0); }}
+  if(sel>=12u && sel<16u) {{ return table[record_index].value.kcolor[sel-12u].rgb; }}
+  let x=sel-16u; return vec3f(component(table[record_index].value.kcolor[x&3u],x/4u));
+}}
+fn konst_alpha(sel:u32)->f32 {{
+  if(sel<8u) {{ return f32(8u-sel)/8.0; }}
+  let x=sel-16u; return component(table[record_index].value.kcolor[x&3u],x/4u);
+}}
