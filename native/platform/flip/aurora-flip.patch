+  }();
+  return enabled;
+}
+inline bool flip_uniform_enabled() {
+  static const bool enabled = [] {
+    auto* s = std::getenv("MELEE_FLIP_UNIFORM_TABLE");
+    return s && std::strcmp(s, "0");
+  }();
+  return enabled;
+}
+inline bool flip_batch_enabled() {
+  static const bool enabled = [] {
+    auto* s = std::getenv("MELEE_FLIP_BATCH_DRAWS");
+    return s && std::strcmp(s, "0");
+  }();
+  return enabled && flip_vertex_enabled() && flip_uniform_enabled();
+}
+inline bool flip_cpu_upload_enabled() {
+  static const bool enabled = [] { const char* s=std::getenv("MELEE_FLIP_CPU_UPLOAD"); return !s || std::strcmp(s,"0"); }();
+  return enabled && flip_vertex_enabled();
+}
+inline bool flip_uniform_windows_enabled() {
+  static const bool enabled = [] { const char* s=std::getenv("MELEE_FLIP_UNIFORM_WINDOWS"); return !s || std::strcmp(s,"0"); }();
+  return enabled && flip_uniform_enabled() && flip_cpu_upload_enabled();
+}
+inline bool flip_texture_pairs_enabled() {
+  static const bool enabled = [] { const char* s=std::getenv("MELEE_FLIP_TEXTURE_PAIRS"); return s&&std::strcmp(s,"0"); }();
+  return enabled && flip_batch_enabled();
