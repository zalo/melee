+struct PassTimer {
+  using Clock=std::chrono::steady_clock;
+  Clock::time_point start;
+  GLuint query=0;
+  uint64_t frame=sFrameNumber;
+  struct Pending {GLuint query;uint64_t frame;};
+  static inline std::vector<Pending> pending;
+  static inline GetQuery64 get64=nullptr;
+  static inline bool initialized=false;
+  PassTimer() {
+    if(!profile_enabled()) return;
+    if(!initialized) {
+      const char* extensions=reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS));
+      if(extensions&&std::strstr(extensions,"GL_EXT_disjoint_timer_query"))
+        get64=reinterpret_cast<GetQuery64>(eglGetProcAddress("glGetQueryObjectui64vEXT"));
+      initialized=true;
+    }
+    if(get64) {
+      GLint disjoint=0;glGetIntegerv(GL_GPU_DISJOINT_EXT,&disjoint);
+      if(disjoint) {
+        for(auto& result:pending) glDeleteQueries(1,&result.query);
+        pending.clear();
+      }
+      for(auto it=pending.begin();it!=pending.end();) {
+        GLuint ready=0;glGetQueryObjectuiv(it->query,GL_QUERY_RESULT_AVAILABLE,&ready);
+        if(!ready) {++it;continue;}
+        GLuint64 ns=0;get64(it->query,GL_QUERY_RESULT,&ns);
+        if(!disjoint) std::fprintf(stderr,"[flip-direct-gpu] frame=%llu gpu_ms=%.3f\n",
+            static_cast<unsigned long long>(it->frame),double(ns)/1e6);
+        glDeleteQueries(1,&it->query);it=pending.erase(it);
+      }
+      // Sample asynchronously. Never wait for a GPU result in the submit path.
+      if(frame%60==0&&pending.size()<8) {
+        glGenQueries(1,&query);glBeginQuery(GL_TIME_ELAPSED_EXT,query);
+      }
+    }
+    start=Clock::now();
+  }
+  ~PassTimer() {
+    if(!profile_enabled()) return;
+    if(query) {glEndQuery(GL_TIME_ELAPSED_EXT);pending.push_back({query,frame});}
+    if(frame%60==0) std::fprintf(stderr,"[flip-direct-cpu] frame=%llu wall_ms=%.3f\n",
+        static_cast<unsigned long long>(frame),std::chrono::duration<double,std::milli>(Clock::now()-start).count());
+  }
+};
