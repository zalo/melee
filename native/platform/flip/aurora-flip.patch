+GLuint compile_shader(GLenum type,const char* source,const char* label) {
+  const GLuint shader=glCreateShader(type);
+  glShaderSource(shader,1,&source,nullptr);
+  glCompileShader(shader);
+  GLint ok=GL_FALSE;
+  glGetShaderiv(shader,GL_COMPILE_STATUS,&ok);
+  if(ok==GL_TRUE) return shader;
+  char log[2048]{};GLsizei length=0;
+  glGetShaderInfoLog(shader,sizeof(log),&length,log);
+  std::fprintf(stderr,"[flip-direct-error] %s shader compile: %.*s\n",label,int(length),log);
+  glDeleteShader(shader);
+  return 0;
+}
+
+GLuint clear_program() {
+  if(sClearProgram) return sClearProgram;
+  constexpr const char* vertex=R"GLSL(#version 310 es
+precision highp float;
+const vec2 positions[3]=vec2[3](vec2(-1.0,1.0),vec2(-1.0,-3.0),vec2(3.0,1.0));
+void main(){gl_Position=vec4(positions[gl_VertexID],0.0,1.0);}
+)GLSL";
+  constexpr const char* fragment=R"GLSL(#version 310 es
+precision highp float;
+layout(location=0) out vec4 color;
+void main(){color=vec4(1.0);}
+)GLSL";
+  const GLuint vs=compile_shader(GL_VERTEX_SHADER,vertex,"clear vertex");
+  const GLuint fs=compile_shader(GL_FRAGMENT_SHADER,fragment,"clear fragment");
+  if(!vs||!fs) {if(vs)glDeleteShader(vs);if(fs)glDeleteShader(fs);return 0;}
+  const GLuint program=glCreateProgram();
+  glAttachShader(program,vs);glAttachShader(program,fs);glLinkProgram(program);
+  glDeleteShader(vs);glDeleteShader(fs);
+  GLint ok=GL_FALSE;glGetProgramiv(program,GL_LINK_STATUS,&ok);
+  if(ok!=GL_TRUE) {
+    char log[2048]{};GLsizei length=0;glGetProgramInfoLog(program,sizeof(log),&length,log);
+    std::fprintf(stderr,"[flip-direct-error] clear program link: %.*s\n",int(length),log);
+    glDeleteProgram(program);return 0;
+  }
+  sClearProgram=program;
+  return program;
+}
+
+GLenum compare_func(GXCompare f) {
+  switch(f) {
+  case GX_NEVER:return GL_NEVER;
+  case GX_LESS:return gx::UseReversedZ?GL_GREATER:GL_LESS;
+  case GX_EQUAL:return GL_EQUAL;
+  case GX_LEQUAL:return gx::UseReversedZ?GL_GEQUAL:GL_LEQUAL;
+  case GX_GREATER:return gx::UseReversedZ?GL_LESS:GL_GREATER;
+  case GX_NEQUAL:return GL_NOTEQUAL;
+  case GX_GEQUAL:return gx::UseReversedZ?GL_LEQUAL:GL_GEQUAL;
+  case GX_ALWAYS:return GL_ALWAYS;
+  default:return GL_ALWAYS;
+  }
+}
+
+GLenum blend_factor(GXBlendFactor f,bool destination) {
+  switch(f) {
+  case GX_BL_ZERO:return GL_ZERO;
+  case GX_BL_ONE:return GL_ONE;
+  case GX_BL_SRCCLR:return destination?GL_SRC_COLOR:GL_DST_COLOR;
+  case GX_BL_INVSRCCLR:return destination?GL_ONE_MINUS_SRC_COLOR:GL_ONE_MINUS_DST_COLOR;
+  case GX_BL_SRCALPHA:return GL_SRC_ALPHA;
+  case GX_BL_INVSRCALPHA:return GL_ONE_MINUS_SRC_ALPHA;
+  case GX_BL_DSTALPHA:return GL_DST_ALPHA;
+  case GX_BL_INVDSTALPHA:return GL_ONE_MINUS_DST_ALPHA;
+  default:return GL_ONE;
+  }
+}
+
+void apply_pipeline_state(const gx::PipelineConfig& c) {
+  // GX pipelines use WebGPU CW winding. Both Tint and our native vertex
+  // shader invert clip-space Y for GLES, which reverses the winding.
+  glFrontFace(GL_CCW);
+  if(c.cullMode==GX_CULL_NONE) glDisable(GL_CULL_FACE);
+  else {glEnable(GL_CULL_FACE);glCullFace(c.cullMode==GX_CULL_FRONT?GL_FRONT:GL_BACK);}
+  if(c.depthCompare) {glEnable(GL_DEPTH_TEST);glDepthFunc(compare_func(c.depthFunc));}
+  else glDisable(GL_DEPTH_TEST);
+  glDepthMask(c.depthCompare&&c.depthUpdate?GL_TRUE:GL_FALSE);
+  glColorMask(c.colorUpdate,c.colorUpdate,c.colorUpdate,c.alphaUpdate);
+  GLenum src=GL_ONE,dst=GL_ZERO,equation=GL_FUNC_ADD;
+  if(c.blendMode==GX_BM_BLEND) {src=blend_factor(c.blendFacSrc,false);dst=blend_factor(c.blendFacDst,true);}
+  else if(c.blendMode==GX_BM_SUBTRACT) {src=dst=GL_ONE;equation=GL_FUNC_REVERSE_SUBTRACT;}
+  else if(c.blendMode==GX_BM_LOGIC) {
+    if(c.blendOp==GX_LO_CLEAR) src=dst=GL_ZERO;
+    else if(c.blendOp==GX_LO_NOOP) {src=GL_ZERO;dst=GL_ONE;}
+  }
+  const bool blend=c.blendMode!=GX_BM_NONE||c.dstAlpha!=UINT32_MAX;
+  if(blend) {
+    glEnable(GL_BLEND);glBlendEquationSeparate(equation,equation);
+    if(c.dstAlpha!=UINT32_MAX) {
+      glBlendColor(0,0,0,c.dstAlpha/255.f);
+      glBlendFuncSeparate(src,dst,GL_CONSTANT_ALPHA,GL_ZERO);
+    } else glBlendFunc(src,dst);
+  } else glDisable(GL_BLEND);
+  const float bias=std::round((gx::UseReversedZ?-1.f:1.f)*std::bit_cast<float>(c.polygonOffsetBits));
+  const float slope=(gx::UseReversedZ?-1.f:1.f)*std::bit_cast<float>(c.polygonOffsetScaleBits);
+  if(bias!=0.f||slope!=0.f) {glEnable(GL_POLYGON_OFFSET_FILL);glPolygonOffset(slope,bias);}
+  else glDisable(GL_POLYGON_OFFSET_FILL);
+}
+
+void bind_texture_unit(const dawn::native::opengl::DirectGLTextureInfo& texture,GLuint unit) {
+  if(cache_enabled()&&unit<sTextureState.size()) {
+    auto& state=sTextureState[unit];
+    const auto& last=state.texture;
+    if(state.valid&&last.texture==texture.texture&&last.target==texture.target&&
+       last.baseMipLevel==texture.baseMipLevel&&last.maxMipLevel==texture.maxMipLevel&&
+       std::equal(std::begin(last.swizzle),std::end(last.swizzle),std::begin(texture.swizzle))) return;
+    // Mip limits and swizzles belong to the texture object, not the unit.
+    // A different view of an aliased object invalidates the other unit caches.
+    for(auto& other:sTextureState)
+      if(&other!=&state&&other.valid&&other.texture.texture==texture.texture) other.valid=false;
+    state.valid=true;state.texture=texture;
+  }
+  glActiveTexture(GL_TEXTURE0+unit);
+  glBindTexture(texture.target,texture.texture);
+  glTexParameteri(texture.target,GL_TEXTURE_BASE_LEVEL,texture.baseMipLevel);
+  glTexParameteri(texture.target,GL_TEXTURE_MAX_LEVEL,texture.maxMipLevel);
+  if(texture.swizzle[0]!=GL_NONE) {
+    glTexParameteri(texture.target,GL_TEXTURE_SWIZZLE_R,texture.swizzle[0]);
+    glTexParameteri(texture.target,GL_TEXTURE_SWIZZLE_G,texture.swizzle[1]);
+    glTexParameteri(texture.target,GL_TEXTURE_SWIZZLE_B,texture.swizzle[2]);
+    glTexParameteri(texture.target,GL_TEXTURE_SWIZZLE_A,texture.swizzle[3]);
+  }
+}
+
+PreparedPipeline* prepare_pipeline(PipelineRef ref) {
+  using namespace dawn::native::opengl;
+  if(auto it=sPrepared.find(ref);it!=sPrepared.end()) return &it->second;
+  PreparedPipeline p;
+  if(!gx::find_flip_pipeline_config(ref,p.config)) return nullptr;
+  p.nativeUber=gx::flip_native_uber_enabled()&&(p.config.shaderConfig.flipFlags&gx::FlipUberShader);
+  if(p.nativeUber) {
+    p.gl.program=gx::flip_gles_uber_program(p.config.shaderConfig);
+    p.gl.topology=GL_TRIANGLES;
+    if(!p.gl.program) return nullptr;
+    // Native program creation changes current GL program.
+    sLastProgram=Unknown;
+  } else {
+    if(!get_pipeline(ref,p.owner)) return nullptr;
+    p.gl=GetDirectGLRenderPipeline(p.owner.Get());
+    p.uniformBinding=GetDirectGLBufferBinding(p.owner.Get(),1,0);
+    p.immediates=glGetUniformLocation(p.gl.program,"tint_immediates");
+  }
+  p.layout=gx::flip_vertex_attributes(p.config.shaderConfig);
+  const auto units=[&](uint32_t group,uint32_t binding,bool sampler) {
+    uint32_t values[32];
+    const auto count=GetDirectGLTextureUnits(p.owner.Get(),group,binding,sampler,values,32);
+    return std::vector<uint32_t>(values,values+std::min(count,32u));
+  };
+  if(!p.nativeUber) p.storageUnits=units(0,1,false);
+  for(uint32_t binding=0;binding<32;binding+=2) {
+    TextureBinding t{.binding=binding};
+    if(p.nativeUber) {
+      const auto name="tex"+std::to_string(binding/2);
+      if(glGetUniformLocation(p.gl.program,name.c_str())<0) continue;
+      t.textures={binding/2};t.samplers={binding/2};
+    }
+    else {t.textures=units(2,binding,false);t.samplers=units(2,binding+1,true);}
+    if(!t.textures.empty()) p.textures.push_back(std::move(t));
+  }
+  return &sPrepared.emplace(ref,std::move(p)).first->second;
+}
+
+void bind_draw_resources(const gx::DrawData& d,const PreparedPipeline& p) {
+  flip_profile::Scope resourcesProfile("gl_resources");
+  using namespace dawn::native::opengl;
+  auto& res=resources();
+  const uint32_t window=d.uniformRange.offset/gx::FlipUniformWindow;
+  {
+  flip_profile::Scope profile("gl_uniform_bind");
+  if(window<res.flipUniformBuffers.size()) {
+    const GLuint buffer=sStream.current?sStream.current->uniforms.name:GetDirectGLBuffer(res.flipUniformBuffers[window].Get());
+    const uint32_t offset=sStream.current?window*gx::FlipUniformWindow:0;
+    const GLuint binding=p.uniformBinding;
+    if(!cache_enabled()||sLastUniform!=buffer||sLastUniformBinding!=binding||sLastUniformOffset!=offset) {
+      glBindBufferRange(GL_UNIFORM_BUFFER,binding,buffer,offset,gx::FlipUniformWindow);
+      sLastUniform=buffer;sLastUniformBinding=binding;sLastUniformOffset=offset;
+    }
+  }
+  }
+  {
+  flip_profile::Scope profile("gl_texture_bind");
+  const auto staticGroup=res.staticBindGroup.Get();
+  if(!p.storageUnits.empty()) {
+    const auto texture=GetDirectGLBindGroupTexture(staticGroup,1);
+    for(auto unit:p.storageUnits) bind_texture_unit(texture,unit);
+  }
+  if(d.bindGroups.textureBindGroup) {
+    const auto group=find_bind_group(d.bindGroups.textureBindGroup);
+    for(const auto& t:p.textures) {
+      const auto texture=GetDirectGLBindGroupTexture(group.Get(),t.binding);
+      const GLuint sampler=GetDirectGLBindGroupSampler(group.Get(),t.binding+1);
+      for(auto unit:t.textures) bind_texture_unit(texture,unit);
+      for(auto unit:t.samplers) {
+        if(!cache_enabled()||unit>=sTextureState.size()||sTextureState[unit].sampler!=sampler) {
+          glBindSampler(unit,sampler);
+          if(unit<sTextureState.size()) sTextureState[unit].sampler=sampler;
+        }
+      }
+    }
+  }
+  }
+  {
+  flip_profile::Scope profile("gl_vertex_bind");
+  const auto& layout=p.layout;
+  const GLuint vertex=sStream.current?sStream.current->vertices.name:GetDirectGLBuffer(res.vertexBuffer.Get());
+  uint32_t used=0;
+  for(unsigned a=0;a<layout.count;++a) used|=1u<<layout.attributes[a].shaderLocation;
+  glBindVertexBuffer(0,vertex,d.vertRange.offset,layout.stride);
+  if(!cache_enabled()||sLastLayout!=used) {
+  for(unsigned a=0;a<layout.count;++a) {
+    const auto& attr=layout.attributes[a];
+    const GLuint loc=attr.shaderLocation;
+    if(loc==0) glVertexAttribIFormat(loc,3,GL_UNSIGNED_INT,attr.offset);
+    else {
+      const GLint count=loc==3||loc==4||loc==15?4:loc>=5&&loc<=12?2:3;
+      glVertexAttribFormat(loc,count,GL_FLOAT,GL_FALSE,attr.offset);
+    }
+    glVertexAttribBinding(loc,0);
+    glEnableVertexAttribArray(loc);
+  }
+  for(unsigned loc=0;loc<16;++loc) if((sEnabledAttributes&(1u<<loc))&&!(used&(1u<<loc)))
+    glDisableVertexAttribArray(loc);
+  sEnabledAttributes=used;
+  sLastLayout=used;
+  }
+  }
+
+  flip_profile::Scope immediateProfile("gl_immediates");
+  if(p.immediates>=0) {
+    auto immediate=d.immediateData;
+    immediate._pad=(d.uniformRange.offset%gx::FlipUniformWindow)/gx::FlipUniformStride;
+    glUniform1uiv(p.immediates,sizeof(immediate)/sizeof(uint32_t),reinterpret_cast<const GLuint*>(&immediate));
+  }
+}
+
+bool render_draw(const gx::DrawData& d,int mode,uint32_t passIndex,uint32_t drawIndex) {
+  if(flip_profile::enabled()) flip_profile::state.tag=(uint64_t(passIndex)<<32)|drawIndex;
+  flip_profile::Scope drawProfile("gl_draw_total");
+  auto* prepared=prepare_pipeline(d.pipeline);
+  if(!prepared) {
+    std::fprintf(stderr,"[flip-direct-error] frame=%llu pass=%u draw=%u section=pipeline-lookup\n",
+                 static_cast<unsigned long long>(sFrameNumber),passIndex,drawIndex);
+    return false;
+  }
+  const auto& native=prepared->gl;
+  if(flip_profile::active()) {
+    const auto& c=prepared->config.shaderConfig;
+    char text[512];
+    std::snprintf(text,sizeof(text),"tag=%llu pipeline=%llu program=%u vertices=%u indices=%u vertex_stride=%u tev=%u texture_group=%llu window=%u program_change=%u pipeline_change=%u",
+      (unsigned long long)flip_profile::state.tag,(unsigned long long)d.pipeline,native.program,d.vtxCount,d.indexCount,
+      prepared->layout.stride,c.tevStageCount,(unsigned long long)d.bindGroups.textureBindGroup,
+      d.uniformRange.offset/gx::FlipUniformWindow,sLastProgram!=native.program,sLastPipeline!=d.pipeline);
+    flip_profile::state.patterns.emplace_back(text);
+  }
+  {
+  flip_profile::Scope profile("gl_pipeline_state");
+  if(!cache_enabled()||sLastProgram!=native.program) {glUseProgram(native.program);sLastProgram=native.program;}
+  if(!cache_enabled()||sLastPipeline!=d.pipeline) {apply_pipeline_state(prepared->config);sLastPipeline=d.pipeline;}
+  }
+  if(!gl_ok("pipeline-state",passIndex,drawIndex)||mode<4) return true;
+  bind_draw_resources(d,*prepared);
+  if(!gl_ok("resources",passIndex,drawIndex)||mode<5||drawIndex>=draw_limit()) return true;
+  {
+  flip_profile::Scope profile("gl_draw_call");
+  if(d.indexCount) glDrawElementsInstanced(native.topology,d.indexCount,GL_UNSIGNED_SHORT,
+      reinterpret_cast<const void*>(uintptr_t(d.idxRange.offset)),d.instanceCount);
+  else glDrawArraysInstanced(native.topology,0,d.vtxCount,d.instanceCount);
+  }
+  if(mode>=6) glMemoryBarrier(GL_TEXTURE_FETCH_BARRIER_BIT);
+  return gl_ok("draw",passIndex,drawIndex);
+}
+
+bool render_clear(const clear::DrawData& d,uint32_t width,uint32_t height,
+                  uint32_t passIndex,uint32_t drawIndex) {
+  clear::PipelineConfig config;
+  if(!clear::find_flip_pipeline_config(d.pipeline,config)) {
+    std::fprintf(stderr,"[flip-direct-error] frame=%llu pass=%u draw=%u section=clear-pipeline-lookup\n",
+                 static_cast<unsigned long long>(sFrameNumber),passIndex,drawIndex);
+    return false;
+  }
+  const GLuint program=clear_program();
+  if(!program) return false;
+  glUseProgram(program);
+  sLastProgram=Unknown;sLastPipeline=UINTPTR_MAX;
+  glDisable(GL_CULL_FACE);
+  glEnable(GL_BLEND);
+  glBlendEquationSeparate(GL_FUNC_ADD,GL_FUNC_ADD);
+  glBlendFuncSeparate(GL_CONSTANT_COLOR,GL_ZERO,GL_CONSTANT_ALPHA,GL_ZERO);
+  glBlendColor(d.color.r,d.color.g,d.color.b,d.color.a);
+  glDisable(GL_STENCIL_TEST);
+  glDisable(GL_POLYGON_OFFSET_FILL);
+  glEnable(GL_DEPTH_TEST);
+  glDepthFunc(GL_ALWAYS);
+  glColorMask(config.clearColor,config.clearColor,config.clearColor,config.clearAlpha);
+  glDepthMask(config.clearDepth?GL_TRUE:GL_FALSE);
+  glViewport(0,0,width,height);
+  glDepthRangef(d.depth,d.depth);
+  glScissor(0,0,width,height);
+  glDrawArrays(GL_TRIANGLES,0,3);
+  return gl_ok("clear",passIndex,drawIndex);
+}
+
+bool render_pass(void*,uint32_t passIndex,const char* label) {
+  flip_profile::Scope profile("gl_pass",passIndex);
+  if(sNextPlan>=sPlans.size()) return false;
+  auto& plan=sPlans[sNextPlan];
+  if(!label||plan.label!=label) return false;
+  const auto target=dawn::native::opengl::GetDirectGLTextureView(plan.target.Get());
+  ++sNextPlan;
+  if(!plan.eligible) return false;
+  PassTimer timer;
+  const int mode=direct_mode();
+  while(glGetError()!=GL_NO_ERROR) {}
+  if(sFrameNumber<8)
+    std::fprintf(stderr,"[flip-direct] frame=%llu pass=%u mode=%d commands=%zu target=%u\n",
+                 static_cast<unsigned long long>(sFrameNumber),passIndex,mode,
+                 plan.commands.size(),target.texture?target.texture:target.renderbuffer);
+  if(mode>=2) {
+    if(!sVao) glGenVertexArrays(1,&sVao);
+    glBindVertexArray(sVao);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER,sStream.current?sStream.current->indices.name:
+        dawn::native::opengl::GetDirectGLBuffer(resources().indexBuffer.Get()));
+    sLastProgram=sLastUniform=sLastUniformBinding=sLastLayout=Unknown;
+    sLastUniformOffset=Unknown;
+    sLastPipeline=UINTPTR_MAX;sTextureState={};
+    glEnable(GL_SCISSOR_TEST);
+    glDisable(GL_STENCIL_TEST);
+    gl_ok("pass-state",passIndex,0);
+  }
+  uint32_t drawIndex=0;
+  for(const auto& command:plan.commands) {
+    if(command.type==CommandType::SetViewport) {
+      if(mode<2) continue;
+      const auto& v=command.viewport;
+      glViewport(GLint(v.left),GLint(v.top),GLsizei(v.width),GLsizei(v.height));
+      const float nearDepth=gx::UseReversedZ?1.f-v.zfar:v.znear;
+      const float farDepth=gx::UseReversedZ?1.f-v.znear:v.zfar;
+      glDepthRangef(nearDepth,farDepth);
+    } else if(command.type==CommandType::SetScissor) {
+      if(mode<2) continue;
+      const auto& s=command.scissor;
+      const auto x=std::min(static_cast<uint32_t>(s.x),plan.width);
+      const auto y=std::min(static_cast<uint32_t>(s.y),plan.height);
+      glScissor(x,y,std::min(static_cast<uint32_t>(s.width),plan.width-x),
+                    std::min(static_cast<uint32_t>(s.height),plan.height-y));
+    } else if(command.type==CommandType::Draw) {
+      if(mode>=3) {
+        if(command.isClear) render_clear(command.clear,plan.width,plan.height,passIndex,drawIndex);
+        else render_draw(command.draw,mode,passIndex,drawIndex);
+      }
+      ++drawIndex;
+    }
+  }
+  gl_ok("pass-end",passIndex,drawIndex);
+  // Once an eligible pass is intercepted it must not also be replayed by Dawn,
+  // even if a diagnostic GL error occurred after some direct commands ran.
+  return true;
+}
+}
+
+bool encode_flip_gles_resources(const wgpu::RenderPassEncoder& encoder,RenderPass& pass,std::string_view label) {
+  pass.flipDirectLabel=label;
+  static const bool enabled=[] {const char* v=std::getenv("MELEE_FLIP_DIRECT_PACKET");return v&&std::strcmp(v,"0");}();
+  if(!enabled||direct_mode()<5||pass.msaaSamples!=1||pass.colorAttachmentCount!=1||
+     !gx::flip_vertex_enabled()||!gx::flip_uniform_windows_enabled()) return false;
+  std::unordered_set<PipelineRef> seenPipelines;
+  std::vector<wgpu::RenderPipeline> pipelines;
+  std::unordered_set<uint64_t> textures;
+  std::unordered_set<uint32_t> windows;
+  bool hasDraw=false;
+  // Decide for the whole immutable pass before recording anything. Failure
+  // preserves all reference commands, never a partially intercepted pass.
+  for(const auto& command:pass.commands) {
+    if(command.type==CommandType::CustomDraw) return false;
+    if(command.type!=CommandType::Draw) continue;
+    gx::DrawData d;clear::DrawData clear;
+    if(decode_flip_clear_draw(command.data.draw,clear)) continue;
+    if(!decode_flip_gx_draw(command.data.draw,d)) return false;
+    hasDraw=true;
+    if(seenPipelines.insert(d.pipeline).second) {
+      gx::PipelineConfig c;wgpu::RenderPipeline p;
+      if(!get_pipeline(d.pipeline,p)||!gx::find_flip_pipeline_config(d.pipeline,c)||
+         c.shaderConfig.fogRangeEnabled||!(c.shaderConfig.flipFlags&gx::FlipBatchedDraws)||
+         std::bit_cast<float>(c.polygonOffsetClampBits)!=0.f) return false;
+      pipelines.push_back(std::move(p));
+    }
+    if(d.bindGroups.textureBindGroup) textures.insert(d.bindGroups.textureBindGroup);
+    windows.insert(d.uniformRange.offset/gx::FlipUniformWindow);
+  }
+  if(!hasDraw) return false;
+  const auto& res=resources();
+  encoder.SetVertexBuffer(0,res.vertexBuffer);
+  encoder.SetIndexBuffer(res.indexBuffer,wgpu::IndexFormat::Uint16);
+  encoder.SetBindGroup(0,res.staticBindGroup);
+  for(const auto& p:pipelines) encoder.SetPipeline(p);
+  const uint32_t zero=0;
+  for(auto window:windows) encoder.SetBindGroup(1,flip_uniform_window(window),1,&zero);
+  for(auto texture:textures) encoder.SetBindGroup(2,find_bind_group(texture));
+  pass.flipDirectResourcesOnly=true;
+  return true;
+}
+
+void prepare_flip_gles_frame(FramePacket& frame) {
+  sPlans.clear();sNextPlan=0;++sFrameNumber;
+  if(!direct_mode()) return;
+  for(auto& pass:frame.renderPasses) {
+    if(!pass.sealed||pass.discardable||!pass.colorAttachmentCount) continue;
+    PassPlan plan{.target=pass.colorAttachments[0].view,
+                  .label=pass.flipDirectLabel,
+                  .width=pass.colorAttachments[0].size.width,
+                  .height=pass.colorAttachments[0].size.height,
+                  .eligible=pass.msaaSamples==1&&pass.colorAttachmentCount==1&&
+                            gx::flip_vertex_enabled()&&gx::flip_uniform_windows_enabled()};
+    bool hasGxDraw=false;
+    uint32_t gxDraws=0,clearDraws=0,otherDraws=0,customDraws=0;
+    for(const auto& command:pass.commands) {
+      PlanCommand out{.type=command.type};
+      if(command.type==CommandType::SetViewport) out.viewport=command.data.setViewport;
+      else if(command.type==CommandType::SetScissor) out.scissor=command.data.setScissor;
+      else if(command.type==CommandType::Draw) {
+        if(decode_flip_gx_draw(command.data.draw,out.draw)) {
+          hasGxDraw=true;++gxDraws;
+          gx::PipelineConfig config;
+          // These paths still need Dawn's packed immediate/depth-clamp ABI.
+          // Retain the complete reference pass when it is required.
+          if(!gx::find_flip_pipeline_config(out.draw.pipeline,config)||
+             config.shaderConfig.fogRangeEnabled||!(config.shaderConfig.flipFlags&gx::FlipBatchedDraws)||
+             std::bit_cast<float>(config.polygonOffsetClampBits)!=0.f) plan.eligible=false;
+        }
+        else if(decode_flip_clear_draw(command.data.draw,out.clear)) {out.isClear=true;++clearDraws;}
+        else {plan.eligible=false;++otherDraws;}
+      } else if(command.type==CommandType::CustomDraw) {plan.eligible=false;++customDraws;}
+      plan.commands.push_back(out);
+    }
+    plan.eligible&=hasGxDraw;
+    AURORA_ASSERT(!pass.flipDirectResourcesOnly||plan.eligible,"Direct resource-only pass lost eligibility");
+    if((sFrameNumber%120)==0)
+      std::fprintf(stderr,"[flip-direct-plan] frame=%llu pass=%zu eligible=%u gx=%u clear=%u other=%u custom=%u commands=%zu\n",
+                   static_cast<unsigned long long>(sFrameNumber),sPlans.size(),plan.eligible,
+                   gxDraws,clearDraws,otherDraws,customDraws,plan.commands.size());
+    sPlans.push_back(std::move(plan));
+  }
+}
+
+void install_flip_gles_frame() {
+  if(direct_mode()) dawn::native::opengl::SetDirectGLRenderPassCallback(render_pass,nullptr);
+}
+void uninstall_flip_gles_frame() {
+  dawn::native::opengl::SetDirectGLRenderPassCallback(nullptr,nullptr);
+  if(sStream.pending) dawn::native::opengl::RunDirectGL(webgpu::g_device.Get(),[](void*) {sStream.finish();},nullptr);
+  flip_profile::end();
+}
+bool upload_flip_gles_stream(FramePacket& frame) {
+  sStream.current=nullptr;
+  static const bool enabled=[] {const char* v=std::getenv("MELEE_FLIP_STREAM_UPLOAD");return v&&!std::strcmp(v,"1");}();
+  if(!enabled||direct_mode()<5||!frame.encoderTasks.empty()) return false;
+  static const unsigned every=[] {const char* v=std::getenv("MELEE_FLIP_STREAM_EVERY");return v?std::max(1,std::atoi(v)):1;}();
+  if(frame.frameId%every) return false;
+  bool hasDraw=false;
+  // Only skip reference uploads if every consumer of shared geometry is a
+  // qualified resource-only GX pass. Never feed stale buffers to a fallback.
+  for(const auto& pass:frame.renderPasses) {
+    if(!pass.sealed||pass.discardable) continue;
+    for(const auto& command:pass.commands) {
+      if(command.type==CommandType::CustomDraw) return false;
+      if(command.type!=CommandType::Draw) continue;
+      clear::DrawData clear;
+      if(decode_flip_clear_draw(command.data.draw,clear)) continue;
+      gx::DrawData draw;
+      if(!decode_flip_gx_draw(command.data.draw,draw)||!pass.flipDirectResourcesOnly) return false;
+      hasDraw=true;
+    }
+  }
+  if(!hasDraw) return false;
+  struct Upload {FramePacket* frame;bool success=false;} upload{&frame};
+  const bool ran=dawn::native::opengl::RunDirectGL(webgpu::g_device.Get(),[](void* data) {
+    auto& upload=*static_cast<Upload*>(data);const auto& f=*upload.frame;
+    upload.success=sStream.upload(f.verts.data(),AURORA_ALIGN(f.verts.size(),4),
+                                  f.indices.data(),AURORA_ALIGN(f.indices.size(),4),
+                                  f.uniforms.data(),AURORA_ALIGN(f.uniforms.size(),4),profile_enabled());
+  },&upload);
+  return ran&&upload.success;
+}
+void shutdown_flip_gles() {
+  uninstall_flip_gles_frame();
+  if(!direct_mode()) return;
+  dawn::native::opengl::RunDirectGL(webgpu::g_device.Get(),[](void*) {
+    sStream.shutdown();
+    for(auto& pending:PassTimer::pending) glDeleteQueries(1,&pending.query);
+    PassTimer::pending.clear();PassTimer::get64=nullptr;PassTimer::initialized=false;
+    gx::shutdown_flip_gles_uber();
+    if(sVao) glDeleteVertexArrays(1,&sVao);
+    if(sClearProgram) glDeleteProgram(sClearProgram);
+    sVao=sClearProgram=sEnabledAttributes=0;
+  },nullptr);
+  sPrepared.clear();sPlans.clear();sNextPlan=0;sFrameNumber=0;
+}
+}
+#endif
