+GLuint flip_gles_uber_program(const ShaderConfig& config) noexcept {
+  const auto tevStages=std::clamp(config.tevStageCount,1u,16u);
+  const bool specialized=flip_native_specialized_enabled();
+  const auto state=flip_uber_state(config);
+  if(specialized) {
+    const auto found=sSpecializedPrograms.find(state);
+    if(found!=sSpecializedPrograms.end()) return found->second;
+    sSpecializedPrograms.emplace(state,0);
+  } else {
+    if(sPrograms[tevStages]) return sPrograms[tevStages];
+    if(sAttempted[tevStages]) return 0;
+    sAttempted[tevStages]=true;
+  }
+  std::string vertex=VertexSource;
+  std::string fragment=FragmentSource;
+  const auto versionEnd=fragment.find('\n');
+  fragment.insert(versionEnd+1,"#define FLIP_TEV_STAGES "+std::to_string(tevStages)+"\n");
+  if(specialized) {
+    std::string constants="uint material_word(uint index) { switch(index) {\n";
+    for(size_t i=0;i<state.size();++i)
+      constants+="case "+std::to_string(i)+"u: return "+std::to_string(state[i])+"u;\n";
+    constants+="default: return 0u; } }\n";
+    const auto replace=[](std::string& source,const std::string& from,const std::string& to) {
+      size_t pos=0;
+      while((pos=source.find(from,pos))!=std::string::npos) {
+        source.replace(pos,from.size(),to);pos+=to.size();
+      }
+    };
+    replace(vertex,"uint state_word(uint record,uint index) { return table[record].state[index>>2u][index&3u]; }",
+            constants+"uint state_word(uint record,uint index) { return material_word(index); }");
+    replace(fragment,"uint word(uint i){return table[v_record].state[i>>2u][i&3u];}",
+            constants+"uint word(uint i){return material_word(i);}");
+    // Explicitly unroll the TEV interpreter so constant propagation eliminates
+    // unused textures, varyings, register branches, and arithmetic paths.
+    const std::string loop="for(uint i=0u;i<uint(FLIP_TEV_STAGES);++i){";
+    const auto begin=fragment.find(loop);
+    size_t end=begin+loop.size(),depth=1;
+    for(;end<fragment.size()&&depth;++end) {
+      if(fragment[end]=='{') ++depth;
+      else if(fragment[end]=='}') --depth;
+    }
+    const auto body=fragment.substr(begin+loop.size(),end-begin-loop.size()-1);
+    std::string stages;
+    for(u32 i=0;i<tevStages;++i)
+      stages+="{ const uint i="+std::to_string(i)+"u; "+body+"}\n";
+    fragment.replace(begin,end-begin,stages);
+    if(!(config.flipFlags&FlipTexturePairs))
