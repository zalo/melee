+  set(1, offsetof(FlipVertex, pos), wgpu::VertexFormat::Float32x3);
+  set(2, offsetof(FlipVertex, normal), wgpu::VertexFormat::Float32x3);
+  for (unsigned i = 0; i < 2; ++i)
+    set(3 + i, offsetof(FlipVertex, color) + 16 * i, wgpu::VertexFormat::Float32x4);
+  for (unsigned i = 0; i < 8; ++i)
+    set(5 + i, offsetof(FlipVertex, tex) + 8 * i, wgpu::VertexFormat::Float32x2);
+  set(13, offsetof(FlipVertex, binormal), wgpu::VertexFormat::Float32x3);
+  set(14, offsetof(FlipVertex, tangent), wgpu::VertexFormat::Float32x3);
+  set(15, offsetof(FlipVertex, lineEnd), wgpu::VertexFormat::Float32x4);
+  return out;
