+  FlipVertexLayout out{};
+  const auto set = [&](unsigned i, size_t off, wgpu::VertexFormat f) {
+    if (!flip_vertex_location(c, i))
+      return;
+    auto& a = out.attributes[out.count];
+    a.shaderLocation = i;
+    a.offset = out.stride;
+    a.format = f;
+    out.sources[out.count++] = off;
+    out.stride += flip_attribute_bytes(i);
