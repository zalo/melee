+inline bool flip_vertex_location(const ShaderConfig& c, unsigned i) {
+  if (c.flipFlags & FlipUberShader)
+    return i < 15;
+  if (i == 0) {
+    if (c.lineMode || (c.flipFlags & FlipBatchedDraws))
+      return true;
+    for (unsigned a = GX_VA_PNMTXIDX; a <= GX_VA_TEX7MTXIDX; ++a)
+      if (c.attrs[a].attrType != GX_NONE)
+        return true;
+    return false;
+  }
+  if (i == 1)
+    return true;
+  if (i == 2)
+    return c.attrs[GX_VA_NRM].attrType != GX_NONE;
+  if (i < 5)
+    return c.attrs[GX_VA_CLR0 + i - 3].attrType != GX_NONE;
+  if (i < 13)
+    return c.attrs[GX_VA_TEX0 + i - 5].attrType != GX_NONE;
+  if (i < 15)
+    return c.attrs[GX_VA_NRM].attrType != GX_NONE && c.attrs[GX_VA_NRM].cnt == 9;
