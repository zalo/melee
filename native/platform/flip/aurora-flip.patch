+  // GX pipelines use WebGPU CW winding. Both Tint and our native vertex
+  // shader invert clip-space Y for GLES, which reverses the winding.
+  if(fresh) glFrontFace(GL_CCW);
+  const bool cull=c.cullMode!=GX_CULL_NONE;
+  const GLenum cullFace=c.cullMode==GX_CULL_FRONT?GL_FRONT:GL_BACK;
+  if(fresh||st.cull!=cull) { if(cull) glEnable(GL_CULL_FACE); else glDisable(GL_CULL_FACE); }
+  if(cull&&(fresh||!st.cull||st.cullFace!=cullFace)) glCullFace(cullFace);
+  const bool depth=c.depthCompare!=0;
+  const GLenum depthFunc=compare_func(c.depthFunc);
+  if(fresh||st.depth!=depth) { if(depth) glEnable(GL_DEPTH_TEST); else glDisable(GL_DEPTH_TEST); }
+  if(depth&&(fresh||!st.depth||st.depthFunc!=depthFunc)) glDepthFunc(depthFunc);
+  const GLboolean depthMask=c.depthCompare&&c.depthUpdate?GL_TRUE:GL_FALSE;
+  if(fresh||st.depthMask!=depthMask) glDepthMask(depthMask);
+  const GLboolean colorMask[4]={GLboolean(c.colorUpdate),GLboolean(c.colorUpdate),GLboolean(c.colorUpdate),GLboolean(c.alphaUpdate)};
+  if(fresh||std::memcmp(st.colorMask,colorMask,4)) glColorMask(colorMask[0],colorMask[1],colorMask[2],colorMask[3]);
+  GLenum src=GL_ONE,dst=GL_ZERO,equation=GL_FUNC_ADD;
+  if(c.blendMode==GX_BM_BLEND) {src=blend_factor(c.blendFacSrc,false);dst=blend_factor(c.blendFacDst,true);}
+  else if(c.blendMode==GX_BM_SUBTRACT) {src=dst=GL_ONE;equation=GL_FUNC_REVERSE_SUBTRACT;}
+  else if(c.blendMode==GX_BM_LOGIC) {
+    if(c.blendOp==GX_LO_CLEAR) src=dst=GL_ZERO;
+    else if(c.blendOp==GX_LO_NOOP) {src=GL_ZERO;dst=GL_ONE;}
+  }
+  const bool blend=c.blendMode!=GX_BM_NONE||c.dstAlpha!=UINT32_MAX;
+  if(fresh||st.blend!=blend) { if(blend) glEnable(GL_BLEND); else glDisable(GL_BLEND); }
+  if(blend) {
+    if(fresh||!st.blend||st.equation!=equation) glBlendEquationSeparate(equation,equation);
+    if(c.dstAlpha!=UINT32_MAX) {
+      const float constantAlpha=c.dstAlpha/255.f;
+      if(fresh||st.constantAlpha!=constantAlpha) glBlendColor(0,0,0,constantAlpha);
+      if(fresh||!st.blend||!st.separate||st.src!=src||st.dst!=dst) glBlendFuncSeparate(src,dst,GL_CONSTANT_ALPHA,GL_ZERO);
+      st.separate=true; st.constantAlpha=constantAlpha;
+    } else {
+      if(fresh||!st.blend||st.separate||st.src!=src||st.dst!=dst) glBlendFunc(src,dst);
+      st.separate=false;
+    }
+    st.equation=equation; st.src=src; st.dst=dst;
+  }
+  const float bias=std::round((gx::UseReversedZ?-1.f:1.f)*std::bit_cast<float>(c.polygonOffsetBits));
+  const float slope=(gx::UseReversedZ?-1.f:1.f)*std::bit_cast<float>(c.polygonOffsetScaleBits);
+  const bool polygonOffset=bias!=0.f||slope!=0.f;
+  if(fresh||st.polygonOffset!=polygonOffset) { if(polygonOffset) glEnable(GL_POLYGON_OFFSET_FILL); else glDisable(GL_POLYGON_OFFSET_FILL); }
+  if(polygonOffset&&(fresh||!st.polygonOffset||st.slope!=slope||st.bias!=bias)) glPolygonOffset(slope,bias);
+  st.valid=true; st.cull=cull; st.cullFace=cullFace; st.depth=depth; st.depthFunc=depthFunc; st.depthMask=depthMask;
+  std::memcpy(st.colorMask,colorMask,4); st.blend=blend; st.polygonOffset=polygonOffset; st.slope=slope; st.bias=bias;
+}
+
+// Texture parameters (mip range, swizzle) are object state. Within one direct
+// pass no other code touches these objects, so set them once per object per pass.
+// Sampler state is folded into the texture object as well (GX textures almost
+// always use one sampler), so draws do not rebind sampler objects on Mali.
+struct SamplerParams { GLint wrapS,wrapT,minFilter,magFilter; GLfloat minLod,maxLod; GLint compareMode,compareFunc; GLfloat anisotropy; };
+bool texture_sampler_state_enabled() {
+  static const bool enabled=[] {const char* v=std::getenv("MELEE_FLIP_TEXTURE_SAMPLER_STATE");return !v||std::strcmp(v,"0");}();
+  return enabled&&cache_enabled();
+}
+const SamplerParams& sampler_params(GLuint sampler) {
+  static std::unordered_map<GLuint,SamplerParams> cache;
+  auto it=cache.find(sampler);
+  if(it!=cache.end()) return it->second;
+  SamplerParams p{};
+  glGetSamplerParameteriv(sampler,GL_TEXTURE_WRAP_S,&p.wrapS);
+  glGetSamplerParameteriv(sampler,GL_TEXTURE_WRAP_T,&p.wrapT);
+  glGetSamplerParameteriv(sampler,GL_TEXTURE_MIN_FILTER,&p.minFilter);
+  glGetSamplerParameteriv(sampler,GL_TEXTURE_MAG_FILTER,&p.magFilter);
+  glGetSamplerParameterfv(sampler,GL_TEXTURE_MIN_LOD,&p.minLod);
+  glGetSamplerParameterfv(sampler,GL_TEXTURE_MAX_LOD,&p.maxLod);
+  glGetSamplerParameteriv(sampler,GL_TEXTURE_COMPARE_MODE,&p.compareMode);
+  glGetSamplerParameteriv(sampler,GL_TEXTURE_COMPARE_FUNC,&p.compareFunc);
+  p.anisotropy=1.f;
+  glGetSamplerParameterfv(sampler,0x84FE /*GL_TEXTURE_MAX_ANISOTROPY_EXT*/,&p.anisotropy);
+  while(glGetError()!=GL_NO_ERROR) {}
+  return cache.emplace(sampler,p).first->second;
+}
+struct TextureSamplerState { GLuint sampler=Unknown; };
+std::unordered_map<GLuint,TextureSamplerState> sTextureSamplers; // texture object -> sampler whose state it carries
+void apply_sampler_to_texture(GLenum target,GLuint texture,GLuint sampler) {
+  auto& st=sTextureSamplers[texture];
+  if(st.sampler==sampler) return;
+  const auto& p=sampler_params(sampler);
+  ++sGlCalls.texParams; glTexParameteri(target,GL_TEXTURE_WRAP_S,p.wrapS);
+  glTexParameteri(target,GL_TEXTURE_WRAP_T,p.wrapT);
+  glTexParameteri(target,GL_TEXTURE_MIN_FILTER,p.minFilter);
+  glTexParameteri(target,GL_TEXTURE_MAG_FILTER,p.magFilter);
+  glTexParameterf(target,GL_TEXTURE_MIN_LOD,p.minLod);
+  glTexParameterf(target,GL_TEXTURE_MAX_LOD,p.maxLod);
+  glTexParameteri(target,GL_TEXTURE_COMPARE_MODE,p.compareMode);
+  if(p.compareMode!=GL_NONE) glTexParameteri(target,GL_TEXTURE_COMPARE_FUNC,p.compareFunc);
+  st.sampler=sampler;
+}
+struct TextureParams { GLint baseMipLevel,maxMipLevel; unsigned swizzle[4]; };
+std::unordered_map<GLuint,TextureParams> sTextureParams;
+GLuint sActiveUnit=Unknown;
+
+void bind_texture_unit(const dawn::native::opengl::DirectGLTextureInfo& texture,GLuint unit) {
+  if(cache_enabled()&&unit<sTextureState.size()) {
+    auto& state=sTextureState[unit];
+    const auto& last=state.texture;
+    if(state.valid&&last.texture==texture.texture&&last.target==texture.target&&
+       last.baseMipLevel==texture.baseMipLevel&&last.maxMipLevel==texture.maxMipLevel&&
+       std::equal(std::begin(last.swizzle),std::end(last.swizzle),std::begin(texture.swizzle))) return;
+    // Mip limits and swizzles belong to the texture object, not the unit.
+    // A different view of an aliased object invalidates the other unit caches.
+    for(auto& other:sTextureState)
+      if(&other!=&state&&other.valid&&other.texture.texture==texture.texture) other.valid=false;
+    state.valid=true;state.texture=texture;
+  }
+  if(!cache_enabled()||sActiveUnit!=unit) {glActiveTexture(GL_TEXTURE0+unit);sActiveUnit=unit;}
+  glBindTexture(texture.target,texture.texture); ++sGlCalls.textures;
+  const TextureParams params{GLint(texture.baseMipLevel),GLint(texture.maxMipLevel),
+    {texture.swizzle[0],texture.swizzle[1],texture.swizzle[2],texture.swizzle[3]}};
+  if(cache_enabled()) {
+    auto [it,inserted]=sTextureParams.try_emplace(texture.texture,params);
+    if(!inserted) {
+      if(!std::memcmp(&it->second,&params,sizeof(params))) return;
+      it->second=params;
+    }
+  }
+  ++sGlCalls.texParams; glTexParameteri(texture.target,GL_TEXTURE_BASE_LEVEL,texture.baseMipLevel);
+  glTexParameteri(texture.target,GL_TEXTURE_MAX_LEVEL,texture.maxMipLevel);
+  if(texture.swizzle[0]!=GL_NONE) {
+    glTexParameteri(texture.target,GL_TEXTURE_SWIZZLE_R,texture.swizzle[0]);
+    glTexParameteri(texture.target,GL_TEXTURE_SWIZZLE_G,texture.swizzle[1]);
+    glTexParameteri(texture.target,GL_TEXTURE_SWIZZLE_B,texture.swizzle[2]);
+    glTexParameteri(texture.target,GL_TEXTURE_SWIZZLE_A,texture.swizzle[3]);
+  }
+}
+
+// Resolved GL names for one (bind group, pipeline texture bindings) pair. Bind
+// groups are immutable; entries are dropped when the bind group cache evicts.
+struct ResolvedTextures {
+  uint64_t generation=0;
+  struct Entry { dawn::native::opengl::DirectGLTextureInfo texture; GLuint sampler; };
+  std::vector<Entry> entries; // one per PreparedPipeline::textures element
+};
+std::unordered_map<uint64_t,ResolvedTextures> sResolvedTextures;
+const ResolvedTextures& resolve_textures(BindGroupRef group,PipelineRef pipeline,const PreparedPipeline& p) {
+  using namespace dawn::native::opengl;
+  const uint64_t generation=bind_group_cache_generation();
+  const uint64_t key=group*0x9E3779B97F4A7C15ull^uint64_t(pipeline);
+  auto it=sResolvedTextures.find(key);
+  if(it!=sResolvedTextures.end()&&it->second.generation==generation) return it->second;
+  if(it==sResolvedTextures.end()) it=sResolvedTextures.emplace(key,ResolvedTextures{}).first;
+  auto& r=it->second; r.generation=generation; r.entries.clear();
+  const auto bindGroup=find_bind_group(group);
+  for(const auto& t:p.textures)
+    r.entries.push_back({GetDirectGLBindGroupTexture(bindGroup.Get(),t.binding),GetDirectGLBindGroupSampler(bindGroup.Get(),t.binding+1)});
+  return r;
+}
+
+PreparedPipeline* prepare_pipeline(PipelineRef ref) {
+  using namespace dawn::native::opengl;
+  if(auto it=sPrepared.find(ref);it!=sPrepared.end()) return &it->second;
+  PreparedPipeline p;
+  if(!gx::find_flip_pipeline_config(ref,p.config)) return nullptr;
+  p.nativeUber=gx::flip_native_uber_enabled()&&(p.config.shaderConfig.flipFlags&gx::FlipUberShader);
+  if(p.nativeUber) {
+    p.gl.program=gx::flip_gles_uber_program(p.config.shaderConfig);
+    p.gl.topology=GL_TRIANGLES;
+    if(!p.gl.program) return nullptr;
+    // Native program creation changes current GL program.
+    sLastProgram=Unknown;
+  } else {
+    if(!get_pipeline(ref,p.owner)) return nullptr;
+    p.gl=GetDirectGLRenderPipeline(p.owner.Get());
+    p.uniformBinding=GetDirectGLBufferBinding(p.owner.Get(),1,0);
+    p.immediates=glGetUniformLocation(p.gl.program,"tint_immediates");
+    static const bool skipImmediates=[] {const char* v=std::getenv("MELEE_FLIP_SKIP_IMMEDIATES");return !v||std::strcmp(v,"0");}();
+    const auto& sc=p.config.shaderConfig;
+    p.immediatesUnused=skipImmediates&&(sc.flipFlags&gx::FlipVertexInput)&&(sc.flipFlags&gx::FlipBatchedDraws)&&
+      !sc.fogRangeEnabled&&std::bit_cast<float>(p.config.polygonOffsetClampBits)==0.f;
+  }
+  p.layout=gx::flip_vertex_attributes(p.config.shaderConfig);
+  const auto units=[&](uint32_t group,uint32_t binding,bool sampler) {
+    uint32_t values[32];
+    const auto count=GetDirectGLTextureUnits(p.owner.Get(),group,binding,sampler,values,32);
+    return std::vector<uint32_t>(values,values+std::min(count,32u));
+  };
+  if(!p.nativeUber) p.storageUnits=units(0,1,false);
+  for(uint32_t binding=0;binding<32;binding+=2) {
+    TextureBinding t{.binding=binding};
+    if(p.nativeUber) {
+      const auto name="tex"+std::to_string(binding/2);
+      if(glGetUniformLocation(p.gl.program,name.c_str())<0) continue;
+      t.textures={binding/2};t.samplers={binding/2};
+    }
+    else {t.textures=units(2,binding,false);t.samplers=units(2,binding+1,true);}
+    if(!t.textures.empty()) p.textures.push_back(std::move(t));
+  }
+  return &sPrepared.emplace(ref,std::move(p)).first->second;
+}
+
+void bind_draw_resources(const gx::DrawData& d,PreparedPipeline& p) {
+  flip_profile::Scope resourcesProfile("gl_resources");
+  using namespace dawn::native::opengl;
+  auto& res=resources();
+  const uint32_t window=d.uniformRange.offset/gx::FlipUniformWindow;
+  {
+  flip_profile::Scope profile("gl_uniform_bind");
+  if(window<res.flipUniformBuffers.size()) {
+    const GLuint buffer=sMappedUniforms?sMappedUniforms->uniforms:sStream.current?sStream.current->uniforms.name:GetDirectGLBuffer(res.flipUniformBuffers[window].Get());
+    const uint32_t offset=(sMappedUniforms||sStream.current)?window*gx::FlipUniformWindow:0;
+    const GLuint binding=p.uniformBinding;
+    if(!cache_enabled()||sLastUniform!=buffer||sLastUniformBinding!=binding||sLastUniformOffset!=offset) {
+      glBindBufferRange(GL_UNIFORM_BUFFER,binding,buffer,offset,gx::FlipUniformWindow); ++sGlCalls.ubos;
+      sLastUniform=buffer;sLastUniformBinding=binding;sLastUniformOffset=offset;
+    }
+    static const bool mappedCheck=[] {const char* v=std::getenv("MELEE_FLIP_MAPPED_CHECK");return v&&v[0]=='1';}();
+    if(mappedCheck&&sMapped) {
+      // Diagnostic: is the record this draw will read actually present in mapped memory?
+      const uint32_t record=(d.uniformRange.offset%gx::FlipUniformWindow)/gx::FlipUniformStride;
+      const uint8_t* rec=sMapped->uniformData+d.uniformRange.offset;
+      uint32_t nonzero=0; for(unsigned i=0;i<64;i+=4){uint32_t w;std::memcpy(&w,rec+i,4);nonzero|=w;}
+      static uint32_t zeroRecords=0,records=0,maxOffset=0; ++records; if(!nonzero) ++zeroRecords; maxOffset=std::max<uint32_t>(maxOffset,d.uniformRange.offset);
+      if(sFrameNumber%120==0&&records) {std::fprintf(stderr,"[flip-mapped-check] records=%u zero=%u max_offset=%u window=%u record=%u resident=%u\n",records,zeroRecords,maxOffset,window,record,d.resident);}
+      if(sFrameNumber%120==1) {records=zeroRecords=maxOffset=0;}
+    }
+  }
+  }
+  {
+  flip_profile::Scope profile("gl_texture_bind");
+  const auto staticGroup=res.staticBindGroup.Get();
+  if(!p.storageUnits.empty()) {
+    const auto texture=GetDirectGLBindGroupTexture(staticGroup,1);
+    for(auto unit:p.storageUnits) bind_texture_unit(texture,unit);
+  }
+  if(d.bindGroups.textureBindGroup) {
+    const auto& resolved=resolve_textures(d.bindGroups.textureBindGroup,d.pipeline,p);
+    for(size_t i=0;i<p.textures.size();++i) {
+      const auto& t=p.textures[i];
+      const auto& texture=resolved.entries[i].texture;
+      const GLuint sampler=resolved.entries[i].sampler;
+      for(auto unit:t.textures) bind_texture_unit(texture,unit);
+      if(texture_sampler_state_enabled()&&texture.texture) {
+        // Texture unit for this binding is active after bind_texture_unit; the
+        // texture object now carries the sampler state and unit samplers are 0.
+        for(auto unit:t.textures) {
+          if(sActiveUnit!=unit) {glActiveTexture(GL_TEXTURE0+unit);sActiveUnit=unit;}
+          apply_sampler_to_texture(texture.target,texture.texture,sampler);
+        }
+        for(auto unit:t.samplers) {
+          if(!cache_enabled()||unit>=sTextureState.size()||sTextureState[unit].sampler!=0) {
+            glBindSampler(unit,0); ++sGlCalls.samplers;
+            if(unit<sTextureState.size()) sTextureState[unit].sampler=0;
+          }
+        }
+      } else for(auto unit:t.samplers) {
+        if(!cache_enabled()||unit>=sTextureState.size()||sTextureState[unit].sampler!=sampler) {
+          glBindSampler(unit,sampler); ++sGlCalls.samplers;
+          if(unit<sTextureState.size()) sTextureState[unit].sampler=sampler;
+        }
+      }
+    }
+  }
+  }
+  {
+  flip_profile::Scope profile("gl_vertex_bind");
+  const auto& layout=p.layout;
+  GLuint vertex; uint32_t vertexOffset;
+  const GLuint frameVertex=sMappedVertices?sMappedVertices->vertices:sStream.current?sStream.current->vertices.name:GetDirectGLBuffer(res.vertexBuffer.Get());
+  if(d.resident) { vertex=resident_gl_buffer(gx::resident_arena(d)); vertexOffset=0; }
+  else { vertex=frameVertex; vertexOffset=d.vertRange.offset; }
+  uint32_t used=0;
+  for(unsigned a=0;a<layout.count;++a) used|=1u<<layout.attributes[a].shaderLocation;
+  const bool recordSlot=(p.config.shaderConfig.flipFlags&gx::FlipBatchedDraws)&&p.config.shaderConfig.lineMode==0;
+  if(recordSlot) used|=(1u<<15)|(1u<<16); // distinct from line layouts that use location 15 in slot 0
+  if(!cache_enabled()||sLastVertexBuffer!=vertex||sLastVertexOffset!=vertexOffset||sLastVertexStride!=layout.stride) {
+    glBindVertexBuffer(0,vertex,vertexOffset,layout.stride); ++sGlCalls.vbos;
+    sLastVertexBuffer=vertex;sLastVertexOffset=vertexOffset;sLastVertexStride=layout.stride;
+  }
+  if(recordSlot) {
+    // Slot 1: per-vertex uniform records for merged resident draws, else zeros.
+    GLuint recordBuffer; uint32_t recordOffset;
+    if(gx::resident_per_vertex(d)) { recordBuffer=frameVertex; recordOffset=d.immediateData.vtxStart; }
+    else { recordBuffer=zero_records_gl_buffer(); recordOffset=0; }
+    if(!cache_enabled()||sLastRecordBuffer!=recordBuffer||sLastRecordOffset!=recordOffset) {
+      glBindVertexBuffer(1,recordBuffer,recordOffset,4); ++sGlCalls.vbos;
+      sLastRecordBuffer=recordBuffer;sLastRecordOffset=recordOffset;
+    }
+  }
+  if(!cache_enabled()||sLastLayout!=used) {
+  for(unsigned a=0;a<layout.count;++a) {
+    const auto& attr=layout.attributes[a];
+    const GLuint loc=attr.shaderLocation;
+    if(loc==0) glVertexAttribIFormat(loc,3,GL_UNSIGNED_INT,attr.offset);
+    else {
+      const GLint count=loc==3||loc==4||loc==15?4:loc>=5&&loc<=12?2:3;
+      glVertexAttribFormat(loc,count,GL_FLOAT,GL_FALSE,attr.offset);
+    }
+    glVertexAttribBinding(loc,0);
+    glEnableVertexAttribArray(loc);
+  }
+  if(recordSlot) {
+    glVertexAttribIFormat(15,1,GL_UNSIGNED_INT,0);
+    glVertexAttribBinding(15,1);
+    glEnableVertexAttribArray(15);
+  }
+  for(unsigned loc=0;loc<16;++loc) if((sEnabledAttributes&(1u<<loc))&&!(used&(1u<<loc)))
+    glDisableVertexAttribArray(loc);
+  sEnabledAttributes=used;
+  sLastLayout=used; ++sGlCalls.layouts;
+  }
+  }
+
+  flip_profile::Scope immediateProfile("gl_immediates");
+  if(p.immediates>=0) {
+    // Batched shaders only read _pad (record base): streamed draws pass 0, resident
+    // draws pass their record. glUniform1uiv costs ~0.4 us here, a UBO rebind ~5 us.
+    const uint32_t record=(d.uniformRange.offset%gx::FlipUniformWindow)/gx::FlipUniformStride;
+    const bool batched=(p.config.shaderConfig.flipFlags&gx::FlipBatchedDraws)!=0;
+    const uint32_t pad=(!batched||(d.resident&&!gx::resident_per_vertex(d)))?record:0;
+    if(p.immediatesUnused) {
+      if(p.lastImmediatePad!=pad) {
+        auto immediate=d.immediateData; immediate._pad=pad;
+        glUniform1uiv(p.immediates,sizeof(immediate)/sizeof(uint32_t),reinterpret_cast<const GLuint*>(&immediate)); ++sGlCalls.immediates;
+        p.lastImmediatePad=pad;
+      }
+    } else {
+      auto immediate=d.immediateData; immediate._pad=pad;
+      glUniform1uiv(p.immediates,sizeof(immediate)/sizeof(uint32_t),reinterpret_cast<const GLuint*>(&immediate)); ++sGlCalls.immediates;
+      p.lastImmediatePad=pad;
+    }
+  }
+}
+
+bool render_draw(const gx::DrawData& d,int mode,uint32_t passIndex,uint32_t drawIndex) {
+  static const bool trace=[] {const char* v=std::getenv("MELEE_FLIP_DRAW_TRACE");return v&&v[0]=='1';}();
+  if(trace&&sFrameNumber==600) {
+    uint64_t uniformHash=0; const uint8_t* rec=nullptr;
+    if(sMapped) rec=sMapped->uniformData+d.uniformRange.offset;
+    if(rec) { for(unsigned i=0;i<256;i+=8){uint64_t w;std::memcpy(&w,rec+i,8);uniformHash=uniformHash*1099511628211ull^w;} }
+    std::fprintf(stderr,"[flip-draw-trace] pass=%u draw=%u pipeline=%llx res=%u vtx=%u idx=%u idxoff=%u vert=%u uni=%u tex=%llx ufp=%llx dst=%x\n",
+      passIndex,drawIndex,(unsigned long long)d.pipeline,d.resident,d.vtxCount,d.indexCount,d.idxRange.offset,d.vertRange.offset,
+      d.uniformRange.offset,(unsigned long long)d.bindGroups.textureBindGroup,(unsigned long long)uniformHash,d.dstAlpha);
+  }
+  if(flip_profile::enabled()) flip_profile::state.tag=(uint64_t(passIndex)<<32)|drawIndex;
+  flip_profile::Scope drawProfile("gl_draw_total");
+  auto* prepared=prepare_pipeline(d.pipeline);
+  if(!prepared) {
+    std::fprintf(stderr,"[flip-direct-error] frame=%llu pass=%u draw=%u section=pipeline-lookup\n",
+                 static_cast<unsigned long long>(sFrameNumber),passIndex,drawIndex);
+    return false;
+  }
+  const auto& native=prepared->gl;
+  if(flip_profile::active()) {
+    const auto& c=prepared->config.shaderConfig;
+    char text[512];
+    std::snprintf(text,sizeof(text),"tag=%llu pipeline=%llu program=%u vertices=%u indices=%u vertex_stride=%u tev=%u texture_group=%llu window=%u program_change=%u pipeline_change=%u",
+      (unsigned long long)flip_profile::state.tag,(unsigned long long)d.pipeline,native.program,d.vtxCount,d.indexCount,
+      prepared->layout.stride,c.tevStageCount,(unsigned long long)d.bindGroups.textureBindGroup,
+      d.uniformRange.offset/gx::FlipUniformWindow,sLastProgram!=native.program,sLastPipeline!=d.pipeline);
+    flip_profile::state.patterns.emplace_back(text);
+  }
+  {
+  flip_profile::Scope profile("gl_pipeline_state");
+  if(!cache_enabled()||sLastProgram!=native.program) {glUseProgram(native.program);sLastProgram=native.program;++sGlCalls.programs;}
+  if(!cache_enabled()||sLastPipeline!=d.pipeline) {apply_pipeline_state(prepared->config);sLastPipeline=d.pipeline;++sGlCalls.pipelineStates;}
+  }
+  if(!gl_ok("pipeline-state",passIndex,drawIndex)||mode<4) return true;
+  bind_draw_resources(d,*prepared);
+  if(!gl_ok("resources",passIndex,drawIndex)||mode<5||drawIndex>=draw_limit()) return true;
+  {
+  flip_profile::Scope profile("gl_draw_call"); ++sGlCalls.draws;
+  const GLenum indexType=d.resident?GL_UNSIGNED_INT:GL_UNSIGNED_SHORT;
+  static const bool rangeElements=[] {const char* v=std::getenv("MELEE_FLIP_RANGE_ELEMENTS");return !v||std::strcmp(v,"0");}();
+  if(d.instanceCount==1) {
+    if(d.indexCount) {
+      if(rangeElements) {
+        // Explicit vertex range: the driver need not scan the index data.
+        GLuint start=0,end=d.vtxCount?d.vtxCount-1:0;
+        if(d.resident) {const uint32_t stride=prepared->layout.stride; start=d.vertRange.offset/stride; end=(d.vertRange.offset+d.vertRange.size)/stride; end=end?end-1:0;}
+        glDrawRangeElements(native.topology,start,end,d.indexCount,indexType,reinterpret_cast<const void*>(uintptr_t(d.idxRange.offset)));
+      } else glDrawElements(native.topology,d.indexCount,indexType,reinterpret_cast<const void*>(uintptr_t(d.idxRange.offset)));
+    }
+    else glDrawArrays(native.topology,0,d.vtxCount);
+  } else if(d.indexCount) glDrawElementsInstanced(native.topology,d.indexCount,indexType,
+      reinterpret_cast<const void*>(uintptr_t(d.idxRange.offset)),d.instanceCount);
+  else glDrawArraysInstanced(native.topology,0,d.vtxCount,d.instanceCount);
+  }
+  if(mode>=6) glMemoryBarrier(GL_TEXTURE_FETCH_BARRIER_BIT);
+  return gl_ok("draw",passIndex,drawIndex);
+}
+
+bool render_clear(const clear::DrawData& d,uint32_t width,uint32_t height,
+                  uint32_t passIndex,uint32_t drawIndex) {
+  clear::PipelineConfig config;
+  if(!clear::find_flip_pipeline_config(d.pipeline,config)) {
+    std::fprintf(stderr,"[flip-direct-error] frame=%llu pass=%u draw=%u section=clear-pipeline-lookup\n",
+                 static_cast<unsigned long long>(sFrameNumber),passIndex,drawIndex);
+    return false;
+  }
+  const GLuint program=clear_program();
+  if(!program) return false;
+  glUseProgram(program);
+  sLastProgram=Unknown;sLastPipeline=UINTPTR_MAX;sGLState=GLStateCache{};
+  glDisable(GL_CULL_FACE);
+  glEnable(GL_BLEND);
+  glBlendEquationSeparate(GL_FUNC_ADD,GL_FUNC_ADD);
+  glBlendFuncSeparate(GL_CONSTANT_COLOR,GL_ZERO,GL_CONSTANT_ALPHA,GL_ZERO);
+  glBlendColor(d.color.r,d.color.g,d.color.b,d.color.a);
+  glDisable(GL_STENCIL_TEST);
+  glDisable(GL_POLYGON_OFFSET_FILL);
+  glEnable(GL_DEPTH_TEST);
+  glDepthFunc(GL_ALWAYS);
+  glColorMask(config.clearColor,config.clearColor,config.clearColor,config.clearAlpha);
+  glDepthMask(config.clearDepth?GL_TRUE:GL_FALSE);
+  glViewport(0,0,width,height);
+  glDepthRangef(d.depth,d.depth);
+  glScissor(0,0,width,height);
+  glDrawArrays(GL_TRIANGLES,0,3);
+  return gl_ok("clear",passIndex,drawIndex);
+}
+
+bool render_pass(void*,uint32_t passIndex,const char* label) {
+  flip_profile::Scope profile("gl_pass",passIndex);
+  if(sNextPlan>=sPlans.size()) return false;
+  auto& plan=sPlans[sNextPlan];
+  if(!label||plan.label!=label) return false;
+  const auto target=dawn::native::opengl::GetDirectGLTextureView(plan.target.Get());
+  ++sNextPlan;
+  if(!plan.eligible) return false;
+  PassTimer timer;
+  const int mode=direct_mode();
+  while(glGetError()!=GL_NO_ERROR) {}
+  if(sFrameNumber<8)
+    std::fprintf(stderr,"[flip-direct] frame=%llu pass=%u mode=%d commands=%zu target=%u\n",
+                 static_cast<unsigned long long>(sFrameNumber),passIndex,mode,
+                 plan.commands.size(),target.texture?target.texture:target.renderbuffer);
+  if(mode>=2) {
+    if(!sVao) glGenVertexArrays(1,&sVao);
+    glBindVertexArray(sVao);
+    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER,sMappedIndices?sMappedIndices->indices:sStream.current?sStream.current->indices.name:
+        dawn::native::opengl::GetDirectGLBuffer(resources().indexBuffer.Get()));
+    sLastProgram=sLastUniform=sLastUniformBinding=sLastLayout=Unknown;
+    sLastUniformOffset=Unknown;
+    sLastPipeline=UINTPTR_MAX;sTextureState={};
+    sGLState=GLStateCache{};sActiveUnit=Unknown;
+    sLastVertexBuffer=Unknown;sLastVertexOffset=sLastVertexStride=UINT32_MAX;
+    sLastRecordBuffer=Unknown;sLastRecordOffset=UINT32_MAX;
+    for(auto& [ref,prepared]:sPrepared) prepared.lastImmediatePad=UINT32_MAX;
+    glEnable(GL_SCISSOR_TEST);
+    glDisable(GL_STENCIL_TEST);
+    gl_ok("pass-state",passIndex,0);
+  }
+  uint32_t drawIndex=0;
+  for(const auto& command:plan.commands) {
+    if(command.type==CommandType::SetViewport) {
+      if(mode<2) continue;
+      const auto& v=command.viewport;
+      glViewport(GLint(v.left),GLint(v.top),GLsizei(v.width),GLsizei(v.height));
+      const float nearDepth=gx::UseReversedZ?1.f-v.zfar:v.znear;
+      const float farDepth=gx::UseReversedZ?1.f-v.znear:v.zfar;
+      glDepthRangef(nearDepth,farDepth);
+    } else if(command.type==CommandType::SetScissor) {
+      if(mode<2) continue;
+      const auto& s=command.scissor;
+      const auto x=std::min(static_cast<uint32_t>(s.x),plan.width);
+      const auto y=std::min(static_cast<uint32_t>(s.y),plan.height);
+      glScissor(x,y,std::min(static_cast<uint32_t>(s.width),plan.width-x),
+                    std::min(static_cast<uint32_t>(s.height),plan.height-y));
+    } else if(command.type==CommandType::Draw) {
+      if(mode>=3) {
+        if(command.isClear) render_clear(command.clear,plan.width,plan.height,passIndex,drawIndex);
+        else render_draw(command.draw,mode,passIndex,drawIndex);
+      }
+      ++drawIndex;
+    }
+  }
+  gl_ok("pass-end",passIndex,drawIndex);
+  // Once an eligible pass is intercepted it must not also be replayed by Dawn,
+  // even if a diagnostic GL error occurred after some direct commands ran.
+  return true;
+}
+}
+
+bool encode_flip_gles_resources(const wgpu::RenderPassEncoder& encoder,RenderPass& pass,std::string_view label) {
+  pass.flipDirectLabel=label;
+  static const bool enabled=[] {const char* v=std::getenv("MELEE_FLIP_DIRECT_PACKET");return v&&std::strcmp(v,"0");}();
+  if(!enabled||direct_mode()<5||pass.msaaSamples!=1||pass.colorAttachmentCount!=1||
+     !gx::flip_vertex_enabled()||!gx::flip_uniform_windows_enabled()) return false;
+  std::unordered_set<PipelineRef> seenPipelines;
+  std::vector<wgpu::RenderPipeline> pipelines;
+  std::unordered_set<uint64_t> textures;
+  std::unordered_set<uint32_t> windows,arenas;
+  bool hasDraw=false;
+  // Decide for the whole immutable pass before recording anything. Failure
+  // preserves all reference commands, never a partially intercepted pass.
+  for(const auto& command:pass.commands) {
+    if(command.type==CommandType::CustomDraw) return false;
+    if(command.type!=CommandType::Draw) continue;
+    gx::DrawData d;clear::DrawData clear;
+    if(decode_flip_clear_draw(command.data.draw,clear)) continue;
+    if(!decode_flip_gx_draw(command.data.draw,d)) return false;
+    hasDraw=true;
+    if(seenPipelines.insert(d.pipeline).second) {
+      gx::PipelineConfig c;wgpu::RenderPipeline p;
+      if(!get_pipeline(d.pipeline,p)||!gx::find_flip_pipeline_config(d.pipeline,c)||
+         c.shaderConfig.fogRangeEnabled||!(c.shaderConfig.flipFlags&gx::FlipBatchedDraws)||
+         std::bit_cast<float>(c.polygonOffsetClampBits)!=0.f) return false;
+      pipelines.push_back(std::move(p));
+    }
+    if(d.bindGroups.textureBindGroup) textures.insert(d.bindGroups.textureBindGroup);
+    windows.insert(d.uniformRange.offset/gx::FlipUniformWindow);
+    if(d.resident) arenas.insert(gx::resident_arena(d));
+  }
+  if(!hasDraw) return false;
+  const auto& res=resources();
+  // The direct path issues the GL work itself. Dawn only needs enough recorded
+  // state to keep pass setup/teardown correct; pipelines, uniform windows and
+  // texture groups stay alive through the GX caches, so recording every one of
+  // them (hundreds per pass) is pure command-buffer and lazy-clear overhead.
+  static const bool minimalRecord=[] {const char* v=std::getenv("MELEE_FLIP_DIRECT_RECORD_MIN");return !v||std::strcmp(v,"0");}();
+  for(auto arena:arenas) encoder.SetVertexBuffer(0,gx::resident::buffer(arena));
+  encoder.SetVertexBuffer(0,res.vertexBuffer);
+  encoder.SetIndexBuffer(res.indexBuffer,wgpu::IndexFormat::Uint16);
+  encoder.SetBindGroup(0,res.staticBindGroup);
+  if(minimalRecord) {
+    if(!pipelines.empty()) encoder.SetPipeline(pipelines.front());
+    for(auto window:windows) flip_uniform_window(window); // ensure the window buffers exist
+  } else {
+    for(const auto& p:pipelines) encoder.SetPipeline(p);
+    const uint32_t zero=0;
+    for(auto window:windows) encoder.SetBindGroup(1,flip_uniform_window(window),1,&zero);
+    for(auto texture:textures) encoder.SetBindGroup(2,find_bind_group(texture));
+  }
+  pass.flipDirectResourcesOnly=true;
+  return true;
+}
+
+void prepare_flip_gles_frame(FramePacket& frame) {
+  sPlans.clear();sNextPlan=0;++sFrameNumber;
+  static const bool glCallsProfile=std::getenv("MELEE_FLIP_PROFILE")!=nullptr;
+  if(glCallsProfile) {
+    static GlCallStats sum; static unsigned frames=0;
+    sum.programs+=sGlCalls.programs; sum.pipelineStates+=sGlCalls.pipelineStates; sum.textures+=sGlCalls.textures; sum.texParams+=sGlCalls.texParams;
+    sum.samplers+=sGlCalls.samplers; sum.ubos+=sGlCalls.ubos; sum.vbos+=sGlCalls.vbos; sum.layouts+=sGlCalls.layouts; sum.immediates+=sGlCalls.immediates; sum.draws+=sGlCalls.draws;
+    if(++frames%120==0) {
+      std::fprintf(stderr,"[flip-gl-calls] per frame: draws=%.1f programs=%.1f pipeline-states=%.1f textures=%.1f tex-params=%.1f samplers=%.1f ubos=%.1f vbos=%.1f layouts=%.1f immediates=%.1f\n",
+        sum.draws/120.0,sum.programs/120.0,sum.pipelineStates/120.0,sum.textures/120.0,sum.texParams/120.0,sum.samplers/120.0,sum.ubos/120.0,sum.vbos/120.0,sum.layouts/120.0,sum.immediates/120.0);
+      sum={};
+    }
+  }
+  sGlCalls={};
+  // Texture-object parameter memos persist across passes and frames; forget
+  // entries whose GL names died so a recycled name starts clean.
+  GLuint dead[256];
+  while(uint32_t n=dawn::native::opengl::GetDirectGLDestroyedTextures(webgpu::g_device.Get(),dead,256)) {
+    for(uint32_t i=0;i<n;++i) {
+      sTextureParams.erase(dead[i]);
+      sTextureSamplers.erase(dead[i]);
+      for(auto& unit:sTextureState) if(unit.valid&&unit.texture.texture==dead[i]) unit.valid=false;
+    }
+    if(n<256) break;
+  }
+  static const bool bindDawn=[] {const char* v=std::getenv("MELEE_FLIP_MAPPED_BIND_DAWN");return v&&v[0]=='1';}();
+  sMapped=bindDawn?nullptr:flip_mapped_slot(frame);
+  // Bisect helpers: MELEE_FLIP_MAPPED_USE=uniforms|indices binds only that stream from mapped storage.
+  // Default: uniforms only. Index data read by the driver from persistently
+  // mapped storage produced stale draws on this Mali driver (see v89 trials).
+  // Default: both streams. Index data consumed from persistently mapped storage
+  // requires glDrawRangeElements (explicit vertex ranges) on this Mali driver;
+  // plain glDrawElements produced stale draws (v89 trials).
+  static const int mappedUse=[] {const char* v=std::getenv("MELEE_FLIP_MAPPED_USE");if(!v)return 7;if(!std::strcmp(v,"uniforms"))return 1;if(!std::strcmp(v,"indices"))return 2;if(!std::strcmp(v,"vertices"))return 4;if(!std::strcmp(v,"all"))return 7;return 7;}();
+  sMappedUniforms=sMapped&&(mappedUse&1)?sMapped:nullptr;
+  sMappedIndices=sMapped&&(mappedUse&2)?sMapped:nullptr;
+  sMappedVertices=sMapped&&(mappedUse&4)&&sMapped->vertexData?sMapped:nullptr;
+  if(!direct_mode()) return;
+  for(auto& pass:frame.renderPasses) {
+    if(!pass.sealed||pass.discardable||!pass.colorAttachmentCount) continue;
+    PassPlan plan{.target=pass.colorAttachments[0].view,
+                  .label=pass.flipDirectLabel,
+                  .width=pass.colorAttachments[0].size.width,
+                  .height=pass.colorAttachments[0].size.height,
+                  .eligible=pass.msaaSamples==1&&pass.colorAttachmentCount==1&&
+                            gx::flip_vertex_enabled()&&gx::flip_uniform_windows_enabled()};
+    bool hasGxDraw=false;
+    uint32_t gxDraws=0,clearDraws=0,otherDraws=0,customDraws=0;
+    for(const auto& command:pass.commands) {
+      PlanCommand out{.type=command.type};
+      if(command.type==CommandType::SetViewport) out.viewport=command.data.setViewport;
+      else if(command.type==CommandType::SetScissor) out.scissor=command.data.setScissor;
+      else if(command.type==CommandType::Draw) {
+        if(decode_flip_gx_draw(command.data.draw,out.draw)) {
+          hasGxDraw=true;++gxDraws;
+          gx::PipelineConfig config;
+          // These paths still need Dawn's packed immediate/depth-clamp ABI.
+          // Retain the complete reference pass when it is required.
+          if(!gx::find_flip_pipeline_config(out.draw.pipeline,config)||
+             config.shaderConfig.fogRangeEnabled||!(config.shaderConfig.flipFlags&gx::FlipBatchedDraws)||
+             std::bit_cast<float>(config.polygonOffsetClampBits)!=0.f) plan.eligible=false;
+          else out.sortable=config.depthCompare&&config.depthUpdate&&(config.depthFunc==GX_LESS||config.depthFunc==GX_LEQUAL)&&
+                            config.blendMode==GX_BM_NONE&&config.colorUpdate&&config.polygonOffsetBits==0;
+        }
+        else if(decode_flip_clear_draw(command.data.draw,out.clear)) {out.isClear=true;++clearDraws;}
+        else {plan.eligible=false;++otherDraws;}
+      } else if(command.type==CommandType::CustomDraw) {plan.eligible=false;++customDraws;}
+      plan.commands.push_back(out);
+    }
+    plan.eligible&=hasGxDraw;
+    // Experiment (MELEE_FLIP_SORT_OPAQUE=1): issue runs of consecutive opaque,
+    // depth-ordered draws grouped by program, textures and uniform window so
+    // the driver sees fewer state changes. Not exact when opaque surfaces share
+    // depth values, hence opt-in; the frozen EFB capture is the check.
+    static const bool sortOpaque=[] {const char* v=std::getenv("MELEE_FLIP_SORT_OPAQUE");return v&&std::strcmp(v,"0");}();
+    if(sortOpaque&&plan.eligible) {
+      static unsigned runs=0,sorted=0,frames=0;
+      auto& cmds=plan.commands;
+      size_t i=0;
+      while(i<cmds.size()) {
+        if(cmds[i].type!=CommandType::Draw||cmds[i].isClear||!cmds[i].sortable) {++i;continue;}
+        size_t j=i;
+        while(j<cmds.size()&&cmds[j].type==CommandType::Draw&&!cmds[j].isClear&&cmds[j].sortable) ++j;
+        if(j-i>1) {
+          std::stable_sort(cmds.begin()+i,cmds.begin()+j,[](const PlanCommand& a,const PlanCommand& b) {
+            if(a.draw.pipeline!=b.draw.pipeline) return a.draw.pipeline<b.draw.pipeline;
+            if(a.draw.bindGroups.textureBindGroup!=b.draw.bindGroups.textureBindGroup) return a.draw.bindGroups.textureBindGroup<b.draw.bindGroups.textureBindGroup;
+            return a.draw.uniformRange.offset/gx::FlipUniformWindow<b.draw.uniformRange.offset/gx::FlipUniformWindow;
+          });
+          ++runs; sorted+=static_cast<unsigned>(j-i);
+        }
+        i=j;
+      }
+      if(std::getenv("MELEE_FLIP_PROFILE")&&++frames%360==0) {
+        std::fprintf(stderr,"[flip-sort] per pass: runs=%.1f sorted-draws=%.1f\n",runs/360.0,sorted/360.0); runs=sorted=0;
+      }
+    }
+    AURORA_ASSERT(!pass.flipDirectResourcesOnly||plan.eligible,"Direct resource-only pass lost eligibility");
+    if((sFrameNumber%120)==0)
+      std::fprintf(stderr,"[flip-direct-plan] frame=%llu pass=%zu eligible=%u gx=%u clear=%u other=%u custom=%u commands=%zu\n",
+                   static_cast<unsigned long long>(sFrameNumber),sPlans.size(),plan.eligible,
+                   gxDraws,clearDraws,otherDraws,customDraws,plan.commands.size());
+    sPlans.push_back(std::move(plan));
+  }
+}
+
+void install_flip_gles_frame() {
+  if(direct_mode()) dawn::native::opengl::SetDirectGLRenderPassCallback(render_pass,nullptr);
+}
+void uninstall_flip_gles_frame() {
+  dawn::native::opengl::SetDirectGLRenderPassCallback(nullptr,nullptr);
+  if(sStream.pending) dawn::native::opengl::RunDirectGL(webgpu::g_device.Get(),[](void*) {sStream.finish();},nullptr);
+  flip_profile::end();
+}
+bool upload_flip_gles_stream(FramePacket& frame) {
+  sStream.current=nullptr;
+  static const bool enabled=[] {const char* v=std::getenv("MELEE_FLIP_STREAM_UPLOAD");return v&&!std::strcmp(v,"1");}();
+  if(!enabled||direct_mode()<5||!frame.encoderTasks.empty()) return false;
+  static const unsigned every=[] {const char* v=std::getenv("MELEE_FLIP_STREAM_EVERY");return v?std::max(1,std::atoi(v)):1;}();
+  if(frame.frameId%every) return false;
+  bool hasDraw=false;
+  // Only skip reference uploads if every consumer of shared geometry is a
+  // qualified resource-only GX pass. Never feed stale buffers to a fallback.
+  for(const auto& pass:frame.renderPasses) {
+    if(!pass.sealed||pass.discardable) continue;
+    for(const auto& command:pass.commands) {
+      if(command.type==CommandType::CustomDraw) return false;
+      if(command.type!=CommandType::Draw) continue;
+      clear::DrawData clear;
+      if(decode_flip_clear_draw(command.data.draw,clear)) continue;
+      gx::DrawData draw;
+      if(!decode_flip_gx_draw(command.data.draw,draw)||!pass.flipDirectResourcesOnly) return false;
+      hasDraw=true;
+    }
+  }
+  if(!hasDraw) return false;
+  struct Upload {FramePacket* frame;bool success=false;} upload{&frame};
+  const bool ran=dawn::native::opengl::RunDirectGL(webgpu::g_device.Get(),[](void* data) {
+    auto& upload=*static_cast<Upload*>(data);const auto& f=*upload.frame;
+    upload.success=sStream.upload(f.verts.data(),AURORA_ALIGN(f.verts.size(),4),
+                                  f.indices.data(),AURORA_ALIGN(f.indices.size(),4),
+                                  f.uniforms.data(),AURORA_ALIGN(f.uniforms.size(),4),profile_enabled());
+  },&upload);
+  return ran&&upload.success;
+}
+void shutdown_flip_gles() {
+  uninstall_flip_gles_frame();
+  if(!direct_mode()) return;
+  dawn::native::opengl::RunDirectGL(webgpu::g_device.Get(),[](void*) {
+    sStream.shutdown();
+    for(auto& pending:PassTimer::pending) glDeleteQueries(1,&pending.query);
+    PassTimer::pending.clear();PassTimer::get64=nullptr;PassTimer::initialized=false;
+    gx::shutdown_flip_gles_uber();
+    if(sVao) glDeleteVertexArrays(1,&sVao);
+    if(sClearProgram) glDeleteProgram(sClearProgram);
+    sVao=sClearProgram=sEnabledAttributes=0;
+  },nullptr);
+  sPrepared.clear();sPlans.clear();sNextPlan=0;sFrameNumber=0;sResolvedTextures.clear();sTextureParams.clear();sResidentGL.clear();sTextureSamplers.clear();
+}
+}
