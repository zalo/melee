diff --git a/lib/gfx/flip_profile.hpp b/lib/gfx/flip_profile.hpp
new file mode 100644
index 0000000..e75fb20
--- /dev/null
+++ b/lib/gfx/flip_profile.hpp
@@ -0,0 +1,77 @@
+#pragma once
+// Sampled, nested CPU timings. No GL query, fence, or GPU wait is introduced.
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <unordered_map>
+#include <string>
+#include <vector>
+#include <ctime>
+
+namespace aurora::gfx::detail::flip_profile {
+inline bool enabled() {
+#if MELEE_FLIP_DEEP_TIMERS
+  static const bool value=[] {const char* s=std::getenv("MELEE_FLIP_DEEP_PROFILE");return s&&!std::strcmp(s,"1");}();
+  return value;
+#else
+  return false;
+#endif
+}
+inline unsigned interval() {
+  static const unsigned value=[] {const char* s=std::getenv("MELEE_FLIP_DEEP_INTERVAL");return s?std::max(1,std::atoi(s)):120;}();
+  return value;
+}
+inline uint64_t cpu_now() {timespec t{};clock_gettime(CLOCK_THREAD_CPUTIME_ID,&t);return uint64_t(t.tv_sec)*1000000000+t.tv_nsec;}
+inline uint64_t wall_now() {return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();}
+inline bool cpu_enabled() {static const bool value=std::getenv("MELEE_FLIP_DEEP_CPU")!=nullptr;return value;}
+struct Totals {uint64_t calls=0,wall=0,cpu=0,selfWall=0,selfCpu=0,units=0;};
+struct Key {const char* name;uint64_t tag;bool operator==(const Key&) const=default;};
+struct KeyHash {size_t operator()(const Key& key) const {return (reinterpret_cast<uintptr_t>(key.name)>>3)^(key.tag*0x9e3779b97f4a7c15ULL);}};
+struct Scope;
+struct State {
+  bool active=false;uint64_t frame=0,tag=0;const char* lane="unknown";Scope* parent=nullptr;
+  std::unordered_map<Key,Totals,KeyHash> totals;
+  std::vector<std::string> patterns;
+};
+inline thread_local State state;
+inline std::atomic<uint64_t> fifoFrame{0};
+inline bool active() {return enabled()&&state.active;}
+inline void begin(uint64_t frame,const char* lane) {
+  if(!enabled()) return;
+  state.active=enabled()&&frame%interval()==0;
+  state.frame=frame;state.lane=lane;state.tag=0;state.parent=nullptr;
+  state.totals.clear();state.patterns.clear();
+  if(state.active) {state.totals.reserve(4096);state.patterns.reserve(512);}
+}
+struct Scope {
+  bool on;const char* name;uint64_t tag,units,wall,cpu,childWall,childCpu;Scope* parent;
+  __attribute__((always_inline)) Scope(const char* label,uint64_t key=UINT64_MAX,uint64_t count=0):on(active()) {
+    if(!on) return;
+    name=label;tag=key==UINT64_MAX?state.tag:key;units=count;childWall=childCpu=0;cpu=0;
+    parent=state.parent;state.parent=this;if(cpu_enabled()) cpu=cpu_now();wall=wall_now();
+  }
+  __attribute__((always_inline)) ~Scope() {if(on) finish();}
+  __attribute__((noinline)) void finish() {
+    const uint64_t elapsedWall=wall_now()-wall,elapsedCpu=cpu_enabled()?cpu_now()-cpu:0;
+    state.parent=parent;
+    if(parent) {parent->childWall+=elapsedWall;parent->childCpu+=elapsedCpu;}
+    auto& sum=state.totals[{name,tag}];++sum.calls;sum.wall+=elapsedWall;sum.cpu+=elapsedCpu;
+    sum.selfWall+=elapsedWall>childWall?elapsedWall-childWall:0;
+    sum.selfCpu+=elapsedCpu>childCpu?elapsedCpu-childCpu:0;sum.units+=units;
+  }
+};
+inline void end() {
+  if(!enabled()) return;
+  if(!state.active) return;
+  state.active=false;
+  for(const auto& [key,s]:state.totals)
+    std::fprintf(stderr,"[flip-deep] frame=%llu lane=%s zone=%s tag=%llu calls=%llu wall_us=%.3f cpu_us=%.3f self_wall_us=%.3f self_cpu_us=%.3f units=%llu cpu_measured=%u\n",
+      (unsigned long long)state.frame,state.lane,key.name,(unsigned long long)key.tag,
+      (unsigned long long)s.calls,s.wall/1000.,s.cpu/1000.,s.selfWall/1000.,s.selfCpu/1000.,(unsigned long long)s.units,cpu_enabled());
+  for(const auto& pattern:state.patterns)
+    std::fprintf(stderr,"[flip-pattern] frame=%llu lane=%s %s\n",(unsigned long long)state.frame,state.lane,pattern.c_str());
+}
+}
diff --git a/lib/gfx/flip_stream.hpp b/lib/gfx/flip_stream.hpp
new file mode 100644
index 0000000..fbf1a7c
--- /dev/null
+++ b/lib/gfx/flip_stream.hpp
@@ -0,0 +1,121 @@
+#pragma once
+// Native GLES upload ownership. Each slot is immutable to the CPU from submit
+// until its completion fence signals; persistent mapping alone is not a lock.
+#include <GLES3/gl31.h>
+#include <EGL/egl.h>
+#include <array>
+#include <bit>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include "flip_upload.hpp"
+
+namespace aurora::gfx::detail {
+struct FlipStream {
+  using StorageProc=void(GL_APIENTRY*)(GLenum,GLsizeiptr,const void*,GLbitfield);
+  struct Buffer { GLuint name=0; void* mapped=nullptr; size_t capacity=0; std::vector<uint8_t> shadow; };
+  struct Slot { Buffer vertices,indices,uniforms; GLsync done=nullptr; };
+  std::array<Slot,3> slots{};
+  unsigned next=0;
+  Slot* current=nullptr;
+  StorageProc storage=nullptr;
+  bool initialized=false,disabled=false,pending=false;
+  uint64_t uploads=0;
+
+  static bool wait(Slot& slot) {
+    if(!slot.done) return true;
+    GLenum status;
+    do { status=glClientWaitSync(slot.done,GL_SYNC_FLUSH_COMMANDS_BIT,1000000000); }
+    while(status==GL_TIMEOUT_EXPIRED);
+    if(status==GL_WAIT_FAILED) return false;
+    glDeleteSync(slot.done);slot.done=nullptr;return true;
+  }
+  static void destroy(Buffer& buffer) {
+    if(buffer.name) {
+      glBindBuffer(GL_COPY_WRITE_BUFFER,buffer.name);
+      if(buffer.mapped) glUnmapBuffer(GL_COPY_WRITE_BUFFER);
+      glDeleteBuffers(1,&buffer.name);
+    }
+    buffer={};
+  }
+  bool reserve(Buffer& buffer,size_t bytes) {
+    if(buffer.capacity>=bytes) return true;
+    destroy(buffer);
+    buffer.capacity=std::bit_ceil(std::max<size_t>(65536,bytes));
+    glGenBuffers(1,&buffer.name);
+    glBindBuffer(GL_COPY_WRITE_BUFFER,buffer.name);
+    constexpr GLbitfield flags=GL_MAP_WRITE_BIT|0x0040|0x0080; // persistent + coherent
+    storage(GL_COPY_WRITE_BUFFER,buffer.capacity,nullptr,flags);
+    if(glGetError()!=GL_NO_ERROR) {destroy(buffer);return false;}
+    buffer.mapped=glMapBufferRange(GL_COPY_WRITE_BUFFER,0,buffer.capacity,flags);
+    if(!buffer.mapped||glGetError()!=GL_NO_ERROR) {destroy(buffer);return false;}
+    // A partially used final uniform window must still have defined contents.
+    std::memset(buffer.mapped,0,buffer.capacity);
+    return true;
+  }
+  bool upload(const void* vertices,size_t vertexBytes,const void* indices,size_t indexBytes,
+              const void* uniforms,size_t uniformBytes,bool profile) {
+    current=nullptr;
+    if(disabled) return false;
+    if(!initialized) {
+      initialized=true;
+      const char* extensions=reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS));
+      if(extensions&&std::strstr(extensions,"GL_EXT_buffer_storage"))
+        storage=reinterpret_cast<StorageProc>(eglGetProcAddress("glBufferStorageEXT"));
+      if(!storage) {disabled=true;return false;}
+    }
+    auto& slot=slots[next];
+    const auto start=std::chrono::steady_clock::now();
+    if(!wait(slot)) {
+      // No CPU overwrite is safe after a failed fence wait.
+      std::fprintf(stderr,"[flip-stream-error] completion fence failed\n");
+      std::abort();
+    }
+    const auto waited=std::chrono::steady_clock::now();
+    if(!reserve(slot.vertices,vertexBytes)||!reserve(slot.indices,indexBytes)||
+       !reserve(slot.uniforms,(uniformBytes+65535)&~size_t(65535))) {
+      disabled=true;
+      while(glGetError()!=GL_NO_ERROR) {}
+      std::fprintf(stderr,"[flip-stream] persistent allocation unavailable; retaining reference uploads\n");
+      return false;
+    }
+    size_t written=0;
+    static const bool dirty=[] {const char* v=std::getenv("MELEE_FLIP_STREAM_DIRTY");return !v||std::strcmp(v,"0");}();
+    const auto copy=[&](Buffer& buffer,const void* data,size_t bytes,size_t chunk) {
+      if(!bytes) return;
+      if(!dirty) {std::memcpy(buffer.mapped,data,bytes);written+=bytes;return;}
+      flip_upload_changed(buffer.shadow,{static_cast<const uint8_t*>(data),bytes},chunk,
+        [&](size_t offset,size_t length) {
+          std::memcpy(static_cast<uint8_t*>(buffer.mapped)+offset,static_cast<const uint8_t*>(data)+offset,length);
+          written+=length;
+        });
+    };
+    copy(slot.vertices,vertices,vertexBytes,4096);
+    copy(slot.indices,indices,indexBytes,4096);
+    copy(slot.uniforms,uniforms,uniformBytes,256);
+    current=&slot;pending=true;next=(next+1)%slots.size();
+    if(profile&&++uploads%120==0) {
+      const auto end=std::chrono::steady_clock::now();
