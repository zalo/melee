+// Format key derived from the raw GX state that decodes a display list: vertex
+// descriptors and attribute formats for the list's vertex format, the source
+// arrays (identity, stride, endianness) of indexed attributes, and the matrix
+// slot baked into rigid geometry. Cheaper than populating a full pipeline config.
+uint64_t resident_format_hash(GXVtxFmt fmt) {
+  const auto& state = g_gxState;
+  struct Key {
+    std::array<u8, MaxVtxAttr> desc;
+    std::array<VtxAttrFmt, MaxVtxAttr> attrs;
+    std::array<const void*, MaxVtxAttr> arrays;
+    std::array<u8, MaxVtxAttr> strides;
+    std::array<u8, MaxVtxAttr> little;
+    u32 pnMtx; u8 fmt;
+  } key{};
+  for (unsigned ai = 0; ai < MaxVtxAttr; ++ai) key.desc[ai] = static_cast<u8>(state.vtxDesc[ai]);
+  key.attrs = state.vtxFmts[fmt].attrs;
+  for (unsigned ai = GX_VA_POS; ai <= GX_VA_TEX7; ++ai) {
+    const bool indexed = state.vtxDesc[ai] == GX_INDEX8 || state.vtxDesc[ai] == GX_INDEX16;
+    key.arrays[ai] = indexed ? state.arrays[ai].data : nullptr;
+    key.strides[ai] = indexed ? state.arrays[ai].stride : 0;
+    key.little[ai] = indexed ? state.arrays[ai].le : 0;
+  }
+  key.pnMtx = state.currentPnMtx;
+  key.fmt = static_cast<u8>(fmt);
+  return XXH3_64bits(&key, sizeof(key));
