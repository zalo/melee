+}
+
+void shutdown_flip_gles_uber() noexcept {
+  for(auto& [state,program]:sSpecializedPrograms) if(program) glDeleteProgram(program);
+  sSpecializedPrograms.clear();
+  for(auto& program:sPrograms)if(program){glDeleteProgram(program);program=0;}
