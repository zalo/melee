+  const GLuint block=glGetUniformBlockIndex(p,"GXBlock");GLint blockBytes=0;
+  if(block!=GL_INVALID_INDEX)glGetActiveUniformBlockiv(p,block,GL_UNIFORM_BLOCK_DATA_SIZE,&blockBytes);
