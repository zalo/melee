+// HSD builds a fresh GXTexObj on the stack for every material every frame, so a
+// counter identity never repeats and every load re-hashes the whole image. Derive
+// the identity from the image description instead; the texture cache still
+// verifies content on reuse, so a stale or colliding identity only costs a miss.
+bool stable_identities() {
+  static const bool enabled = [] { const char* v = std::getenv("MELEE_FLIP_STABLE_TEXID"); return !v || std::strcmp(v, "0"); }();
+  return enabled;
+}
+u32 stable_tex_obj_id(const GXTexObj_& obj) {
+  // mode0 carries wrap/filter/bias: the bound-texture cache keeps the object
+  // descriptor, so sampler-relevant state must be part of the identity too.
+  struct Key { u64 data; u32 width, height, format, lod, flags, mode0, tlut; } key{
+      reinterpret_cast<u64>(obj.data), obj.mWidth, obj.mHeight, obj.mFormat, obj.mode1 & 0xFFFFu, obj.flags & 3u,
+      obj.mode0 & 0x00FFFFFFu, static_cast<u32>(obj.tlut)};
+  const u64 hash = XXH3_64bits(&key, sizeof(key));
+  const u32 id = static_cast<u32>(hash ^ (hash >> 32));
+  return id ? id : 1u;
+}
+u32 stable_tlut_obj_id(const GXTlutObj_& obj) {
+  struct Key { u64 data; u32 format, entries; } key{reinterpret_cast<u64>(obj.data), static_cast<u32>(obj.format), obj.numEntries};
+  const u64 hash = XXH3_64bits(&key, sizeof(key));
+  const u32 id = static_cast<u32>(hash ^ (hash >> 32));
+  return id ? id : 1u;
+}
