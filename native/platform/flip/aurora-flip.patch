diff --git a/lib/gfx/flip_stream.hpp b/lib/gfx/flip_stream.hpp
new file mode 100644
index 0000000..fbf1a7c
--- /dev/null
+++ b/lib/gfx/flip_stream.hpp
@@ -0,0 +1,121 @@
+#pragma once
+// Native GLES upload ownership. Each slot is immutable to the CPU from submit
+// until its completion fence signals; persistent mapping alone is not a lock.
+#include <GLES3/gl31.h>
+#include <EGL/egl.h>
+#include <array>
+#include <bit>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include "flip_upload.hpp"
+
+namespace aurora::gfx::detail {
+struct FlipStream {
+  using StorageProc=void(GL_APIENTRY*)(GLenum,GLsizeiptr,const void*,GLbitfield);
+  struct Buffer { GLuint name=0; void* mapped=nullptr; size_t capacity=0; std::vector<uint8_t> shadow; };
+  struct Slot { Buffer vertices,indices,uniforms; GLsync done=nullptr; };
+  std::array<Slot,3> slots{};
+  unsigned next=0;
+  Slot* current=nullptr;
+  StorageProc storage=nullptr;
+  bool initialized=false,disabled=false,pending=false;
+  uint64_t uploads=0;
+
+  static bool wait(Slot& slot) {
+    if(!slot.done) return true;
+    GLenum status;
+    do { status=glClientWaitSync(slot.done,GL_SYNC_FLUSH_COMMANDS_BIT,1000000000); }
+    while(status==GL_TIMEOUT_EXPIRED);
+    if(status==GL_WAIT_FAILED) return false;
+    glDeleteSync(slot.done);slot.done=nullptr;return true;
+  }
+  static void destroy(Buffer& buffer) {
+    if(buffer.name) {
+      glBindBuffer(GL_COPY_WRITE_BUFFER,buffer.name);
+      if(buffer.mapped) glUnmapBuffer(GL_COPY_WRITE_BUFFER);
+      glDeleteBuffers(1,&buffer.name);
+    }
+    buffer={};
+  }
+  bool reserve(Buffer& buffer,size_t bytes) {
+    if(buffer.capacity>=bytes) return true;
+    destroy(buffer);
+    buffer.capacity=std::bit_ceil(std::max<size_t>(65536,bytes));
+    glGenBuffers(1,&buffer.name);
+    glBindBuffer(GL_COPY_WRITE_BUFFER,buffer.name);
+    constexpr GLbitfield flags=GL_MAP_WRITE_BIT|0x0040|0x0080; // persistent + coherent
+    storage(GL_COPY_WRITE_BUFFER,buffer.capacity,nullptr,flags);
+    if(glGetError()!=GL_NO_ERROR) {destroy(buffer);return false;}
+    buffer.mapped=glMapBufferRange(GL_COPY_WRITE_BUFFER,0,buffer.capacity,flags);
+    if(!buffer.mapped||glGetError()!=GL_NO_ERROR) {destroy(buffer);return false;}
+    // A partially used final uniform window must still have defined contents.
+    std::memset(buffer.mapped,0,buffer.capacity);
+    return true;
+  }
+  bool upload(const void* vertices,size_t vertexBytes,const void* indices,size_t indexBytes,
+              const void* uniforms,size_t uniformBytes,bool profile) {
+    current=nullptr;
+    if(disabled) return false;
+    if(!initialized) {
+      initialized=true;
+      const char* extensions=reinterpret_cast<const char*>(glGetString(GL_EXTENSIONS));
+      if(extensions&&std::strstr(extensions,"GL_EXT_buffer_storage"))
+        storage=reinterpret_cast<StorageProc>(eglGetProcAddress("glBufferStorageEXT"));
+      if(!storage) {disabled=true;return false;}
+    }
+    auto& slot=slots[next];
+    const auto start=std::chrono::steady_clock::now();
+    if(!wait(slot)) {
+      // No CPU overwrite is safe after a failed fence wait.
+      std::fprintf(stderr,"[flip-stream-error] completion fence failed\n");
+      std::abort();
+    }
+    const auto waited=std::chrono::steady_clock::now();
+    if(!reserve(slot.vertices,vertexBytes)||!reserve(slot.indices,indexBytes)||
+       !reserve(slot.uniforms,(uniformBytes+65535)&~size_t(65535))) {
+      disabled=true;
+      while(glGetError()!=GL_NO_ERROR) {}
+      std::fprintf(stderr,"[flip-stream] persistent allocation unavailable; retaining reference uploads\n");
+      return false;
+    }
+    size_t written=0;
+    static const bool dirty=[] {const char* v=std::getenv("MELEE_FLIP_STREAM_DIRTY");return !v||std::strcmp(v,"0");}();
+    const auto copy=[&](Buffer& buffer,const void* data,size_t bytes,size_t chunk) {
+      if(!bytes) return;
+      if(!dirty) {std::memcpy(buffer.mapped,data,bytes);written+=bytes;return;}
+      flip_upload_changed(buffer.shadow,{static_cast<const uint8_t*>(data),bytes},chunk,
+        [&](size_t offset,size_t length) {
+          std::memcpy(static_cast<uint8_t*>(buffer.mapped)+offset,static_cast<const uint8_t*>(data)+offset,length);
+          written+=length;
+        });
+    };
+    copy(slot.vertices,vertices,vertexBytes,4096);
+    copy(slot.indices,indices,indexBytes,4096);
+    copy(slot.uniforms,uniforms,uniformBytes,256);
+    current=&slot;pending=true;next=(next+1)%slots.size();
+    if(profile&&++uploads%120==0) {
+      const auto end=std::chrono::steady_clock::now();
+      std::fprintf(stderr,"[flip-stream] bytes=%zu written=%zu wait_ms=%.3f copy_ms=%.3f slots=3\n",
+        vertexBytes+indexBytes+uniformBytes,written,
+        std::chrono::duration<double,std::milli>(waited-start).count(),
+        std::chrono::duration<double,std::milli>(end-waited).count());
+    }
+    return true;
+  }
+  void finish() {
+    if(!pending) return;
+    current->done=glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE,0);
+    if(!current->done) {std::fprintf(stderr,"[flip-stream-error] cannot fence submitted storage\n");std::abort();}
+    pending=false;
+  }
+  void shutdown() {
+    for(auto& slot:slots) {
+      if(!wait(slot)) std::abort();
+      destroy(slot.vertices);destroy(slot.indices);destroy(slot.uniforms);
+    }
+    current=nullptr;pending=false;next=0;initialized=disabled=false;storage=nullptr;uploads=0;
+  }
+};
+}
diff --git a/lib/gfx/flip_upload.hpp b/lib/gfx/flip_upload.hpp
new file mode 100644
index 0000000..967c8a7
--- /dev/null
+++ b/lib/gfx/flip_upload.hpp
@@ -0,0 +1,35 @@
+#pragma once
+#include <algorithm>
+#include <cassert>
+#include <cstring>
+#include <span>
+#include <vector>
+#include <cstdint>
+
+namespace aurora::gfx::detail {
+// Shadow exactly the bytes already submitted to a persistent buffer. Keep its
+// tail when a later frame is shorter: partial GL updates preserve that tail.
+// Compare all input bytes, including mutable/aliased geometry and uniforms.
+template <typename Write>
+void flip_upload_changed(std::vector<uint8_t>& previous, std::span<const uint8_t> data,
+                         size_t chunk, Write&& write) {
+  assert(chunk && chunk % 4 == 0 && data.size() % 4 == 0);
+  if(data.empty()) return;
+  const size_t known=previous.size();
+  previous.resize(std::max(known,data.size()));
+  size_t begin=data.size();
+  const auto flush=[&](size_t end) {
+    if(begin==data.size()) return;
+    write(begin,end-begin);
+    std::memcpy(previous.data()+begin,data.data()+begin,end-begin);
+    begin=data.size();
+  };
+  for(size_t offset=0;offset<data.size();offset+=chunk) {
+    const size_t end=std::min(offset+chunk,data.size());
+    const bool changed=end>known||std::memcmp(previous.data()+offset,data.data()+offset,end-offset)!=0;
+    if(changed) { if(begin==data.size()) begin=offset; }
+    else flush(offset);
+  }
+  flush(data.size());
+}
+} // namespace aurora::gfx::detail
