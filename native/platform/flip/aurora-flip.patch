+static_assert(sizeof(FlipVertex) == 172);
+struct FlipVertexLayout {
+  std::array<wgpu::VertexAttribute, 16> attributes{};
+  std::array<size_t, 16> sources{};
+  unsigned count = 0, stride = 0;
