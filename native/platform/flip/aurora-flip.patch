+// ---------------------------------------------------------------------------
+// Specialized vertex loaders (Dolphin VertexLoaderManager-style). A loader is
+// built once per distinct GX attribute configuration and caches the decoded
+// layout plus one monomorphic conversion routine per attribute. Every byte of
+// the output record is written exactly once, so no memset is needed, and the
+// batching record word is written in place instead of patched afterwards.
+// ---------------------------------------------------------------------------
+struct FlipStep {
+  enum Kind : uint8_t { Numeric, Color, MatrixIndex };
+  using Fn = void (*)(const FlipStep&, const u8*, size_t, size_t, u8*, size_t, const u8*, size_t);
+  Fn fn = nullptr;
+  Kind kind = Numeric;
+  uint8_t ai = 0;          // GX attribute (array selector)
+  uint8_t indexBytes = 0;  // 0 = direct, 1 = INDEX8, 2 = INDEX16
+  uint8_t total = 0;       // components in the destination location
+  uint8_t srcOffset = 0;   // within the raw GX vertex
+  uint16_t dstOffset = 0;  // within the decoded vertex
+  uint32_t stride = 0;     // indexed array stride
+  uint32_t within = 0;     // byte offset inside the array record (NBT slices)
+  float scale = 1.f;       // 1 / 2^frac
+};
+struct FlipLoader {
+  FlipVertexLayout layout{};
+  std::vector<FlipStep> steps;
+  bool ok = false;                 // false: use flip_decode_packed_generic
+  bool hasMatrices = false;
+  uint16_t matrixOffset = 0;
+  uint8_t vtxStride = 0;
+};
+
+template <int IndexBytes, typename T, bool Little, int Comps>
+static void flip_step_numeric(const FlipStep& s, const u8* __restrict raw, size_t count, size_t vtxStride,
+                              u8* __restrict out, size_t outStride, const u8* base, size_t baseSize) {
+  static constexpr u8 zero[16]{};
+  constexpr size_t bytes = Comps * sizeof(T);
+  const size_t within = s.within, stride = s.stride;
+  const unsigned total = s.total;
+  const float scale = s.scale;
+  const u8* src = raw + s.srcOffset;
+  u8* dst = out + s.dstOffset;
+  for (size_t i = 0; i < count; ++i, src += vtxStride, dst += outStride) {
+    const u8* p;
+    if constexpr (IndexBytes == 0) {
+      p = src + within;
+    } else {
+      const size_t index = IndexBytes == 1 ? size_t(src[0]) : (size_t(src[0]) << 8) | src[1];
+      const size_t off = index * stride + within;
+      p = off + bytes <= baseSize ? base + off : zero;
+    }
+    float* d = reinterpret_cast<float*>(dst);
+#if defined(__aarch64__)
+    if constexpr (sizeof(T) == 2 && (Comps == 2 || Comps == 3)) {
+      uint32_t xy; std::memcpy(&xy, p, 4);
+      uint16x4_t h = vreinterpret_u16_u32(vdup_n_u32(xy));
+      if constexpr (Comps == 3) { uint16_t z; std::memcpy(&z, p + 4, 2); h = vset_lane_u16(z, h, 2); }
+      if constexpr (!Little) h = vreinterpret_u16_u8(vrev16_u8(vreinterpret_u8_u16(h)));
+      float32x4_t v;
+      if constexpr (std::is_signed_v<T>) v = vcvtq_f32_s32(vmovl_s16(vreinterpret_s16_u16(h)));
+      else v = vcvtq_f32_u32(vmovl_u16(h));
+      v = vmulq_n_f32(v, scale);
+      vst1_f32(d, vget_low_f32(v));
+      if constexpr (Comps == 3) vst1q_lane_f32(d + 2, v, 2);
+      else if (total > 2) d[2] = 0.f;
+      continue;
+    }
+#endif
+    for (int j = 0; j < Comps; ++j) {
+      if constexpr (sizeof(T) == 4) {
+        uint32_t bits; std::memcpy(&bits, p + j * 4, 4);
+        if constexpr (!Little) bits = __builtin_bswap32(bits);
+        d[j] = std::bit_cast<float>(bits);
+      } else if constexpr (sizeof(T) == 2) {
+        uint16_t bits; std::memcpy(&bits, p + j * 2, 2);
+        if constexpr (!Little) bits = __builtin_bswap16(bits);
+        d[j] = float(std::bit_cast<T>(bits)) * scale;
+      } else {
+        d[j] = float(std::bit_cast<T>(p[j])) * scale;
+      }
+    }
+    for (unsigned j = Comps; j < total; ++j) d[j] = 0.f;
+  }
+}
+
+template <int IndexBytes, int Fmt, bool Little>
+static void flip_step_color(const FlipStep& s, const u8* __restrict raw, size_t count, size_t vtxStride,
+                            u8* __restrict out, size_t outStride, const u8* base, size_t baseSize) {
+  static constexpr u8 zero[16]{};
+  constexpr size_t bytes = (Fmt == GX_RGB565 || Fmt == GX_RGBA4) ? 2 : (Fmt == GX_RGB8 || Fmt == GX_RGBA6) ? 3 : 4;
+  const size_t stride = s.stride;
+  const u8* src = raw + s.srcOffset;
+  u8* dst = out + s.dstOffset;
+  for (size_t i = 0; i < count; ++i, src += vtxStride, dst += outStride) {
+    const u8* p;
+    if constexpr (IndexBytes == 0) {
+      p = src;
+    } else {
+      const size_t index = IndexBytes == 1 ? size_t(src[0]) : (size_t(src[0]) << 8) | src[1];
+      const size_t off = index * stride;
+      p = off + bytes <= baseSize ? base + off : zero;
+    }
+    float* d = reinterpret_cast<float*>(dst);
+    if constexpr (Fmt == GX_RGB565 || Fmt == GX_RGBA4 || Fmt == GX_RGBA6) {
+      uint32_t v = 0;
+      for (unsigned k = 0; k < bytes; ++k) v |= uint32_t(p[k]) << ((Little ? k : bytes - k - 1) * 8);
+      if constexpr (Fmt == GX_RGB565) {
+        d[0] = float((v >> 11) & 31) / 31; d[1] = float((v >> 5) & 63) / 63; d[2] = float(v & 31) / 31; d[3] = 1;
+      } else {
+        constexpr unsigned bits = Fmt == GX_RGBA4 ? 4 : 6, mask = (1u << bits) - 1;
+        for (unsigned j = 0; j < 4; ++j) d[j] = float((v >> ((3 - j) * bits)) & mask) / mask;
+      }
+    } else {
+      d[0] = float(p[0]) / 255.f; d[1] = float(p[1]) / 255.f; d[2] = float(p[2]) / 255.f;
+      d[3] = Fmt == GX_RGBA8 ? float(p[3]) / 255.f : 1.f;
+    }
+  }
+}
+
+// Locations present in the layout without a source attribute (position is
+// always declared) read as zero, matching the reference decoder's memset.
+static void flip_step_zero(const FlipStep& s, const u8*, size_t count, size_t,
+                           u8* __restrict out, size_t outStride, const u8*, size_t) {
+  u8* dst = out + s.dstOffset;
+  const size_t bytes = s.within;
+  for (size_t i = 0; i < count; ++i, dst += outStride) std::memset(dst, 0, bytes);
+}
+
+static void flip_step_matrix_index(const FlipStep& s, const u8* __restrict raw, size_t count, size_t vtxStride,
+                                   u8* __restrict out, size_t outStride, const u8*, size_t) {
+  const u8* src = raw + s.srcOffset;
+  u8* dst = out + s.dstOffset;
+  if (s.ai == GX_VA_PNMTXIDX) {
+    for (size_t i = 0; i < count; ++i, src += vtxStride, dst += outStride) *dst = u8(*src / 3);
+  } else {
+    for (size_t i = 0; i < count; ++i, src += vtxStride, dst += outStride) *dst = *src;
+  }
+}
+
+template <int IndexBytes, typename T, bool Little>
+static FlipStep::Fn flip_numeric_fn_comps(unsigned comps) {
+  switch (comps) {
+  case 1: return &flip_step_numeric<IndexBytes, T, Little, 1>;
+  case 2: return &flip_step_numeric<IndexBytes, T, Little, 2>;
+  default: return &flip_step_numeric<IndexBytes, T, Little, 3>;
+  }
+}
+template <int IndexBytes, typename T>
+static FlipStep::Fn flip_numeric_fn_le(bool le, unsigned comps) {
+  return le ? flip_numeric_fn_comps<IndexBytes, T, true>(comps) : flip_numeric_fn_comps<IndexBytes, T, false>(comps);
+}
+template <int IndexBytes>
+static FlipStep::Fn flip_numeric_fn_type(unsigned compType, bool le, unsigned comps) {
+  switch (compType) {
+  case GX_F32: return flip_numeric_fn_le<IndexBytes, float>(le, comps);
+  case GX_U16: return flip_numeric_fn_le<IndexBytes, uint16_t>(le, comps);
+  case GX_S16: return flip_numeric_fn_le<IndexBytes, int16_t>(le, comps);
+  case GX_S8: return flip_numeric_fn_le<IndexBytes, int8_t>(le, comps);
+  default: return flip_numeric_fn_le<IndexBytes, uint8_t>(le, comps);
+  }
+}
+inline FlipStep::Fn flip_numeric_fn(unsigned indexBytes, unsigned compType, bool le, unsigned comps) {
+  switch (indexBytes) {
+  case 0: return flip_numeric_fn_type<0>(compType, le, comps);
+  case 1: return flip_numeric_fn_type<1>(compType, le, comps);
+  default: return flip_numeric_fn_type<2>(compType, le, comps);
+  }
+}
+template <int IndexBytes, bool Little>
+static FlipStep::Fn flip_color_fn_fmt(unsigned fmt) {
+  switch (fmt) {
+  case GX_RGB565: return &flip_step_color<IndexBytes, GX_RGB565, Little>;
+  case GX_RGB8: return &flip_step_color<IndexBytes, GX_RGB8, Little>;
+  case GX_RGBX8: return &flip_step_color<IndexBytes, GX_RGBX8, Little>;
+  case GX_RGBA4: return &flip_step_color<IndexBytes, GX_RGBA4, Little>;
+  case GX_RGBA6: return &flip_step_color<IndexBytes, GX_RGBA6, Little>;
+  default: return &flip_step_color<IndexBytes, GX_RGBA8, Little>;
+  }
+}
+template <int IndexBytes>
+static FlipStep::Fn flip_color_fn_le(unsigned fmt, bool le) {
+  return le ? flip_color_fn_fmt<IndexBytes, true>(fmt) : flip_color_fn_fmt<IndexBytes, false>(fmt);
+}
+inline FlipStep::Fn flip_color_fn(unsigned indexBytes, unsigned fmt, bool le) {
+  switch (indexBytes) {
+  case 0: return flip_color_fn_le<0>(fmt, le);
+  case 1: return flip_color_fn_le<1>(fmt, le);
+  default: return flip_color_fn_le<2>(fmt, le);
+  }
+}
+
+inline FlipLoader flip_build_loader(const ShaderConfig& c) {
+  FlipLoader L;
+  L.layout = flip_vertex_attributes(c);
+  L.vtxStride = c.vtxStride;
+  const auto destination_offset = [&](unsigned location) -> size_t {
+    for (unsigned i = 0; i < L.layout.count; ++i)
+      if (L.layout.attributes[i].shaderLocation == location) return L.layout.attributes[i].offset;
+    return SIZE_MAX;
+  };
+  const size_t matrixOffset = destination_offset(0);
+  L.hasMatrices = matrixOffset != SIZE_MAX;
+  L.matrixOffset = static_cast<uint16_t>(L.hasMatrices ? matrixOffset : 0);
+  // Lines/points keep the reference expansion path; the direct reference decoder
+  // also handles the (unused by GX) indexed matrix index forms.
+  if (c.lineMode) return L;
+  for (unsigned ai = GX_VA_PNMTXIDX; ai <= GX_VA_TEX7; ++ai) {
+    const auto& m = c.attrs[ai];
+    if (m.attrType == GX_NONE) continue;
+    const unsigned indexBytes = m.attrType == GX_DIRECT ? 0 : m.attrType == GX_INDEX8 ? 1 : 2;
+    const bool le = m.attrType != GX_DIRECT && m.le;
+    if (ai <= GX_VA_TEX7MTXIDX) {
+      if (indexBytes != 0) return L;
+      if (!L.hasMatrices) continue;
+      FlipStep s{};
+      s.fn = &flip_step_matrix_index; s.kind = FlipStep::MatrixIndex; s.ai = ai;
+      s.srcOffset = m.offset;
+      s.dstOffset = static_cast<uint16_t>(matrixOffset + (ai / 4) * 4 + (ai % 4));
+      L.steps.push_back(s);
+      continue;
+    }
+    const unsigned location = ai == GX_VA_POS ? 1 : ai == GX_VA_NRM ? 2 : ai == GX_VA_CLR0 ? 3 : ai == GX_VA_CLR1 ? 4 : 5 + ai - GX_VA_TEX0;
+    const size_t baseOffset = destination_offset(location);
+    if (baseOffset == SIZE_MAX) continue;
+    if (ai == GX_VA_CLR0 || ai == GX_VA_CLR1) {
+      FlipStep s{};
+      s.fn = flip_color_fn(indexBytes, m.compType, le); s.kind = FlipStep::Color; s.ai = ai;
+      s.indexBytes = indexBytes; s.srcOffset = m.offset; s.dstOffset = static_cast<uint16_t>(baseOffset);
+      s.stride = m.stride;
+      L.steps.push_back(s);
+      continue;
+    }
+    const unsigned componentBytes = m.compType == GX_F32 ? 4 : (m.compType == GX_U16 || m.compType == GX_S16) ? 2 : 1;
+    const unsigned comps = ai == GX_VA_NRM ? 3 : m.cnt;
+    if (comps == 0 || comps > 3) return L;
+    const unsigned slices = ai == GX_VA_NRM && m.cnt == 9 ? 3 : 1;
+    for (unsigned slice = 0; slice < slices; ++slice) {
+      const size_t sliceOffset = slice == 0 ? baseOffset : destination_offset(12 + slice);
+      if (sliceOffset == SIZE_MAX) continue;
+      FlipStep s{};
+      s.fn = flip_numeric_fn(indexBytes, m.compType, le, comps); s.kind = FlipStep::Numeric; s.ai = ai;
+      s.indexBytes = indexBytes;
+      s.total = ai == GX_VA_TEX0 || (ai > GX_VA_TEX0 && ai <= GX_VA_TEX7) ? 2 : 3;
+      s.srcOffset = static_cast<uint8_t>(m.offset + (m.nbt3 ? slice * indexBytes : 0));
+      s.dstOffset = static_cast<uint16_t>(sliceOffset);
+      s.stride = m.stride;
+      s.within = slice * 3 * componentBytes;
+      s.scale = 1.f / float(uint32_t(1) << m.frac);
+      L.steps.push_back(s);
+    }
+  }
+  for (unsigned i = 0; i < L.layout.count; ++i) {
+    const auto& attr = L.layout.attributes[i];
+    if (attr.shaderLocation == 0) continue;
+    bool written = false;
+    for (const auto& step : L.steps) written |= step.kind != FlipStep::MatrixIndex && step.dstOffset == attr.offset;
+    if (written) continue;
+    FlipStep s{};
+    s.fn = &flip_step_zero; s.kind = FlipStep::Numeric; s.dstOffset = static_cast<uint16_t>(attr.offset);
+    s.within = flip_attribute_bytes(attr.shaderLocation);
+    L.steps.push_back(s);
+  }
+  L.ok = true;
+  return L;
+}
+
+inline const FlipLoader& flip_loader(const ShaderConfig& c) {
+  struct Key { std::array<AttrConfig, MaxVtxAttr> attrs; u8 vtxStride, lineMode, flipFlags; };
+  static_assert(std::has_unique_object_representations_v<AttrConfig>);
+  Key key{c.attrs, c.vtxStride, c.lineMode, c.flipFlags};
+  const uint64_t hash = XXH3_64bits(&key, sizeof(key));
+  static uint64_t lastHash = 0;
+  static const FlipLoader* last = nullptr;
+  if (last && hash == lastHash) return *last;
+  static absl::flat_hash_map<uint64_t, std::unique_ptr<FlipLoader>> loaders;
+  auto it = loaders.find(hash);
+  if (it == loaders.end()) it = loaders.emplace(hash, std::make_unique<FlipLoader>(flip_build_loader(c))).first;
+  lastHash = hash; last = it->second.get();
+  return *last;
+}
+
+// Decode with a prepared loader. word2 carries the batching record/texture bank
+// bits of matrices[2]; every byte of out[0, count * stride) is written.
+inline void flip_decode_with(const FlipLoader& L, const u8* raw, size_t count, u8* out,
+                             const std::array<AttrArray, MaxVtxAttr>& arrays, u32 pnMtx, uint32_t word2) {
+  gfx::detail::flip_profile::Scope profile("vertex_decode",0,count);
+  const size_t stride = L.layout.stride;
+  if (L.hasMatrices) {
+    u8* dst = out + L.matrixOffset;
+    const uint32_t words[3] = {pnMtx, 0u, word2};
+    for (size_t i = 0; i < count; ++i, dst += stride) std::memcpy(dst, words, 12);
+  }
+  for (const auto& s : L.steps) {
+    const u8* base = nullptr; size_t size = 0;
+    if (s.indexBytes) {
+      const auto& array = arrays[s.ai];
+      if (array.data) { base = static_cast<const u8*>(array.data); size = array.size; }
+    }
+    s.fn(s, raw, count, L.vtxStride, out, stride, base, size);
+  }
+}
+
+inline void flip_decode_packed_into(const ShaderConfig& c, const FlipVertexLayout& layout,
+                               const u8* raw, size_t count, std::span<u8> out,
+                               const std::array<AttrArray, MaxVtxAttr>& arrays, u32 pnMtx) {
+  static const bool specialized = [] { const char* v = std::getenv("MELEE_FLIP_LOADERS"); return !v || std::strcmp(v, "0"); }();
+  const auto& L = flip_loader(c);
+  if (!specialized || !L.ok || L.layout.stride != layout.stride || L.layout.count != layout.count)
+    return flip_decode_packed_generic(c, layout, raw, count, out, arrays, pnMtx);
+  assert(out.size() == count * layout.stride);
+  flip_decode_with(L, raw, count, out.data(), arrays, pnMtx, 0);
+}
+
+inline void flip_decode_packed(const ShaderConfig& c,const FlipVertexLayout& layout,
+                               const u8* raw,size_t count,std::vector<u8>& out,
+                               const std::array<AttrArray,MaxVtxAttr>& arrays,u32 pnMtx) {
+  out.resize(count*layout.stride);
+  flip_decode_packed_into(c,layout,raw,count,out,arrays,pnMtx);
+}
+
+struct FlipVertexCache {
+  using Key = std::array<uint64_t, 2>;
+  absl::flat_hash_map<Key, std::vector<u8>> entries;
+  std::deque<Key> order;
+  size_t bytes = 0;
+  uint64_t hits = 0, misses = 0;
+  void store(const Key& key, const std::vector<u8>& data) {
+    constexpr size_t budget=16*1024*1024;
+    if(data.size()>budget) return;
+    while(!order.empty() && (entries.size()>=2048 || bytes+data.size()>budget)) {
+      auto old=entries.find(order.front());
+      if(old!=entries.end()){bytes-=old->second.size();entries.erase(old);}
+      order.pop_front();
+    }
+    if(entries.emplace(key,data).second){bytes+=data.size();order.push_back(key);}
+  }
+};
+inline FlipVertexCache& flip_vertex_cache() { static FlipVertexCache cache; return cache; }
+inline FlipVertexCache::Key flip_vertex_key(const ShaderConfig& c,const u8* raw,size_t bytes,
+  const std::array<AttrArray,MaxVtxAttr>& arrays,u32 pnMtx) {
+  std::array<uint64_t,96> signature{};
+  unsigned fields=0;
+  const auto hash=[&](const void* p,size_t n) {
+    const auto h=XXH3_128bits(p,n); signature[fields++]=h.low64; signature[fields++]=h.high64;
+  };
+  hash(c.attrs.data(),sizeof(c.attrs)); hash(raw,bytes);
+  signature[fields++]=c.lineMode;signature[fields++]=c.vtxStride;
+  // Universal and compact shaders can have identical GX input formats but
+  // different decoded layouts. Never share packed bytes across those layouts.
+  signature[fields++]=c.flipFlags;
+  signature[fields++]=c.attrs[GX_VA_PNMTXIDX].attrType==GX_NONE?pnMtx:0;
+  const size_t count=bytes/c.vtxStride;
+  for(unsigned ai=GX_VA_POS;ai<=GX_VA_TEX7;++ai) {
+    const auto& m=c.attrs[ai];
+    if(m.attrType!=GX_INDEX8 && m.attrType!=GX_INDEX16) continue;
+    const auto& array=arrays[ai];
+    const unsigned indexBytes=m.attrType==GX_INDEX8?1:2;
+    unsigned minimum=65535,maximum=0;
+    for(size_t i=0;i<count;++i) for(unsigned slice=0;slice<(m.nbt3?3u:1u);++slice) {
+      const auto* p=raw+i*c.vtxStride+m.offset+slice*indexBytes;
+      const unsigned index=indexBytes==1 ? p[0] : (unsigned(p[0])*256+p[1]);
+      minimum=std::min(minimum,index);maximum=std::max(maximum,index);
+    }
+    unsigned componentBytes=m.compType==GX_F32?4:(m.compType==GX_U16||m.compType==GX_S16)?2:1;
+    unsigned recordBytes=m.cnt*componentBytes;
+    if(ai==GX_VA_CLR0 || ai==GX_VA_CLR1)
+      recordBytes=(m.compType==GX_RGB565||m.compType==GX_RGBA4)?2:(m.compType==GX_RGB8||m.compType==GX_RGBA6)?3:4;
+    const uint64_t begin=uint64_t(minimum)*m.stride;
+    const uint64_t end=std::min<uint64_t>(uint64_t(maximum)*m.stride+recordBytes,array.size);
+    signature[fields++]=array.data?array.size:0;
+    const unsigned slices=m.nbt3?3:1;
+    const unsigned referencedBytes=m.nbt3?3*componentBytes:recordBytes;
+    if(array.data && count && end>begin) {
+      if(end-begin<=count*slices*referencedBytes*2) {
+        hash(static_cast<const u8*>(array.data)+begin,end-begin);
+      } else {
+        // Sparse display lists can reference opposite ends of a large model
+        // array. Gather only the records decoded by this draw before hashing.
+        // This remains content based, including mutable and aliased arrays.
+        static std::vector<u8> gathered;
+        gathered.resize(count*slices*referencedBytes);
+        for(size_t i=0;i<count;++i) for(unsigned slice=0;slice<slices;++slice) {
+          const auto* p=raw+i*c.vtxStride+m.offset+slice*indexBytes;
+          const unsigned index=indexBytes==1?p[0]:(unsigned(p[0])*256+p[1]);
+          const uint64_t offset=uint64_t(index)*m.stride+slice*3*componentBytes;
+          auto* dst=gathered.data()+(i*slices+slice)*referencedBytes;
+          if(offset+referencedBytes<=array.size)
+            std::memcpy(dst,static_cast<const u8*>(array.data)+offset,referencedBytes);
+          else std::memset(dst,0,referencedBytes);
+        }
+        hash(gathered.data(),gathered.size());
+      }
+    } else hash(nullptr,0);
+  }
+  const auto key=XXH3_128bits(signature.data(),fields*sizeof(uint64_t));
+  return {key.low64,key.high64};
+}
+
+inline gfx::Range flip_push_vertices(GXPrimitive prim, GXVtxFmt fmt, const u8* raw, size_t bytes, size_t alignment,
+                                     unsigned record = 0, const ShaderConfig* prepared = nullptr,
+                                     unsigned textureBank = 0) {
+  gfx::detail::flip_profile::Scope profile("vertex_prepare",0,bytes);
+  constexpr Module Log{"aurora::gx::flip"};
+  if (!flip_vertex_enabled())
+    return gfx::push_verts(raw, bytes, alignment);
+  PipelineConfig pipeline{};
+  if (!prepared) populate_pipeline_config(pipeline, prim, fmt);
+  const auto& c = prepared ? *prepared : pipeline.shaderConfig;
+  AURORA_ASSERT(c.vtxStride && bytes % c.vtxStride == 0, "Invalid GX vertex record size");
+  const size_t count = bytes / c.vtxStride;
+  // Hashing all referenced arrays costs more than decoding this game's small
+  // display lists. Keep the cache available for diagnostics, but opt into it.
+  static const bool useCache = [] { const char* s=std::getenv("MELEE_FLIP_VERTEX_CACHE");return s&&std::strcmp(s,"0"); }();
+  auto& cache=flip_vertex_cache();
+  static uint64_t calls=0;
+  if(++calls%60000==0 && std::getenv("MELEE_FLIP_PROFILE"))
+    std::fprintf(stderr,"[flip-vertex-cache] hits=%llu misses=%llu entries=%zu bytes=%zu\n",
+      (unsigned long long)cache.hits,(unsigned long long)cache.misses,cache.entries.size(),cache.bytes);
+  // For very small primitives, decoding is cheaper than a content-key lookup.
+  const bool cacheDraw=useCache&&count>=16;
+  const auto key=cacheDraw ? flip_vertex_key(c,raw,bytes,g_gxState.arrays,g_gxState.currentPnMtx) : FlipVertexCache::Key{};
+  const auto& loader = flip_loader(c);
+  const auto& layout = loader.layout;
+#ifdef MELEE_MIYOO_FLIP
+  static const bool specialized=[] {const char* v=std::getenv("MELEE_FLIP_LOADERS");return !v||std::strcmp(v,"0");}();
+  if(specialized&&loader.ok&&!cacheDraw&&!c.lineMode) {
+    // Specialized loader: decode once, directly into immutable frame storage.
+    u8* destination=nullptr;
+    const auto range=gfx::map_flip_verts(count*layout.stride,alignment,destination);
+    if(!destination) return {};
+    const uint32_t word2=(record||textureBank)&&loader.hasMatrices ? (record<<8)|(textureBank<<12) : 0u;
+    flip_decode_with(loader,raw,count,destination,g_gxState.arrays,g_gxState.currentPnMtx,word2);
+    return range;
+  }
+  static const bool direct=[] {const char* s=std::getenv("MELEE_FLIP_DECODE_DIRECT");return s&&!std::strcmp(s,"1");}();
+  if(direct&&!cacheDraw&&!c.lineMode) {
+    u8* destination=nullptr;
+    const auto range=gfx::map_flip_verts(count*layout.stride,alignment,destination);
+    if(!destination) return {};
+    flip_decode_packed_into(c,layout,raw,count,{destination,range.size},g_gxState.arrays,g_gxState.currentPnMtx);
+    if((record||textureBank)&&flip_vertex_location(c,0)) {
+      for(size_t i=0;i<range.size;i+=layout.stride) {
+        uint32_t word;std::memcpy(&word,destination+i+8,4);
+        word=(word&~0xff00u)|(record<<8)|(textureBank<<12);std::memcpy(destination+i+8,&word,4);
+      }
+    }
+    return range;
+  }
+#endif
+  static std::vector<u8> packed;
+  const auto upload=[&]() {
+    gfx::detail::flip_profile::Scope uploadProfile("vertex_stage_copy",0,packed.size());
+    if((record || textureBank) && flip_vertex_location(c,0)) {
+      for(size_t i=0;i<packed.size();i+=layout.stride) {
+        uint32_t word;std::memcpy(&word,packed.data()+i+8,4);
+        word=(word&~0xff00u)|(record<<8)|(textureBank<<12);std::memcpy(packed.data()+i+8,&word,4);
+      }
+    }
+    return gfx::push_verts(packed.data(),packed.size(),alignment);
+  };
+  if(cacheDraw) {
+    if(auto it=cache.entries.find(key);it!=cache.entries.end()) {
+      ++cache.hits;packed=it->second;return upload();
+    }
+    ++cache.misses;
+  }
+  if(!c.lineMode) {
+    flip_decode_packed(c,layout,raw,count,packed,g_gxState.arrays,g_gxState.currentPnMtx);
+    if(cacheDraw) cache.store(key,packed);
+    return upload();
+  }
+  static std::vector<FlipVertex> decoded, expanded;
+  static const bool bulk = [] { const auto* s=std::getenv("MELEE_FLIP_BULK_DECODE"); return !s || std::strcmp(s,"0"); }();
+  if (!bulk || !flip_decode_bulk(c, raw, count, decoded, g_gxState.arrays, g_gxState.currentPnMtx)) {
+    decoded.resize(count);
+    for (size_t i = 0; i < count; ++i)
+      decoded[i] = flip_decode_vertex(c, raw + i * c.vtxStride, g_gxState.arrays, g_gxState.currentPnMtx);
+  }
+  if (c.lineMode) {
+    const size_t instances = c.lineMode == 3 ? count : c.lineMode == 1 ? count / 2 : count ? count - 1 : 0;
+    AURORA_ASSERT(instances <= 16383, "Too many expanded GX lines/points");
+    expanded.resize(instances * 4);
+    for (size_t i = 0; i < instances; ++i) {
+      const auto& a = decoded[c.lineMode == 1 ? i * 2 : i];
+      const auto& b = decoded[c.lineMode == 3 ? i : c.lineMode == 1 ? i * 2 + 1 : i + 1];
+      for (unsigned corner = 0; corner < 4; ++corner) {
+        auto& v = expanded[i * 4 + corner];
+        v = corner >= 2 ? b : a;
+        v.matrices[2] |= corner << 24;
+        std::memcpy(v.pos, a.pos, sizeof(v.pos));
+        v.matrices[0] = (v.matrices[0] & ~255u) | (a.matrices[0] & 255);
+        std::memcpy(v.lineEnd, b.pos, sizeof(b.pos));
+        v.lineEnd[3] = float(b.matrices[0] & 255);
+      }
+    }
+  }
+  auto& vertices = c.lineMode ? expanded : decoded;
+  packed.resize(vertices.size() * layout.stride);
+  for (size_t i = 0; i < vertices.size(); ++i) {
+    const auto* source = reinterpret_cast<const u8*>(&vertices[i]);
+    for (unsigned a = 0; a < layout.count; ++a) {
+      const auto& attr = layout.attributes[a];
+      std::memcpy(packed.data() + i * layout.stride + attr.offset, source + layout.sources[a],
+                  flip_attribute_bytes(attr.shaderLocation));
+    }
+  }
+  if(cacheDraw) cache.store(key,packed);
+  return upload();
+}
+} // namespace aurora::gx
