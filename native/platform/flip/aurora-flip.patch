+    auto* s = std::getenv("MELEE_FLIP_BATCH_DRAWS");
+    return s && std::strcmp(s, "0");
+  }();
+  return enabled && flip_vertex_enabled() && flip_uniform_enabled();
+}
+inline bool flip_cpu_upload_enabled() {
+  static const bool enabled = [] { const char* s=std::getenv("MELEE_FLIP_CPU_UPLOAD"); return !s || std::strcmp(s,"0"); }();
+  return enabled && flip_vertex_enabled();
+}
