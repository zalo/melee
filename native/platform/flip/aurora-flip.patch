+#pragma once
+// Resident display-list geometry (Flip). HSD models draw static GX display
+// lists that index static vertex arrays inside archive memory. Instead of
+// re-decoding and re-uploading them every frame, each (display list, vertex
+// format, matrix slot) is decoded once into a GPU-resident arena and later
+// calls only append 32-bit indices. Arrays are released through explicit
+// invalidation when their archive region is unregistered; display-list bytes
+// are hashed on every call so stale or reused memory is never trusted blindly.
+#include "flip_vertex.hpp"
+#include "../gfx/frame.hpp"
+#include "../gfx/render_worker.hpp"
+#include "../webgpu/gpu.hpp"
+
+#include <absl/container/flat_hash_map.h>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <utility>
+#include <vector>
+
+namespace aurora::gx::resident {
+
+inline bool enabled() {
+  static const bool value = [] {
+    const char* v = std::getenv("MELEE_FLIP_RESIDENT_DL");
+    return !v || std::strcmp(v, "0");
+  }();
+  return value && flip_batch_enabled();
+}
+
+struct Arena {
+  uint32_t stride = 0;
+  std::vector<uint8_t> mirror;              // CPU copy; FIFO worker appends
+  size_t used = 0;                          // bytes decoded so far
+  std::mutex mutex;                         // guards mirror growth, pending, gpu fields
+  std::vector<std::pair<size_t, size_t>> pending; // byte ranges awaiting upload
+  wgpu::Buffer buffer;                      // render worker owned
+  size_t bufferSize = 0;
+  uint32_t generation = 0;                  // bumped when buffer is recreated
+};
+
+struct Entry {
+  uint32_t arena = 0;
+  uint32_t firstVertex = 0;
+  uint32_t vertexCount = 0;
+  std::vector<uint32_t> indices;            // absolute arena vertex indices
+  uint64_t dlHash = 0;
+  const void* dl = nullptr;
+  uint32_t dlBytes = 0;
+  std::array<const void*, MaxVtxAttr> arrays{};
+  uint64_t lastUsed = 0;
+};
+
+struct Stats { uint64_t calls = 0, hits = 0, misses = 0, fallbacks = 0, invalidations = 0, resets = 0, bytes = 0; };
+
+struct State {
+  std::vector<std::unique_ptr<Arena>> arenas;
+  absl::flat_hash_map<uint64_t, Entry> entries;
+  // Every pointer an entry depends on (list, arrays) -> entry key, so releasing
+  // a memory region is a range query instead of a scan of all entries. Moving
+  // scenes release regions hundreds of times per frame.
+  std::multimap<uintptr_t, uint64_t> pointerIndex;
+  Stats stats;
+  size_t budget = [] {
+    const char* v = std::getenv("MELEE_FLIP_RESIDENT_MB");
+    const size_t mb = v ? std::max(8, std::atoi(v)) : 64;
+    return mb * 1024 * 1024;
+  }();
+};
+inline State& state() { static State s; return s; }
+
+inline Arena& arena_for_stride(uint32_t stride, uint32_t& index) {
+  auto& s = state();
+  for (uint32_t i = 0; i < s.arenas.size(); ++i)
+    if (s.arenas[i]->stride == stride) { index = i; return *s.arenas[i]; }
+  auto arena = std::make_unique<Arena>();
+  arena->stride = stride;
+  arena->mirror.reserve(4 * 1024 * 1024);
+  index = static_cast<uint32_t>(s.arenas.size());
+  s.arenas.push_back(std::move(arena));
+  return *s.arenas.back();
+}
+
+inline size_t total_used() {
+  size_t total = 0;
+  for (auto& a : state().arenas) total += a->used;
+  return total;
+}
+
+inline void index_entry(uint64_t key, const Entry& entry) {
+  auto& s = state();
+  s.pointerIndex.emplace(reinterpret_cast<uintptr_t>(entry.dl), key);
+  for (const void* p : entry.arrays) if (p) s.pointerIndex.emplace(reinterpret_cast<uintptr_t>(p), key);
+}
+inline void unindex_entry(uint64_t key, const Entry& entry) {
+  auto& s = state();
+  const auto drop = [&](const void* p) {
+    if (!p) return;
+    auto range = s.pointerIndex.equal_range(reinterpret_cast<uintptr_t>(p));
+    for (auto it = range.first; it != range.second; ++it) if (it->second == key) { s.pointerIndex.erase(it); break; }
+  };
+  drop(entry.dl);
+  for (const void* p : entry.arrays) drop(p);
+}
+inline void erase_entry(uint64_t key) {
+  auto& s = state();
+  if (auto it = s.entries.find(key); it != s.entries.end()) { unindex_entry(key, it->second); s.entries.erase(it); }
+}
+
+// Drop every entry and rewind the arenas. GPU buffers stay allocated.
+inline void reset_all() {
+  auto& s = state();
+  s.entries.clear();
+  s.pointerIndex.clear();
+  for (auto& a : s.arenas) {
+    std::lock_guard lock{a->mutex};
+    a->used = 0;
+    a->pending.clear();
+  }
+  ++s.stats.resets;
+}
+
+// Reserve `bytes` in the arena and return the mirror offset. Growth happens
+// under the lock because the render worker reads pending ranges from `mirror`.
+inline size_t reserve(Arena& a, size_t bytes) {
+  std::lock_guard lock{a.mutex};
+  const size_t offset = a.used;
+  if (a.mirror.size() < offset + bytes) a.mirror.resize(std::max(a.mirror.size() * 2, offset + bytes));
+  a.used = offset + bytes;
+  return offset;
+}
+inline void publish(Arena& a, size_t offset, size_t bytes) {
+  std::lock_guard lock{a.mutex};
+  if (!a.pending.empty() && a.pending.back().first + a.pending.back().second == offset) a.pending.back().second += bytes;
+  else a.pending.emplace_back(offset, bytes);
+}
+
+// Render worker: create/grow buffers and upload pending ranges. Called before
+// each render pass is encoded so every arena a pass references is current.
+inline void render_flush() {
+  auto& s = state();
+  for (uint32_t i = 0; i < s.arenas.size(); ++i) {
+    auto& a = *s.arenas[i];
+    std::lock_guard lock{a.mutex};
+    if (a.pending.empty() && a.bufferSize >= a.used) continue;
+    const size_t needed = a.used;
+    if (a.bufferSize < needed) {
+      size_t size = std::max<size_t>(a.bufferSize ? a.bufferSize * 2 : 4 * 1024 * 1024, needed);
+      size = (size + 255) & ~size_t(255);
+      const wgpu::BufferDescriptor desc{.label = "Resident vertex arena",
+                                        .usage = wgpu::BufferUsage::Vertex | wgpu::BufferUsage::CopyDst,
+                                        .size = size};
+      a.buffer = webgpu::g_device.CreateBuffer(&desc);
+      a.bufferSize = size;
+      ++a.generation;
+      // New storage: upload everything decoded so far.
+      const size_t bytes = (needed + 3) & ~size_t(3);
+      if (bytes) webgpu::g_queue.WriteBuffer(a.buffer, 0, a.mirror.data(), bytes);
+      a.pending.clear();
+      continue;
+    }
+    for (const auto& [offset, bytes] : a.pending) {
+      const size_t begin = offset & ~size_t(3);
+      const size_t end = std::min(a.mirror.size(), (offset + bytes + 3) & ~size_t(3));
+      if (end > begin) webgpu::g_queue.WriteBuffer(a.buffer, begin, a.mirror.data() + begin, end - begin);
+    }
+    a.pending.clear();
+  }
+}
+
+inline bool has_pending() {
+  for (auto& a : state().arenas) {
+    std::lock_guard lock{a->mutex};
+    if (!a->pending.empty() || a->bufferSize < a->used) return true;
+  }
+  return false;
+}
+
+// Render worker: buffer for a DrawData::resident value (index + 1).
+inline const wgpu::Buffer& buffer(uint32_t resident, uint32_t* generation = nullptr) {
+  auto& a = *state().arenas[resident - 1];
+  if (generation) *generation = a.generation;
+  return a.buffer;
+}
+inline uint32_t stride(uint32_t resident) { return state().arenas[resident - 1]->stride; }
+inline size_t gpu_bytes(uint32_t resident) {
+  auto& a = *state().arenas[resident - 1];
+  std::lock_guard lock{a.mutex};
+  return a.bufferSize;
+}
+
+// FIFO worker: forget entries referencing released memory (range query).
+inline void invalidate(const void* base, size_t size) {
+  auto& s = state();
+  const auto lo = reinterpret_cast<uintptr_t>(base), hi = lo + size;
+  std::vector<uint64_t> keys;
+  for (auto it = s.pointerIndex.lower_bound(lo); it != s.pointerIndex.end() && it->first < hi; ++it) keys.push_back(it->second);
+  for (uint64_t key : keys) {
+    if (s.entries.contains(key)) { erase_entry(key); ++s.stats.invalidations; }
+  }
+}
+
+inline void shutdown() {
+  auto& s = state();
+  s.entries.clear();
+  s.arenas.clear();
+}
+
+} // namespace aurora::gx::resident
