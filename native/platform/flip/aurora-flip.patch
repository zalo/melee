+  out.matrices[0] = pnMtx;
+  for (unsigned ai = GX_VA_PNMTXIDX; ai <= GX_VA_TEX7; ++ai) {
+    const auto& m = c.attrs[ai];
+    if (m.attrType == GX_NONE)
+      continue;
+    const auto address = [&](unsigned slice, unsigned bytes) -> const u8* {
+      const unsigned componentBytes =
+          (m.compType == GX_F32 ? 4 : (m.compType == GX_U16 || m.compType == GX_S16 ? 2 : 1));
+      const unsigned within = slice * 3 * componentBytes;
+      if (m.attrType == GX_DIRECT)
+        return raw + m.offset + within;
+      const unsigned indexBytes = m.attrType == GX_INDEX8 ? 1 : 2;
+      const auto index = flip_integer(raw + m.offset + (m.nbt3 ? slice * indexBytes : 0), indexBytes, false);
+      const auto& array = arrays[ai];
+      const uint64_t off = uint64_t(index) * m.stride + within;
+      // Match robust GPU reads, but never read outside the CPU source array.
+      static const u8 zero[16]{};
+      if (!array.data || off + bytes > array.size)
+        return zero;
+      return static_cast<const u8*>(array.data) + off;
+    };
+    if (ai <= GX_VA_TEX7MTXIDX) {
+      unsigned v = *address(0, 1);
+      if (ai == GX_VA_PNMTXIDX)
+        v /= 3;
+      out.matrices[ai / 4] &= ~(255u << ((ai % 4) * 8));
+      out.matrices[ai / 4] |= v << ((ai % 4) * 8);
+      continue;
+    }
+    const bool le = m.attrType != GX_DIRECT && m.le;
+    if (ai == GX_VA_CLR0 || ai == GX_VA_CLR1) {
+      float* dst = out.color[ai - GX_VA_CLR0];
+      unsigned bytes = (m.compType == GX_RGB565 || m.compType == GX_RGBA4)
+                           ? 2
+                           : (m.compType == GX_RGB8 || m.compType == GX_RGBA6 ? 3 : 4);
+      const u8* p = address(0, bytes);
+      const uint32_t v = flip_integer(p, bytes, le);
+      if (m.compType == GX_RGB565) {
+        dst[0] = float((v >> 11) & 31) / 31;
+        dst[1] = float((v >> 5) & 63) / 63;
+        dst[2] = float(v & 31) / 31;
+        dst[3] = 1;
+      } else if (m.compType == GX_RGBA4 || m.compType == GX_RGBA6) {
+        unsigned bits = m.compType == GX_RGBA4 ? 4 : 6, mask = (1u << bits) - 1;
+        for (unsigned j = 0; j < 4; ++j)
+          dst[j] = float((v >> ((3 - j) * bits)) & mask) / mask;
+      } else {
+        for (unsigned j = 0; j < 4; ++j)
+          dst[j] = (j == 3 && m.compType != GX_RGBA8) ? 1.f : float(p[j]) / 255.f;
+      }
+      continue;
+    }
+    const unsigned bytes = m.compType == GX_F32 ? 4 : (m.compType == GX_U16 || m.compType == GX_S16 ? 2 : 1);
+    const unsigned slices = ai == GX_VA_NRM && m.cnt == 9 ? 3 : 1;
+    for (unsigned slice = 0; slice < slices; ++slice) {
+      float* dst = ai == GX_VA_POS   ? out.pos
+                   : ai == GX_VA_NRM ? (slice == 0   ? out.normal
+                                        : slice == 1 ? out.binormal
+                                                     : out.tangent)
+                                     : out.tex[ai - GX_VA_TEX0];
+      unsigned count = ai == GX_VA_NRM ? 3 : m.cnt;
+      const u8* p = address(slice, count * bytes);
+      for (unsigned j = 0; j < count; ++j) {
+        uint32_t v = flip_integer(p + j * bytes, bytes, le);
+        if (m.compType == GX_F32)
+          dst[j] = std::bit_cast<float>(v);
+        else {
+          int32_t n = m.compType == GX_S8 ? int8_t(v) : m.compType == GX_S16 ? int16_t(v) : int32_t(v);
+          dst[j] = float(n) / float(uint32_t(1) << m.frac);
+        }
+      }
+    }
+  }
+  return out;
+}
+// Attribute-major decoding hoists format selection and scalar conversion out
+// of the per-vertex loop. The reference decoder remains for NBT and diagnostics.
+inline bool flip_decode_bulk(const ShaderConfig& c, const u8* raw, size_t count,
+                             std::vector<FlipVertex>& out,
+                             const std::array<AttrArray, MaxVtxAttr>& arrays, u32 pnMtx) {
+  for (unsigned ai = GX_VA_POS; ai <= GX_VA_TEX7; ++ai) {
+    const auto& m = c.attrs[ai];
+    if (m.attrType == GX_NONE) continue;
+    if (ai == GX_VA_NRM && m.cnt == 9) return false;
+  }
+  out.resize(count);
+  std::memset(out.data(), 0, count * sizeof(FlipVertex));
+  for (auto& v : out) v.matrices[0] = pnMtx;
+  for (unsigned ai = GX_VA_PNMTXIDX; ai <= GX_VA_TEX7; ++ai) {
+    const auto& m = c.attrs[ai];
+    if (m.attrType == GX_NONE) continue;
+    const auto& array = arrays[ai];
+    const auto address = [&](size_t i, unsigned bytes) -> const u8* {
+      const auto* src = raw + i * c.vtxStride + m.offset;
+      if (m.attrType == GX_DIRECT) return src;
+      const unsigned index = m.attrType == GX_INDEX8 ? *src : unsigned(src[0]) * 256 + src[1];
+      const uint64_t off = uint64_t(index) * m.stride;
+      static constexpr u8 zero[16]{};
+      return array.data && off + bytes <= array.size ? static_cast<const u8*>(array.data) + off : zero;
+    };
+    if (ai <= GX_VA_TEX7MTXIDX) {
+      for (size_t i = 0; i < count; ++i) {
+        const unsigned value = *address(i, 1) / (ai == GX_VA_PNMTXIDX ? 3 : 1);
+        auto& word = out[i].matrices[ai / 4];
+        word = (word & ~(255u << ((ai % 4) * 8))) | (value << ((ai % 4) * 8));
+      }
+      continue;
+    }
+    if (ai == GX_VA_CLR0 || ai == GX_VA_CLR1) {
+      const unsigned bytes=(m.compType==GX_RGB565 || m.compType==GX_RGBA4) ? 2
+        : (m.compType==GX_RGB8 || m.compType==GX_RGBA6) ? 3 : 4;
+      const bool le=m.attrType!=GX_DIRECT && m.le;
+      for (size_t i=0;i<count;++i) {
+        auto* dst=out[i].color[ai-GX_VA_CLR0];
+        const auto* src=address(i,bytes);
+        const uint32_t v=flip_integer(src,bytes,le);
+        if (m.compType==GX_RGB565) {
+          dst[0]=float((v>>11)&31)/31; dst[1]=float((v>>5)&63)/63;
+          dst[2]=float(v&31)/31; dst[3]=1;
+        } else if (m.compType==GX_RGBA4 || m.compType==GX_RGBA6) {
+          const unsigned bits=m.compType==GX_RGBA4 ? 4 : 6,mask=(1u<<bits)-1;
+          for(unsigned j=0;j<4;++j) dst[j]=float((v>>((3-j)*bits))&mask)/mask;
+        } else {
+          for(unsigned j=0;j<3;++j) dst[j]=float(src[j])/255.f;
+          dst[3]=m.compType==GX_RGBA8 ? float(src[3])/255.f : 1.f;
+        }
+      }
+      continue;
+    }
+    const unsigned components = ai == GX_VA_NRM ? 3 : m.cnt;
+    const unsigned offset = ai == GX_VA_POS ? offsetof(FlipVertex, pos)
+      : ai == GX_VA_NRM ? offsetof(FlipVertex, normal)
+      : offsetof(FlipVertex, tex) + (ai - GX_VA_TEX0) * sizeof(out[0].tex[0]);
+    const float scale = float(uint32_t(1) << m.frac);
+    const auto convert = [&]<typename T, bool Little>() {
+      for (size_t i = 0; i < count; ++i) {
+        const auto* src = address(i, components * sizeof(T));
+        auto* dst = reinterpret_cast<float*>(reinterpret_cast<u8*>(&out[i]) + offset);
+        for (unsigned j = 0; j < components; ++j) {
+          T value;
+          if constexpr (sizeof(T) == 4) {
+            uint32_t bits; std::memcpy(&bits, src + j * 4, 4);
+            if constexpr (!Little) bits = __builtin_bswap32(bits);
+            std::memcpy(&value, &bits, 4);
+          } else if constexpr (sizeof(T) == 2) {
+            uint16_t bits; std::memcpy(&bits, src + j * 2, 2);
+            if constexpr (!Little) bits = __builtin_bswap16(bits);
+            std::memcpy(&value, &bits, 2);
+          } else std::memcpy(&value, src + j, 1);
+          if constexpr (std::is_same_v<T, float>) dst[j] = value;
+          else dst[j] = float(value) / scale;
+        }
+      }
+    };
+    const bool le = m.attrType != GX_DIRECT && m.le;
+#define FLIP_CONVERT(TYPE) do { if (le) convert.template operator()<TYPE, true>(); else convert.template operator()<TYPE, false>(); } while (0)
+    switch (m.compType) {
+      case GX_F32: FLIP_CONVERT(float); break;
+      case GX_U16: FLIP_CONVERT(uint16_t); break;
+      case GX_S16: FLIP_CONVERT(int16_t); break;
+      case GX_S8: FLIP_CONVERT(int8_t); break;
+      default: FLIP_CONVERT(uint8_t); break;
+    }
+#undef FLIP_CONVERT
+  }
+  return true;
+}
+
+// Decode straight into the conventional vertex stream. This avoids writing a
+// 172-byte FlipVertex and then gathering its live fields into a second buffer.
+inline void flip_decode_packed_into(const ShaderConfig& c, const FlipVertexLayout& layout,
+                               const u8* raw, size_t count, std::span<u8> out,
+                               const std::array<AttrArray, MaxVtxAttr>& arrays, u32 pnMtx) {
+  gfx::detail::flip_profile::Scope profile("vertex_decode",0,count);
+  assert(out.size()==count*layout.stride);
+  std::memset(out.data(), 0, out.size());
+  const auto destination_offset = [&](unsigned location) -> size_t {
+    for (unsigned i = 0; i < layout.count; ++i)
+      if (layout.attributes[i].shaderLocation == location) return layout.attributes[i].offset;
+    return SIZE_MAX;
+  };
+  const size_t matrixOffset=destination_offset(0);
+  if(matrixOffset!=SIZE_MAX)
+    for(size_t i=0;i<count;++i) std::memcpy(out.data()+i*layout.stride+matrixOffset,&pnMtx,sizeof(pnMtx));
+
+  for(unsigned ai=GX_VA_PNMTXIDX;ai<=GX_VA_TEX7;++ai) {
+    const auto& m=c.attrs[ai];
+    if(m.attrType==GX_NONE) continue;
+    // Stable, decodable format key: attribute/type/components/address/endian/NBT.
+    const uint64_t format=ai|(uint64_t(m.compType)<<8)|(uint64_t(m.cnt)<<16)|
+      (uint64_t(m.attrType)<<24)|(uint64_t(m.le)<<32)|(uint64_t(m.nbt3)<<33);
+    gfx::detail::flip_profile::Scope attributeProfile("vertex_attribute",format,count);
+    const unsigned componentBytes=m.compType==GX_F32 ? 4 :
+      (m.compType==GX_U16 || m.compType==GX_S16) ? 2 : 1;
+    const auto address=[&](size_t vertex,unsigned slice,unsigned bytes)->const u8* {
+      const unsigned within=slice*3*componentBytes;
+      const auto* src=raw+vertex*c.vtxStride+m.offset;
+      if(m.attrType==GX_DIRECT) return src+within;
+      const unsigned indexBytes=m.attrType==GX_INDEX8 ? 1 : 2;
+      src+=m.nbt3 ? slice*indexBytes : 0;
+      const unsigned index=indexBytes==1 ? src[0] : unsigned(src[0])*256+src[1];
+      const auto& array=arrays[ai];
+      const uint64_t offset=uint64_t(index)*m.stride+within;
+      static constexpr u8 zero[48]{};
+      return array.data && offset+bytes<=array.size ? static_cast<const u8*>(array.data)+offset : zero;
+    };
+    if(ai<=GX_VA_TEX7MTXIDX) {
+      if(matrixOffset==SIZE_MAX) continue;
+      const unsigned shift=(ai%4)*8;
+      for(size_t i=0;i<count;++i) {
+        unsigned value=*address(i,0,1)/(ai==GX_VA_PNMTXIDX ? 3 : 1);
+        auto* dst=out.data()+i*layout.stride+matrixOffset+(ai/4)*4;
+        uint32_t word;std::memcpy(&word,dst,4);
+        word=(word&~(255u<<shift))|(value<<shift);std::memcpy(dst,&word,4);
+      }
+      continue;
+    }
+    const unsigned location=ai==GX_VA_POS ? 1 : ai==GX_VA_NRM ? 2 :
+      ai==GX_VA_CLR0 ? 3 : ai==GX_VA_CLR1 ? 4 : 5+ai-GX_VA_TEX0;
+    const size_t baseOffset=destination_offset(location);
+    if(baseOffset==SIZE_MAX) continue;
+    if(ai==GX_VA_CLR0 || ai==GX_VA_CLR1) {
+      const unsigned bytes=(m.compType==GX_RGB565 || m.compType==GX_RGBA4) ? 2 :
+        (m.compType==GX_RGB8 || m.compType==GX_RGBA6) ? 3 : 4;
+      const bool le=m.attrType!=GX_DIRECT && m.le;
+      for(size_t i=0;i<count;++i) {
+        auto* dst=reinterpret_cast<float*>(out.data()+i*layout.stride+baseOffset);
+        const auto* src=address(i,0,bytes);
+        const uint32_t value=flip_integer(src,bytes,le);
+        if(m.compType==GX_RGB565) {
+          dst[0]=float((value>>11)&31)/31;dst[1]=float((value>>5)&63)/63;
+          dst[2]=float(value&31)/31;dst[3]=1;
+        } else if(m.compType==GX_RGBA4 || m.compType==GX_RGBA6) {
+          const unsigned bits=m.compType==GX_RGBA4 ? 4 : 6,mask=(1u<<bits)-1;
+          for(unsigned j=0;j<4;++j) dst[j]=float((value>>((3-j)*bits))&mask)/mask;
+        } else {
+          for(unsigned j=0;j<3;++j) dst[j]=float(src[j])/255.f;
+          dst[3]=m.compType==GX_RGBA8 ? float(src[3])/255.f : 1.f;
+        }
+      }
+      continue;
+    }
+    const unsigned components=ai==GX_VA_NRM ? 3 : m.cnt;
+    const unsigned slices=ai==GX_VA_NRM && m.cnt==9 ? 3 : 1;
+    const float inverseScale=1.f/float(uint32_t(1)<<m.frac);
+    const auto convert=[&]<typename T,bool Little,unsigned Components,unsigned Slices>() {
+      // Select record dimensions once per attribute, so the inner loops have
+      // fixed bounds. In particular, ordinary XYZ is not an NBT loop and XY
+      // does not carry a runtime component loop through every indexed load.
+      for(size_t i=0;i<count;++i) for(unsigned slice=0;slice<Slices;++slice) {
+        const size_t sliceOffset=slice==0 ? baseOffset : destination_offset(12+slice);
+        if(sliceOffset==SIZE_MAX) continue;
+        auto* dst=reinterpret_cast<float*>(out.data()+i*layout.stride+sliceOffset);
+        const auto* src=address(i,slice,Components*sizeof(T));
+#if defined(__aarch64__)
+        // The common GX positions/texcoords use two or three 16-bit fixed
+        // point components. Convert them together, without reading beyond
+        // the six-byte XYZ record (arrays can end immediately after it).
+        if constexpr(sizeof(T)==2) {
+          static const bool neon=[] {const char* v=std::getenv("MELEE_FLIP_NEON_DECODE");return !v||std::strcmp(v,"0");}();
+          if(neon&&(Components==2||Components==3)) {
+            uint32_t xy;std::memcpy(&xy,src,4);
+            uint16x4_t h=vreinterpret_u16_u32(vdup_n_u32(xy));
+            if constexpr(Components==3) {
+              uint16_t z;std::memcpy(&z,src+4,2);h=vset_lane_u16(z,h,2);
+            }
+            if constexpr(!Little) h=vreinterpret_u16_u8(vrev16_u8(vreinterpret_u8_u16(h)));
+            float32x4_t values;
+            if constexpr(std::is_signed_v<T>) values=vcvtq_f32_s32(vmovl_s16(vreinterpret_s16_u16(h)));
+            else values=vcvtq_f32_u32(vmovl_u16(h));
+            values=vmulq_n_f32(values,inverseScale);
+            vst1_f32(dst,vget_low_f32(values));
+            if constexpr(Components==3) vst1q_lane_f32(dst+2,values,2);
+            continue;
+          }
+        }
+#endif
+        for(unsigned j=0;j<Components;++j) {
+          T value;
+          if constexpr(sizeof(T)==4) {
+            uint32_t bits;std::memcpy(&bits,src+j*4,4);
+            if constexpr(!Little) bits=__builtin_bswap32(bits);
+            std::memcpy(&value,&bits,4);
+          } else if constexpr(sizeof(T)==2) {
+            uint16_t bits;std::memcpy(&bits,src+j*2,2);
+            if constexpr(!Little) bits=__builtin_bswap16(bits);
+            std::memcpy(&value,&bits,2);
+          } else std::memcpy(&value,src+j,1);
+          if constexpr(std::is_same_v<T,float>) dst[j]=value;
+          else dst[j]=float(value)*inverseScale;
+        }
+      }
+    };
+    const auto dimensions=[&]<typename T,bool Little>() {
+      if(slices==3) convert.template operator()<T,Little,3,3>();
+      else if(components==3) convert.template operator()<T,Little,3,1>();
+      else if(components==2) convert.template operator()<T,Little,2,1>();
+      else convert.template operator()<T,Little,1,1>();
+    };
+    const bool le=m.attrType!=GX_DIRECT && m.le;
+#define FLIP_PACKED_CONVERT(TYPE) do { if(le) dimensions.template operator()<TYPE,true>(); else dimensions.template operator()<TYPE,false>(); } while(0)
+    switch(m.compType) {
+      case GX_F32: FLIP_PACKED_CONVERT(float);break;
+      case GX_U16: FLIP_PACKED_CONVERT(uint16_t);break;
+      case GX_S16: FLIP_PACKED_CONVERT(int16_t);break;
+      case GX_S8: FLIP_PACKED_CONVERT(int8_t);break;
+      default: FLIP_PACKED_CONVERT(uint8_t);break;
+    }
+#undef FLIP_PACKED_CONVERT
+  }
+}
+
+inline void flip_decode_packed(const ShaderConfig& c,const FlipVertexLayout& layout,
+                               const u8* raw,size_t count,std::vector<u8>& out,
+                               const std::array<AttrArray,MaxVtxAttr>& arrays,u32 pnMtx) {
+  out.resize(count*layout.stride);
+  flip_decode_packed_into(c,layout,raw,count,out,arrays,pnMtx);
+}
+
+struct FlipVertexCache {
+  using Key = std::array<uint64_t, 2>;
+  absl::flat_hash_map<Key, std::vector<u8>> entries;
+  std::deque<Key> order;
+  size_t bytes = 0;
+  uint64_t hits = 0, misses = 0;
+  void store(const Key& key, const std::vector<u8>& data) {
+    constexpr size_t budget=16*1024*1024;
+    if(data.size()>budget) return;
+    while(!order.empty() && (entries.size()>=2048 || bytes+data.size()>budget)) {
+      auto old=entries.find(order.front());
+      if(old!=entries.end()){bytes-=old->second.size();entries.erase(old);}
+      order.pop_front();
+    }
+    if(entries.emplace(key,data).second){bytes+=data.size();order.push_back(key);}
+  }
+};
+inline FlipVertexCache& flip_vertex_cache() { static FlipVertexCache cache; return cache; }
+inline FlipVertexCache::Key flip_vertex_key(const ShaderConfig& c,const u8* raw,size_t bytes,
+  const std::array<AttrArray,MaxVtxAttr>& arrays,u32 pnMtx) {
+  std::array<uint64_t,96> signature{};
+  unsigned fields=0;
+  const auto hash=[&](const void* p,size_t n) {
+    const auto h=XXH3_128bits(p,n); signature[fields++]=h.low64; signature[fields++]=h.high64;
+  };
+  hash(c.attrs.data(),sizeof(c.attrs)); hash(raw,bytes);
+  signature[fields++]=c.lineMode;signature[fields++]=c.vtxStride;
+  // Universal and compact shaders can have identical GX input formats but
+  // different decoded layouts. Never share packed bytes across those layouts.
+  signature[fields++]=c.flipFlags;
+  signature[fields++]=c.attrs[GX_VA_PNMTXIDX].attrType==GX_NONE?pnMtx:0;
+  const size_t count=bytes/c.vtxStride;
+  for(unsigned ai=GX_VA_POS;ai<=GX_VA_TEX7;++ai) {
+    const auto& m=c.attrs[ai];
+    if(m.attrType!=GX_INDEX8 && m.attrType!=GX_INDEX16) continue;
+    const auto& array=arrays[ai];
+    const unsigned indexBytes=m.attrType==GX_INDEX8?1:2;
+    unsigned minimum=65535,maximum=0;
+    for(size_t i=0;i<count;++i) for(unsigned slice=0;slice<(m.nbt3?3u:1u);++slice) {
+      const auto* p=raw+i*c.vtxStride+m.offset+slice*indexBytes;
+      const unsigned index=indexBytes==1 ? p[0] : (unsigned(p[0])*256+p[1]);
+      minimum=std::min(minimum,index);maximum=std::max(maximum,index);
+    }
+    unsigned componentBytes=m.compType==GX_F32?4:(m.compType==GX_U16||m.compType==GX_S16)?2:1;
+    unsigned recordBytes=m.cnt*componentBytes;
+    if(ai==GX_VA_CLR0 || ai==GX_VA_CLR1)
+      recordBytes=(m.compType==GX_RGB565||m.compType==GX_RGBA4)?2:(m.compType==GX_RGB8||m.compType==GX_RGBA6)?3:4;
+    const uint64_t begin=uint64_t(minimum)*m.stride;
+    const uint64_t end=std::min<uint64_t>(uint64_t(maximum)*m.stride+recordBytes,array.size);
+    signature[fields++]=array.data?array.size:0;
+    const unsigned slices=m.nbt3?3:1;
+    const unsigned referencedBytes=m.nbt3?3*componentBytes:recordBytes;
+    if(array.data && count && end>begin) {
+      if(end-begin<=count*slices*referencedBytes*2) {
+        hash(static_cast<const u8*>(array.data)+begin,end-begin);
+      } else {
+        // Sparse display lists can reference opposite ends of a large model
+        // array. Gather only the records decoded by this draw before hashing.
+        // This remains content based, including mutable and aliased arrays.
+        static std::vector<u8> gathered;
+        gathered.resize(count*slices*referencedBytes);
+        for(size_t i=0;i<count;++i) for(unsigned slice=0;slice<slices;++slice) {
+          const auto* p=raw+i*c.vtxStride+m.offset+slice*indexBytes;
+          const unsigned index=indexBytes==1?p[0]:(unsigned(p[0])*256+p[1]);
+          const uint64_t offset=uint64_t(index)*m.stride+slice*3*componentBytes;
+          auto* dst=gathered.data()+(i*slices+slice)*referencedBytes;
+          if(offset+referencedBytes<=array.size)
+            std::memcpy(dst,static_cast<const u8*>(array.data)+offset,referencedBytes);
+          else std::memset(dst,0,referencedBytes);
+        }
+        hash(gathered.data(),gathered.size());
+      }
+    } else hash(nullptr,0);
+  }
+  const auto key=XXH3_128bits(signature.data(),fields*sizeof(uint64_t));
+  return {key.low64,key.high64};
+}
+
+inline gfx::Range flip_push_vertices(GXPrimitive prim, GXVtxFmt fmt, const u8* raw, size_t bytes, size_t alignment,
+                                     unsigned record = 0, const ShaderConfig* prepared = nullptr,
+                                     unsigned textureBank = 0) {
+  gfx::detail::flip_profile::Scope profile("vertex_prepare",0,bytes);
+  constexpr Module Log{"aurora::gx::flip"};
+  if (!flip_vertex_enabled())
+    return gfx::push_verts(raw, bytes, alignment);
+  PipelineConfig pipeline{};
+  if (!prepared) populate_pipeline_config(pipeline, prim, fmt);
+  const auto& c = prepared ? *prepared : pipeline.shaderConfig;
+  AURORA_ASSERT(c.vtxStride && bytes % c.vtxStride == 0, "Invalid GX vertex record size");
+  const size_t count = bytes / c.vtxStride;
+  // Hashing all referenced arrays costs more than decoding this game's small
+  // display lists. Keep the cache available for diagnostics, but opt into it.
+  static const bool useCache = [] { const char* s=std::getenv("MELEE_FLIP_VERTEX_CACHE");return s&&std::strcmp(s,"0"); }();
+  auto& cache=flip_vertex_cache();
+  static uint64_t calls=0;
+  if(++calls%60000==0 && std::getenv("MELEE_FLIP_PROFILE"))
+    std::fprintf(stderr,"[flip-vertex-cache] hits=%llu misses=%llu entries=%zu bytes=%zu\n",
+      (unsigned long long)cache.hits,(unsigned long long)cache.misses,cache.entries.size(),cache.bytes);
+  // For very small primitives, decoding is cheaper than a content-key lookup.
+  const bool cacheDraw=useCache&&count>=16;
+  const auto key=cacheDraw ? flip_vertex_key(c,raw,bytes,g_gxState.arrays,g_gxState.currentPnMtx) : FlipVertexCache::Key{};
+  const auto layout = flip_vertex_attributes(c);
+#ifdef MELEE_MIYOO_FLIP
+  static const bool direct=[] {const char* s=std::getenv("MELEE_FLIP_DECODE_DIRECT");return s&&!std::strcmp(s,"1");}();
+  if(direct&&!cacheDraw&&!c.lineMode) {
+    u8* destination=nullptr;
+    const auto range=gfx::map_flip_verts(count*layout.stride,alignment,destination);
+    if(!destination) return {};
+    flip_decode_packed_into(c,layout,raw,count,{destination,range.size},g_gxState.arrays,g_gxState.currentPnMtx);
+    if((record||textureBank)&&flip_vertex_location(c,0)) {
+      for(size_t i=0;i<range.size;i+=layout.stride) {
+        uint32_t word;std::memcpy(&word,destination+i+8,4);
+        word=(word&~0xff00u)|(record<<8)|(textureBank<<12);std::memcpy(destination+i+8,&word,4);
+      }
+    }
+    return range;
+  }
+#endif
+  static std::vector<u8> packed;
+  const auto upload=[&]() {
+    gfx::detail::flip_profile::Scope uploadProfile("vertex_stage_copy",0,packed.size());
+    if((record || textureBank) && flip_vertex_location(c,0)) {
+      for(size_t i=0;i<packed.size();i+=layout.stride) {
+        uint32_t word;std::memcpy(&word,packed.data()+i+8,4);
+        word=(word&~0xff00u)|(record<<8)|(textureBank<<12);std::memcpy(packed.data()+i+8,&word,4);
+      }
+    }
+    return gfx::push_verts(packed.data(),packed.size(),alignment);
+  };
+  if(cacheDraw) {
+    if(auto it=cache.entries.find(key);it!=cache.entries.end()) {
+      ++cache.hits;packed=it->second;return upload();
+    }
+    ++cache.misses;
+  }
+  if(!c.lineMode) {
+    flip_decode_packed(c,layout,raw,count,packed,g_gxState.arrays,g_gxState.currentPnMtx);
+    if(cacheDraw) cache.store(key,packed);
+    return upload();
+  }
+  static std::vector<FlipVertex> decoded, expanded;
+  static const bool bulk = [] { const auto* s=std::getenv("MELEE_FLIP_BULK_DECODE"); return !s || std::strcmp(s,"0"); }();
+  if (!bulk || !flip_decode_bulk(c, raw, count, decoded, g_gxState.arrays, g_gxState.currentPnMtx)) {
+    decoded.resize(count);
+    for (size_t i = 0; i < count; ++i)
+      decoded[i] = flip_decode_vertex(c, raw + i * c.vtxStride, g_gxState.arrays, g_gxState.currentPnMtx);
+  }
+  if (c.lineMode) {
+    const size_t instances = c.lineMode == 3 ? count : c.lineMode == 1 ? count / 2 : count ? count - 1 : 0;
+    AURORA_ASSERT(instances <= 16383, "Too many expanded GX lines/points");
+    expanded.resize(instances * 4);
+    for (size_t i = 0; i < instances; ++i) {
+      const auto& a = decoded[c.lineMode == 1 ? i * 2 : i];
+      const auto& b = decoded[c.lineMode == 3 ? i : c.lineMode == 1 ? i * 2 + 1 : i + 1];
+      for (unsigned corner = 0; corner < 4; ++corner) {
+        auto& v = expanded[i * 4 + corner];
+        v = corner >= 2 ? b : a;
+        v.matrices[2] |= corner << 24;
+        std::memcpy(v.pos, a.pos, sizeof(v.pos));
+        v.matrices[0] = (v.matrices[0] & ~255u) | (a.matrices[0] & 255);
+        std::memcpy(v.lineEnd, b.pos, sizeof(b.pos));
+        v.lineEnd[3] = float(b.matrices[0] & 255);
+      }
+    }
+  }
+  auto& vertices = c.lineMode ? expanded : decoded;
+  packed.resize(vertices.size() * layout.stride);
+  for (size_t i = 0; i < vertices.size(); ++i) {
+    const auto* source = reinterpret_cast<const u8*>(&vertices[i]);
+    for (unsigned a = 0; a < layout.count; ++a) {
+      const auto& attr = layout.attributes[a];
+      std::memcpy(packed.data() + i * layout.stride + attr.offset, source + layout.sources[a],
+                  flip_attribute_bytes(attr.shaderLocation));
+    }
+  }
+  if(cacheDraw) cache.store(key,packed);
+  return upload();
+}
+} // namespace aurora::gx
