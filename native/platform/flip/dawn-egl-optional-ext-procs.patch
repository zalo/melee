 #define GET_PROC(name) GET_PROC_WITH_NAME(name, "egl" #name)
 
+// For the entry points of an extension: evaluates to whether the driver has the proc. Some drivers
+// list an extension without providing its entry points (PowerVR on the TrimUI Smart Pro's stock OS
+// advertises EGL_KHR_image_base, but neither eglGetProcAddress nor libEGL has eglCreateImageKHR).
+// LoadDisplayProcs then treats the extension as absent, so that only what needs the extension is
+// lost instead of the whole backend.
+#define TRY_GET_PROC_WITH_NAME(member, name) \
+    ((member = reinterpret_cast<decltype(member)>(GetProcAddress(name))) != nullptr)
+
 MaybeError EGLFunctions::LoadClientProcs(EGLGetProcProc getProc) {
     // Load EGL 1.0
     GetProcAddress = getProc;
@@ -181,6 +190,20 @@
         }
     }
 
+    // Marks an extension whose entry points the driver lacks as absent.
+    auto DropExtension = [this](EGLExt dropped, const char* reason) {
+        if (!mExtensions[dropped]) {
+            return;
+        }
+        for (const ExtensionInfo& ext : kExtensionInfos) {
+            if (ext.index == dropped) {
+                dawn::WarningLog() << "EGL: ignoring " << ext.name << " (" << reason << ")";
+                break;
+            }
+        }
+        mExtensions.reset(dropped);
+    };
+
     // EGL 1.1
     if (mMinorVersion >= 1) {
