+struct FlipCachedFramebuffer { GLuint fbo; std::vector<GLuint> handles; };
+std::unordered_map<uint64_t, FlipCachedFramebuffer>& FlipFramebufferCache() {
+    static std::unordered_map<uint64_t, FlipCachedFramebuffer> cache;
