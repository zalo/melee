+void SetDirectGLPresentCallbacks(const DirectGLPresentCallbacks* callbacks) {
+    gDirectPresentCallbacks.store(callbacks, std::memory_order_release);
+}
+const DirectGLPresentCallbacks* GetDirectGLPresentCallbacks() {
+    return gDirectPresentCallbacks.load(std::memory_order_acquire);
+}
+
+bool RunDirectGL(WGPUDevice device, DirectGLCallback callback, void* userdata) {
+    Device* backendDevice = ToBackend(FromAPI(device));
+    if (callback == nullptr) {
+        return false;
+    }
+    return !backendDevice->ConsumedError(backendDevice->EnqueueAndFlushGL(
+        [callback, userdata](const OpenGLFunctions&) -> MaybeError {
+            callback(userdata);
+            return {};
+        }));
+}
+
+GLuint GetDirectGLBuffer(WGPUBuffer buffer) {
+    return ToBackend(FromAPI(buffer))->GetHandle();
+}
+
+GLuint GetDirectGLSampler(WGPUSampler sampler) {
+    return ToBackend(FromAPI(sampler))->GetHandle();
+}
+
+DirectGLTextureInfo GetDirectGLTextureView(WGPUTextureView view) {
+    return DirectTextureInfo(ToBackend(FromAPI(view)));
+}
+
+DirectGLTextureInfo GetDirectGLBindGroupTexture(WGPUBindGroup group, uint32_t binding) {
+    auto* bindGroup = ToBackend(FromAPI(group));
+    BindingIndex index;
+    if (!ResolveBindingIndex(bindGroup->GetLayout(), binding, &index)) {
+        return {};
+    }
+    auto* textureView = bindGroup->GetBindingAsTextureView(index);
+    return DirectTextureInfo(ToBackend(textureView));
+}
+
+GLuint GetDirectGLBindGroupSampler(WGPUBindGroup group, uint32_t binding) {
+    auto* bindGroup = ToBackend(FromAPI(group));
+    BindingIndex index;
+    if (!ResolveBindingIndex(bindGroup->GetLayout(), binding, &index)) {
+        return 0;
+    }
+    auto* sampler = bindGroup->GetBindingAsSampler(index);
+    return ToBackend(sampler)->GetHandle();
+}
+
+DirectGLPipelineInfo GetDirectGLRenderPipeline(WGPURenderPipeline pipeline) {
+    auto* renderPipeline = ToBackend(FromAPI(pipeline));
+    return {.program = renderPipeline->GetProgramHandle(),
+            .vertexArray = renderPipeline->GetVertexArrayObject(),
+            .topology = renderPipeline->GetGLPrimitiveTopology()};
+}
+
+uint32_t GetDirectGLTextureUnits(WGPURenderPipeline pipeline,
+                                 uint32_t group,
+                                 uint32_t binding,
+                                 bool sampler,
+                                 uint32_t* units,
+                                 uint32_t capacity) {
+    auto* renderPipeline = ToBackend(FromAPI(pipeline));
+    auto* layout = ToBackend(renderPipeline->GetLayout());
+    const BindGroupIndex groupIndex(group);
+    if (!layout->GetBindGroupLayoutsMask()[groupIndex]) {
+        return 0;
+    }
+    BindingIndex index;
+    if (!ResolveBindingIndex(layout->GetBindGroupLayout(groupIndex), binding, &index)) {
+        return 0;
+    }
+    const auto flat = layout->GetBindingIndexInfo()[groupIndex][index];
+    const auto& source = sampler ? renderPipeline->GetTextureUnitsForSampler(flat)
+                                 : renderPipeline->GetTextureUnitsForTextureView(flat);
+    const uint32_t count = std::min<uint32_t>(capacity, source.size());
+    for (uint32_t i = 0; i < count; ++i) {
+        units[i] = static_cast<uint32_t>(source[i]);
+    }
+    return static_cast<uint32_t>(source.size());
+}
+
+uint32_t GetDirectGLBufferBinding(WGPURenderPipeline pipeline, uint32_t group, uint32_t binding) {
+    auto* renderPipeline = ToBackend(FromAPI(pipeline));
+    auto* layout = ToBackend(renderPipeline->GetLayout());
+    const BindGroupIndex groupIndex(group);
+    if (!layout->GetBindGroupLayoutsMask()[groupIndex]) {
+        return UINT32_MAX;
+    }
+    BindingIndex index;
+    if (!ResolveBindingIndex(layout->GetBindGroupLayout(groupIndex), binding, &index)) {
+        return UINT32_MAX;
+    }
+    return static_cast<uint32_t>(layout->GetBindingIndexInfo()[groupIndex][index]);
+}
+
+void SetDirectGLRenderPassCallback(DirectGLRenderPassCallback callback, void* userdata) {
+    if (callback == nullptr) {
+        gDirectRenderPassCallback.store(nullptr, std::memory_order_release);
+        gDirectRenderPassUserdata.store(nullptr, std::memory_order_release);
+        return;
+    }
+    gDirectRenderPassUserdata.store(userdata, std::memory_order_relaxed);
+    gDirectRenderPassCallback.store(callback, std::memory_order_release);
+}
+
+bool TryDirectGLRenderPass(uint32_t passIndex, const char* label) {
+    auto callback = gDirectRenderPassCallback.load(std::memory_order_acquire);
+    return callback != nullptr &&
+           callback(gDirectRenderPassUserdata.load(std::memory_order_relaxed), passIndex, label);
+}
+
 }  // namespace dawn::native::opengl
