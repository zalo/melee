+// Called from Texture::DestroyImpl on any thread: queue the handle for purging.
+// Two consumers, two lists: the render pass purges its framebuffer cache with GL
+// access; the application drains names for its own caches without touching GL.
+std::mutex& FlipForgetMutex() { static std::mutex m; return m; }
+std::vector<GLuint>& FlipForgetListFbo() { static std::vector<GLuint> list; return list; }
+std::vector<GLuint>& FlipForgetListExternal() { static std::vector<GLuint> list; return list; }
+void FlipForgetFramebuffers(GLuint handle) {
+    if (!handle) return;
+    std::lock_guard<std::mutex> lock(FlipForgetMutex());
+    FlipForgetListFbo().push_back(handle);
+    FlipForgetListExternal().push_back(handle);
+}
+std::vector<GLuint> FlipDrainDestroyedTextures() {
+    std::lock_guard<std::mutex> lock(FlipForgetMutex());
+    std::vector<GLuint> handles;
+    handles.swap(FlipForgetListExternal());
+    return handles;
+}
+// Render thread, context current: drop cached framebuffers referencing dead objects.
+void FlipPurgeFramebuffers(const OpenGLFunctions& gl) {
+    std::vector<GLuint> handles;
+    {
+        std::lock_guard<std::mutex> lock(FlipForgetMutex());
+        handles.swap(FlipForgetListFbo());
+    }
+    if (handles.empty()) return;
+    auto& cache = FlipFramebufferCache();
+    for (auto it = cache.begin(); it != cache.end();) {
