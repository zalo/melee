+// Native escape hatch used by the Miyoo Flip renderer.  It keeps Dawn's
+// resource ownership and upload scheduling while allowing the application to
+// submit a measured GLES draw path in the device's EGL context.
+using DirectGLCallback = void (*)(void* userdata);
+// Optional application-owned shared-context presenter. Submit takes ownership
+// of a GL_TEXTURE_2D name on success, in the current context's share group. It must fence
+// that context before returning and delete the texture after presentation.
+// Shutdown drains all queued work before the EGL surface can be destroyed.
+struct DirectGLPresentCallbacks {
+    bool (*submit)(GLuint texture, uint32_t width, uint32_t height, void* surface);
+    void (*shutdown)();
+};
+DAWN_NATIVE_EXPORT void SetDirectGLPresentCallbacks(const DirectGLPresentCallbacks* callbacks);
+DAWN_NATIVE_EXPORT const DirectGLPresentCallbacks* GetDirectGLPresentCallbacks();
+struct DAWN_NATIVE_EXPORT DirectGLTextureInfo {
+    GLuint texture;
+    GLuint renderbuffer;
+    GLenum target;
+    uint32_t baseMipLevel;
+    uint32_t maxMipLevel;
+    GLenum swizzle[4];
+};
+struct DAWN_NATIVE_EXPORT DirectGLPipelineInfo {
+    GLuint program;
+    GLuint vertexArray;
+    GLenum topology;
+};
+DAWN_NATIVE_EXPORT bool RunDirectGL(WGPUDevice device, DirectGLCallback callback, void* userdata);
+DAWN_NATIVE_EXPORT GLuint GetDirectGLBuffer(WGPUBuffer buffer);
+DAWN_NATIVE_EXPORT GLuint GetDirectGLSampler(WGPUSampler sampler);
+DAWN_NATIVE_EXPORT DirectGLTextureInfo GetDirectGLTextureView(WGPUTextureView view);
+DAWN_NATIVE_EXPORT DirectGLTextureInfo GetDirectGLBindGroupTexture(WGPUBindGroup group,
+                                                                    uint32_t binding);
+DAWN_NATIVE_EXPORT GLuint GetDirectGLBindGroupSampler(WGPUBindGroup group, uint32_t binding);
+DAWN_NATIVE_EXPORT DirectGLPipelineInfo GetDirectGLRenderPipeline(WGPURenderPipeline pipeline);
+DAWN_NATIVE_EXPORT uint32_t GetDirectGLTextureUnits(WGPURenderPipeline pipeline,
+                                                     uint32_t group,
+                                                     uint32_t binding,
+                                                     bool sampler,
+                                                     uint32_t* units,
+                                                     uint32_t capacity);
+DAWN_NATIVE_EXPORT uint32_t GetDirectGLBufferBinding(WGPURenderPipeline pipeline,
+                                                      uint32_t group,
+                                                      uint32_t binding);
+
+// When installed, the callback runs after Dawn has attached and cleared a
+// render pass. Returning true tells the GLES command executor that the callback
+// rendered the pass and that its recorded WebGPU commands should be skipped.
+using DirectGLRenderPassCallback = bool (*)(void* userdata, uint32_t passIndex, const char* label);
+DAWN_NATIVE_EXPORT void SetDirectGLRenderPassCallback(DirectGLRenderPassCallback callback,
+                                                       void* userdata);
+DAWN_NATIVE_EXPORT bool TryDirectGLRenderPass(uint32_t passIndex, const char* label);
+
 }  // namespace dawn::native::opengl
 
