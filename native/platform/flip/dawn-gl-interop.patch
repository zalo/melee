+    GLuint texture;
+    GLuint renderbuffer;
+    GLenum target;
+    uint32_t baseMipLevel;
+    uint32_t maxMipLevel;
+    GLenum swizzle[4];
+};
+struct DAWN_NATIVE_EXPORT GLInteropPipelineInfo {
+    GLuint program;
+    GLuint vertexArray;
+    GLenum topology;
