 namespace {
 
+// Whether CopyBufferToTexture hands glTexSubImage the texels through a read mapping of the source
+// buffer instead of binding it as GL_PIXEL_UNPACK_BUFFER.
+//
+// Arm's libmali turns an upload from a pixel unpack buffer into a deferred job on one of its
+// utility threads. That job first waits for the frames still using the destination texture, and
+// those are only flushed by the thread that owns the context: once that thread itself waits on the
+// driver (a fence, a full present queue, the driver's own frame throttle) the two never resolve
+// and the process freezes without crashing (Miyoo Flip, libmali g29p1; RG351P, r13p0). The
+// deferred job also reads the buffer after the caller was told the copy is complete, so a
+// MapAsync(Write), which maps unsynchronized, could overwrite texels that were not uploaded yet.
+// An upload from client memory is copied before glTexSubImage returns, which avoids both.
+// DAWN_GL_TEXTURE_UPLOAD=map|pbo overrides the per-driver default (map on libmali).
+bool UploadTexturesFromMappedBuffer(const OpenGLFunctions& gl) {
+    static const bool fromMapped = [&gl] {
+        const char* requested = std::getenv("DAWN_GL_TEXTURE_UPLOAD");
+        if (requested != nullptr && std::strcmp(requested, "map") == 0) {
+            return true;
+        }
+        if (requested != nullptr && std::strcmp(requested, "pbo") == 0) {
+            return false;
+        }
+        const char* vendor = reinterpret_cast<const char*>(gl.GetString(GL_VENDOR));
+        return vendor != nullptr && std::strcmp(vendor, "ARM") == 0;
+    }();
+    return fromMapped;
+}
